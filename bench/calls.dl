; calls.dl - function calls and integer arithmetic: fib, tak, and a function of three arguments in a loop
(fun {fib n} {if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))})
(fun {tak x y z} {if (not (< y x)) z (tak (tak (- x 1) y z) (tak (- y 1) z x) (tak (- z 1) x y))})
(fun {add3 a b c} {+ a (+ b c)})
(fun {sum-to n acc} {if (zero? n) acc (sum-to (- n 1) (add3 acc n 1))})
(print (fib 27) (tak 20 14 8) (sum-to 400000 0))
