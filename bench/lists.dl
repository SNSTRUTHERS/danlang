; lists.dl - lists: recursions written with cons, fst and tail; the built-ins over lists; sort, join, take and drop
(fun {my-map f l} {if l (cons (f (fst l)) (my-map f (tail l))) NIL})
(fun {my-filter p l} {if l (if (p (fst l)) (cons (fst l) (my-filter p (tail l))) (my-filter p (tail l))) NIL})
(fun {my-len l acc} {if l (my-len (tail l) (+ acc 1)) acc})
(fun {my-rev l acc} {if l (my-rev (tail l) (cons (fst l) acc)) acc})
(fun {qs l} {if l (do (set {p} (fst l)) (set {r} (tail l))
  (join (qs (filter (fn {x} {< x p}) r)) (list p) (qs (filter (fn {x} {>= x p}) r)))) NIL})
(def {l} (range 2000))
(def {r} 0)
(dotimes {k 10} (set! {r} (+ r (my-len (my-rev (my-filter (fn {x} {< x 1500}) (my-map (fn {x} {+ x 1}) l)) NIL) 0))))
(def {big} (range 20000))
(dotimes {k 20} (set! {r} (+ r (foldl + 0 (map (fn {x} {* x 2}) (filter (fn {x} {> x 10}) big))))))
(dotimes {k 5} (set! {r} (+ r (len (qs (map (fn {i} {bit-and (* i 7919) 1023}) (range 3000)))))))
(dotimes {k 20} (set! {r} (+ r (len (sort (map (fn {i} {bit-and (* i 7919) 4095}) (range 3000)))))))
(dotimes {k 200} (set! {r} (+ r (len (join (take 500 big) (drop 19500 big))))))
(print r)
