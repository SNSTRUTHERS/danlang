<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- the newest .NET runtime there is, 8 or later -->
    <RollForward>LatestMajor</RollForward>
    <!-- dotnet publish -c Release -r win-x64 (or linux-x64 ...): the interpreter compiled ahead of time (ReadyToRun),
         so a program starts sooner (the runtime installed: not one of its own) -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- the interpreter's code optimized as soon as it's called often, not after a tenth of a second with no new code
         to compile: a program runs much of its first second in code compiled the quick way otherwise -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>

</Project>
