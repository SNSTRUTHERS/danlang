; 01-lib-int-bounds: the library's integer functions (mod div divmod % floor ceil round pow even? odd? square cube
; recip) and the built-ins 1+ 1- abs, at a long's edges: -2^63, 2^63-1, a -1 divisor, past 2^63, zero divisors.
; Each value printed with its kind, as a fast path that works in longs must leave both.
(fun {kind x} {?((int? x) :int ?((fixed? x) :fixed ?((rational? x) :rat ?((complex? x) :complex (type-of x)))))})
(fun {sk x} {list (repr x) (kind x)})
(def {big small} 9223372036854775807 -9223372036854775808)
(def {two63 two64} 9223372036854775808 18446744073709551616)

; mod, div, divmod and % over pairs: the long edges, signs, past a long
(def {pairs} [[big -1] [small -1] [small 1] [big 2] [small 2] [big big] [small small] [big small] [small big]
  [7 -2] [-7 2] [-7 -2] [7 2] [0 5] [0 -5] [5 two63] [-5 two63] [two64 3] [(- two64) 3] [two64 -7]
  [small -2] [small 3] [big -3] [(+ big 1) -1] [(- small 1) -1] [1 big] [-1 big] [-1 small] [1 small]])
(each {p pairs} (do
  =(a (fst p))
  =(b (snd p))
  (print a b "| mod" (sk (mod a b)) "div" (sk (div a b)) "divmod" (divmod a b) "%" (% a b))))

; by zero: an error each, the same as the danlang body makes
(print (mod 5 0) (div 5 0) (divmod 5 0) (% big 0) (mod small 0) (div 0 0))

; floor, ceil, round of integers (themselves) and of halves near the edges
(each {x [big small two63 (- two63) 0 -1 1]} (print x (sk (floor x)) (sk (ceil x)) (sk (round x))))
(each {x [(/ big 2) (/ small 2) (/ small 3) (/ big -3) (+ big 1/2) (- small 1/2) (/ two64 -5) -1/2 1/2 -3/2 3/2]}
  (print (repr x) "floor" (sk (floor x)) "ceil" (sk (ceil x)) "round" (sk (round x))))

; pow: results up to, at and past 2^63, negative bases and powers, zero
(each {p [[2 62] [2 63] [2 64] [-2 63] [-2 64] [3 39] [3 40] [10 18] [10 19] [-10 19] [7 23] [2 -63] [-2 -3]
          [0 0] [0 5] [1 1000] [-1 999] [-1 1000] [2 200]]}
  (print "pow" (fst p) (snd p) (sk (pow (fst p) (snd p)))))
(print (pow 0 -1) (pow 2 1/2) (pow 2 0.5))

; even? and odd? of big integers and the edges
(each {x [big small two63 (- two63) (+ big 1) (- small 1) (* big big) (* small small) two64 (+ two64 1) 0 -1]}
  (print x (even? x) (odd? x)))

; square, cube, recip at the edges
(print (sk (square 3037000499)) (sk (square 3037000500)) (sk (square -3037000500)) (sk (square small)))
(print (sk (cube 2097151)) (sk (cube 2097152)) (sk (cube -2097152)) (sk (cube -2097153)) (sk (cube big)))
(print (sk (recip big)) (sk (recip small)) (sk (recip 1)) (sk (recip -1)) (sk (recip two64)) (recip 0))

; the built-ins beside them
(print (sk (1+ big)) (sk (1- small)) (sk (1+ -1)) (sk (1- two63)) (sk (abs small)) (sk (abs big)) (sk (abs (- two63))))
(print (sk (- small)) (sk (* small -1)) (sk (+ big big)) (sk (- small big)) (sk (* big 2)) (sk (/ small -1)))
