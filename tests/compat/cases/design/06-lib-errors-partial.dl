; 06-lib-errors-partial: library functions given an error (the first one, left to right, is the call's value: the
; function isn't run), fewer arguments than formals (partially applied: printed, applied later, eq), more (an error,
; unless the body names extras), arguments of the wrong kind (each one's own error), and called through aliases.
(print (mod (error "e1") (error "e2")) (mod 7 (error "e2")) (even? (error "e3")) (pow (/ 1 0) 2) (pow 2 (error "e4")))
(print (cond (error "c")) (case (error "k") {1 2}) (case 1 (error "k2")) (?? (error "q")) (zip (error "z") {1}))
(print (between? 1 (error "b") 3) (divmod (error "d") 0) (fdiv 1 2 (error "places")) (repeat (error "n") {1}))
(print (mod (do (print "first evaluated") 7) (error "second")) (try (mod (error "x") (print "never")) &err))

; fewer: partial application, printed with the formals left; applied later, mapped, eq to each other
(def {m7} (mod 7))
(print m7 (m7 2) (m7 -2) (map m7 {1 2 3 4}) (m7 0) (m7 :a))
(def {p2} (pow 2))
(print p2 (map p2 (range 6)) (p2 -1))
(print (divmod) ((divmod) 7 2) (((divmod) 7) 2) (eq (divmod) divmod) (eq (mod 7) (mod 8)) (eq (mod 7) (div 7)))
(print (case) ((case 2) {1 :a} {2 :b}) (flip) ((flip -) 1 10) (((flip -) 1) 10) (comp) (((comp abs) -) 5))
(print (split 2) ((split 2) {1 2 3}) (zip {1 2}) ((zip {1 2}) {3 4}) (remove-all 2) ((remove-all 2) {1 2 3 2}))
(print (starts-with? "abc") ((starts-with? "abc") "ab") (repeat 2) ((repeat 2) {:r}))

; more: an error, unless the body names extras (between? and the rest take theirs as &1 &2 &3)
(print (mod 1 2 3) (even? 1 2) ((mod 7) 2 3) (square 1 2) (pow 1 2 3) (case))
(print (between? 1 5 3) (between? 1 5 3 99) (between? 5 1 3) (between? 1 5) (between?) (><? 1 5 6 7 8))
(print (fdiv 1 3 2 9) (frecip 3 2) (frecip 3) (fdiv 1 3 :a) (minimum {3 1 2} 7) (maximum {3 1 2}) (minimum {}))
(print (?? NIL) (??) (?? NIL NIL) (?? NIL 2 3) (?? 0 NIL) (ghost) (ghost +) (ghost + 1 2) (cond) (pack list))

; the wrong kinds: each function's own error, or the error of what it calls
(print (mod "a" 2) (div 1 "b") (divmod :a 1) (fdiv 1 :a) (even? "x") (odd? {1}) (positive? :a) (negative? "s"))
(print (pow "a" 2) (pow 2 "b") (floor "x") (ceil :c) (round :r) (square "s") (cube {}) (recip :r) (trunc "t"))
(print (avg {}) (avg {:a}) (avg 5) (starts-with? 5 "a") (ends-with? "abc" 5) (contains? "abc" :b) (xor 1 2))
(print (repeat -1 {1}) (zip 5 {1}) (flatten 5) (distinct 5) (remove-all 1 5) (remove-fst 1 5) (split -1 {1 2}))
(print (nth 5 {1}) (first {}) (tenth (range 9)) (tenth (range 10)) (sort-desc 5) (best-of :a {1 2}) (unpack + 5))
(print (>0 :a) (<0 "s") (>=0 {1}) (=0 :a) (!=0 :a) (!=1 1) (=1 1.0) (xor NIL 5) (xor NIL NIL) (not-between? 1 2 3))

; the aliases: their values, the same as the names they're for; and called
(print % trunc inverse skip first second tenth begin block times top bottom ><? !><? *><? *!><? !*><?)
(print +? -? 0? =0 =1 <> != apply curry uncurry has-element? 1? !=0)
(print (eq % mod) (eq trunc truncate) (eq inverse recip) (eq skip drop) (eq first (nth 0)) (eq times repeat)
  (eq 0? zero?) (eq +? positive?) (eq apply unpack) (eq uncurry pack) (eq top best-of) (eq ><? between?))
(print (% -7 2) (trunc -7/2) (inverse 4) (skip 2 {1 2 3}) (first {:a}) (second {:a :b}) (tenth (range 20))
  (begin 1 2) (block) (times 2 {:t}) (top 2 {3 1 2}) (bottom 2 {3 1 2}) (><? 1 3 2) (!><? 1 3 2))
(print (*><? 1 5 {2 3}) (*!><? 1 5 {6 7}) (!*><? 1 5 {2 9}) (+? 1) (-? -1) (0? 0) (=1 1) (<> 1 2) (!= 1 1)
  (apply + {1 2 3}) (curry * {2 3}) (uncurry len 1 2 3) (has-element? {1 2} 2) (1? 1))
