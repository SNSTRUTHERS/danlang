; 19-calls-order: arguments are evaluated left to right and the first error stops them (what's after it isn't
; evaluated), for every kind of call: built-ins with fast ways (+ - < eq nth fst len), any built-in, library functions
; (mod even? cond), functions, partial applications, methods, hash-call, a list's code run by eval; a built-in that takes
; errors (print, type-of, error?) evaluates them all; an fexpr evaluates none; special forms their own way.
(fun {say x} {do (write x " ") x})
(print "| +" (repr (+ (say 1) (say 2))))
(print "| + err" (repr (+ (say 1) (error "e") (say 2))))
(print "| - err" (repr (- (say 1) (say (error "e")) (say 3))))
(print "| < err" (repr (< (say 1) (error "lt"))))
(print "| eq err" (repr (eq (error "first") (say :second))))
(print "| nth" (repr (nth (say 1) (say {:a :b}))))
(print "| nth err" (repr (nth (say 5) (say {:a :b}))))
(print "| fst err" (repr (fst (error "f"))))
(print "| len" (repr (len (say "abc"))))
(print "| + 4" (repr (+ (say 1) (say 2) (say 3) (say 4))))
(print "| + 4 err" (repr (+ (say 1) (say 2) (error "third") (say 4))))
(print "| list" (repr (list (say 1) (say 2) (error "e") (say 3))))
(print "| substring" (repr (substring (say "hello") (say 1) (error "count"))))
(print "| hash-put" (repr (hash-put (say #()) (say {:k (say :v)}) (error "e") (say {:j 1}))))
(print "| mod" (repr (mod (say 7) (error "e") )))
(print "| mod order" (repr (mod (say 7) (say 2))))
(print "| even?" (repr (even? (error "e"))))
(print "| cond" (repr (cond (say {NIL 1}) (error "clause") (say {T 2}))))
(print "| cond lazy" (repr (cond {(say NIL) (say 1)} {(say T) (say 2)} {(say T) (say 3)})))
(fun {three a b c} {list a b c})
(print "| fn" (repr (three (say 1) (say 2) (say 3))))
(print "| fn err" (repr (three (say 1) (error "e") (say 3))))
(print "| partial" (repr ((three (say 1)) (say 2) (error "e"))))
(print "| partial2" (repr ((three (say 1) (error "early")) (say 2))))
(print "| too many" (repr (three (say 1) (say 2) (say 3) (say 4))))
(print "| too many err" (repr (three (say 1) (say 2) (say 3) (error "fourth"))))
(print "| fewer err" (repr (three (say 1) (error "e"))))
(def {obj} #({{:m (fn {a b} {list a b})} {:v 5}}))
(print "| method" (repr (obj :m (say 1) (say 2))))
(print "| method err" (repr (obj :m (say 1) (error "e") (say 3))))
(print "| method key err" (repr (obj (error "key") (say 1))))
(print "| hash-call" (repr (hash-call obj :m (say 1) (error "e"))))
(print "| value args" (repr (obj :v (say 1))))
(print "| eval" (repr (eval (list three (say 1) (say 2) (say 3)))))
(print "| eval err" (repr (eval (list three (say 1) (error "e") (say 3)))))
(print "| read code" (repr (eval (read "three (say 1) (error \"e\") (say 3)"))))

; built-ins that take errors: every argument evaluated
(print "| print" (repr (print (error "a") (say 1) (error "b"))))
(print "| type-of" (repr (type-of (error "a"))))
(print "| error?" (repr (list (error? (error "a")) (say :after))))
(print "| repr" (repr (repr (error "r"))))

; an fexpr: none evaluated, unless it evaluates them, in its order
(def {rev-eval} (fexpr {a b} {list (eval b) (eval a)}))
(print "| fexpr" (repr (rev-eval (say 1) (say 2))))
(print "| fexpr err" (repr (rev-eval (say 1) (error "b first"))))
(def {quoter} (fexpr {a b} {list a b}))
(print "| fexpr quote" (repr (quoter (say 1) (error "never"))))

; special forms: and, or, if, do, let, while, try: their own ways
(print "| and" (repr (and (say 1) (say NIL) (say 3))))
(print "| and err" (repr (and (say 1) (error "e") (say 3))))
(print "| or" (repr (or (say NIL) (say 2) (say 3))))
(print "| if" (repr (if (say T) (say :then) (say :else))))
(print "| if err" (repr (if (error "test") (say :then) (say :else))))
(print "| do" (repr (do (say 1) (error "e") (say 3))))
(print "| let" (repr (let {{a (say 1)} {b (error "e")} {c (say 3)}} (say a))))
(print "| try" (repr (try (do (say 1) (error "e") (say 2)) (say &err))))
(print "| args to a value" (repr ((say 5))))
(print "| args to a value err" (repr ((say 5) (say 6))))
