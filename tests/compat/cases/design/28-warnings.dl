; flags: -w
; 28-warnings: with -w, def or fun replacing a built-in, or a global of another kind (a function with a value, or a
; value with a function), says so on stderr, with the place.  The library's functions are danlang functions, so
; redefining them as functions says nothing; those that are built-in values (trunc, first, begin ...) say so.
(def {orig-mod orig-floor orig-trunc orig-first orig-begin orig-math.pi} mod floor trunc first begin math.pi)
(fun {mod a b} {:my-mod})
(def {floor} (fn {a} {:my-floor}))
(def {mod floor} orig-mod orig-floor)
(print "library functions" (mod 7 2) (floor 7/2))
(def {trunc} (fn {x} {0}))
(def {trunc} orig-trunc)
(fun {first l} {:my-first})
(def {first} orig-first)
(def {begin} (fn {} {:my-begin}))
(def {begin} do)
(def {begin} orig-begin)
(print "built-in values" (trunc 7/2) (first {1 2}) (begin 1 2))
(def {mod} 5)
(def {mod} orig-mod)
(def {math.pi} (fn {} {3}))
(def {math.pi} orig-math.pi)
(def {math.pi} 3)
(def {math.pi} orig-math.pi)
(print "kinds" (mod 7 2) (> math.pi 3.14))
(fun {fst l} {:my-fst})
(def {fst} (fn {l} {nth 0 l}))
(def {not} not)
(def {first} (nth 1))
(def {first} (nth 0))
(def {cons} (fn {a b} {:my-cons}))
(print "built-ins" (fst {1 2}) (not 1) (first {1 2}) (cons 1 {2}))
(set {mod} 5)
(set! {floor} 6)
(def {mod floor} orig-mod orig-floor)
(fun {redefine-inside} {do (def {even?} (fn {n} {:my-even})) (fun {odd? n} {:my-odd}) (def {zip} 7) (set {abs} 1) (def {len} 2)})
(redefine-inside)
(print "inside a function" (even? 2) (odd? 3) zip (abs -1) len)
(def {brand-new} 1)
(fun {brand-new-fn} {1})
(def {brand-new} (fn {} {2}))
(fun {brand-new-fn} {3})
(def {brand-new-fn} 4)
(print "new names" brand-new brand-new-fn)
(def {x y z} 1 + (fn {} {}))
(def {x y z} + 1 2)
(print "several" x y z)
