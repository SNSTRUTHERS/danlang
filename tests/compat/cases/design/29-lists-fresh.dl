; 29-lists-fresh: every list a built-in or a call makes is a new one: list, [..], &_, map, filter, read, range,
; str-chars, hash-keys, from#, cons, join, reverse, sort ... made again and again (in a loop, a map, a recursion) and
; all kept, then printed; none is another's storage used again.  And views (tail, drop, cons results) given to every
; built-in that takes a list: the same results as the same items in a list of their own.
(fun {rest-of} {&_})
(def {r1} (rest-of 1 2))
(def {r2} (rest-of 3 4))
(def {r3} (rest-of))
(def {l1 l2} (list 1 2) (list 3 4))
(def {b1 b2} [5 6] [7 8])
(print "kept" r1 r2 r3 l1 l2 b1 b2)
(def {made} (map (fn {x} {list x x}) (range 5)))
(def {made2} (map (fn {x} {rest-of x (* x 10)}) (range 5)))
(def {made3} (map (fn {x} {[x (- x)]}) (range 5)))
(print "in a map" made made2 made3)
(def {acc} {})
(dotimes {i 4} (set! {acc} (cons (list i (rest-of i i) [i]) acc)))
(each {s {"ab" "cd"}} (set! {acc} (cons (list (str-chars s) (read s) (range (len s))) acc)))
(print "in loops" acc)
(fun {nest n} ?{(zero? n) (list :bottom) (list n (rest-of n) (nest (- n 1)))})
(print "in a recursion" (nest 4))
(def {h} #({{:a 1} {:b 2}}))
(def {k1 k2 v1 f1} (hash-keys h) (hash-keys h) (hash-values h) (from# h))
(hash-put h {:c 3})
(print "from a hash" k1 k2 v1 f1 (hash-keys h) (from# h))
(def {made4} (map (fn {x} {cons x (rest-of x)}) {1 2 3}))
(def {made5} (map (fn {x} {join (list x) (rest-of x x)}) {1 2 3}))
(def {made6} (map (fn {x} {reverse (list x (+ x 1))}) {1 2 3}))
(def {made7} (map (fn {x} {sort (list (+ x 1) x)}) {1 2 3}))
(print "made" made4 made5 made6 made7)
(fun {counter-list n} {do =(out {}) (dotimes {i n} (set! {out} (cons (rest-of i (len out)) out))) out})
(print "counter" (counter-list 3) (counter-list 2) (map len (counter-list 4)))

; views to every built-in that takes a list, beside a list of the same items made by itself
(def {a} (range 8))
(def {views} [(tail a) (drop 3 a) (cons :x (tail a)) (init (tail a)) (take 4 (drop 2 a)) (tail (cons 0 (tail a)))])
(def {copies} (map (fn {v} {map (fn {x} {x}) v}) views))
(fun {probe l} {list (len l) (fst l) (last l) (nth 1 l) (item-at l 1) (subset l 1 2) (index-of l 4) (last-index-of l 4)
  (elem? 5 l) (in? 99 l) (head l) (end l) (reverse l) (sort l (fn {p q} {> (cmp p q) 0})) (str-join l ",") (repr l)
  (join l {:j}) (cons :c l) (take 2 l) (drop 2 l) (split 1 l) (filter num? l) (map (fn {x} {list x}) (take 2 l))
  (foldl (fn {acc x} {cons x acc}) {} l) (count num? l) (any? atom? l) (eq l (map (fn {x} {x}) l)) (cmp l {})})
(each {i (range (len views))} (do
  =(v (nth i views))
  =(c (nth i copies))
  (print "view" v (eq (probe v) (probe c)) (probe v))))
(print "unpack" (unpack list (tail a)) (unpack + (drop 5 a)) (apply max (tail a)) (eval (cons + (drop 6 a))))
(print "to# buffer" (to# (tail {{:a 1} {:b 2} {:c 3}})) (buffer (drop 5 a)) (from-bytes (tail {104 105 106})) (str-join (tail {"a" "b"})))
(save (tail {1 {2 3} "s"}))
(print "originals" a views copies)
