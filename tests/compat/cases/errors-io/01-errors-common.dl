; 01-errors-common.dl - the messages of the common errors, each printed as a value (the program goes on), shown
; with the expression that made it (show: an fexpr, so the expression comes as it's written); then one error that
; ends the program at the top level: its message on stderr (the file's name before it), and where it was made
(def {show} (fexpr {x} {print (repr x) "=>" (repr (eval x))}))

; names and calls
(show undefined-name)
(show (undefined-fn 1 2))
(show (1 2))
(show ("str" 1))
(show (:atom 1))
(show ({1 2} 3))
(show (T 1))
(show (\c 1))
(show (1))
(show ())

; arithmetic
(show (+ 1 "a"))
(show (+ 1 :a))
(show (- 1 "a"))
(show (- "a"))
(show (* 2 :x))
(show (* {1} 2))
(show (/ 1 0))
(show (/ 0))
(show (/ 1.5 0))
(show (/ 1/2 0))
(show (/ 7 2 0))
(show (+ 1 {2}))
(show (- 1 \a))
(show (truncate "x"))
(show (to-fixed 1 -1))
(show (complex 1 (complex 1 1)))
(show (val "12x"))
(show (val ""))
(show (fib -1))

; lists
(show (head {}))
(show (tail {}))
(show (init {}))
(show (end {}))
(show (fst {}))
(show (nth 5 {1 2}))
(show (nth -1 {1}))
(show (item-at {1 2} 2))
(show (subset {1 2} 3))
(show (subset {1 2} 0 -1))
(show (join {1} 2))
(show (join))
(show (len 5))
(show (reverse 5))
(show (cons 1 2))
(show (range 1 2 0))
(show (range :a))
(show (sort {3 1 2} 5))
(show (take -1 {1 2}))

; strings and characters
(show (substring "abc" 5))
(show (substring "abc" 1 -1))
(show (char-at "abc" 3))
(show (str-split 5))
(show (format "{} {}" 1))
(show (format "{}" 1 2))
(show (format "{" 1))
(show (code-char 256))
(show (char-code "ab"))
(show (str-repeat "a" -1))
(show (str-replace "abc" "" "x"))
(show (str-upper 5))
(show (to-str 1 "#q?"))
(show (to-str (complex 1 1) "x"))
(show (to-sym 5))
(show (to-atom {1}))

; hashes and buffers
(show (hash-get 5 :a))
(show (hash-put #() 5))
(show (#({{:a 1}}) :a 2))
(show (#({{:a 1}}) :b 2))
(show (hash-create {{}}))
(show (hash-create 5))
(show (buffer -1))
(show (buffer-get (buffer 2) 5))
(show ((buffer 2) 0 1))
(show ((buffer 2) 9))
(show (buffer-put (buffer 2) 0 256))
(show (buffer-put (buffer 2) 0 "x"))

; definitions and control
(show (def 1 2))
(show (set "x" 2))
(show (def {a b} 1))
(show (set! {nosuch} 1))
(show (fn 1 2))
(show (fn {x} 2))
(show (fun 5 {}))
(show (if))
(show (if T))
(show (<=> :a {:x}))
(show (<=> 1))
(show (while))
(show (each 5 {1}))
(show (each print 5))
(show (dotimes {i :a} 1))
(show (dotimes {i 2.5} 1))
(show (error))
(show (error "x" "not an atom"))
(show (eval))
(show (exit "x"))
(show (try))
(show (and (error "in and")))
(show (or NIL (error "in or")))

(print "the last: an error at the top level, in a call's argument; the call's code, long, is cut at 60")
(print (+ 1 (* 2 (len {3}))))
(+ 1 (* 2 (str-repeat "a string long enough that this call is past sixty characters" :two)))
(print "not reached")
