(print "inner.dl: start")
(fun {countdown n} {
  do
    (while (> n 0)
      (write n " ")
      (if (eq n 3) (do (print "exit from inner.dl") (exit 5)))
      =(n (- n 1)))
    (print "countdown done")})
(print "inner.dl: counting")
(countdown 6)
(print "inner.dl: not reached")

(print "middle.dl: start")
(fun {load-inner} {do (print "middle.dl: loading inner") (load "inner") (print "middle.dl: not reached")})
(load-inner)
(print "middle.dl: not reached either")

main: a write with no newline; 
