; 29-call-sites: one call site, written once in a function, called again and again while the global its head names
; changes: a built-in (of 1, 2, 3 and any arguments), a function, a partial, an fexpr, a hash, a buffer, a number, a
; special form (if, and, do, set), back to a built-in; then the name bound locally somewhere (a formal, a set), the
; site still finding the global.  And one + site given small integers, longs at their edge, big ones, rationals,
; fixed decimals and strings, in turn: the value each time is the built-in's.

(fun {call-op a b} {op a b})
(fun {call-op1 a} {op a})
(fun {show-call} {print (try (call-op 7 2) &err) (try (call-op1 :x) &err)})
(def {op} +)
(show-call)
(def {op} list)
(show-call)
(def {op} cons)
(show-call)
(def {op} (fn {a b} {list :fn a b}))
(show-call)
(def {op} (fn {a} {list :fn-of-one a}))
(show-call)
(def {op} (fn {a b c} {list :partial a b c}))
(show-call)
(def {op} (fexpr {a b} {list :fexpr a b}))
(show-call)
(def {op} (hash-create {{7 :seven} {:x :ex} {:m (fn {} {:method})}}))
(show-call)
(def {op} (buffer {10 20 30 40 50 60 70 80}))
(show-call)
(def {op} 42)
(show-call)
(def {op} if)
(show-call)
(def {op} and)
(show-call)
(def {op} do)
(show-call)
(def {op} set)
(print (try (call-op 7 2) &err))
(def {op} eq)
(show-call)
(def {op} (eq 7))
(show-call)
(def {op} +)
(show-call)

; the same site, many calls between changes (any remembered way of calling must notice the change)
(def {op} +)
(fun {sum-calls n} {do =(k 0) =(acc 0) (while (< k n) (set! {acc} (op acc 1)) (set! {k} (+ k 1))) acc})
(print (sum-calls 1000))
(def {op} -)
(print (sum-calls 1000))
(def {op} (fn {a b} {+ a (* b 2)}))
(print (sum-calls 1000))
(def {op} max)
(print (sum-calls 1000))

; the name bound locally elsewhere: a formal, then a set; the site still finds the global
(def {op} *)
(print (call-op 6 7))
(fun {has-op-formal op} {op 2 3})
(print (has-op-formal +) (call-op 6 7))
(fun {sets-op} {do =(op -) (op 10 1)})
(print (sets-op) (call-op 6 7))

; one + site: small integers, longs at the edge, big integers, rationals, fixed, strings
(fun {add a b} {+ a b})
(print (add 1 2) (add -5 3) (add 9223372036854775807 1) (add -9223372036854775808 -1))
(print (add 4611686018427387904 4611686018427387904) (add 99999999999999999999 1) (add 1 2))
(print (add 1/2 1/3) (add 0.5 0.25) (add 1 0.5) (add "a" 1) (add \c "d") (add 1 2))
(print (try (add 1 "a") &err) (try (add :a 1) &err) (add 3 4))
(fun {lt a b} {< a b})
(print (lt 1 2) (lt 2 1) (lt 9223372036854775807 9223372036854775808) (lt "a" "b") (lt 1 "a") (lt :a 1))
(fun {sub a b} {- a b})
(print (sub 5 3) (sub -9223372036854775808 1) (sub 1/2 1) (sub 1 2))

; the last: the site's global made a string, then called, ends the program
(def {op} "not callable")
(call-op 1 2)
