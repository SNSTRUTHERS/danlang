; 02-stale-site-lists: as 01, for cond, case, ??, the list and string functions and the rest of the library: the Site each leaves (the unbound after, evaluated right after the call returns, says it), after 4 calls at one place
(fun {w1 f x n} {do (if (zero? n) NIL (set {after} n)) (f x) after (w1 f x (- n 1))})
(fun {w2 f x y n} {do (if (zero? n) NIL (set {after} n)) (f x y) after (w2 f x y (- n 1))})
(fun {w3 f x y z n} {do (if (zero? n) NIL (set {after} n)) (f x y z) after (w3 f x y z (- n 1))})
(fun {wc n} {do (if (zero? n) NIL (set {after} n)) (cond {(> n 2) :big} {(> n 0) (list :small)} {T zz}) after (wc (- n 1))})
(def {zz} :zz)
(wc 4)
(fun {wc2 n} {do (if (zero? n) NIL (set {after} n)) (cond {T 5}) after (wc2 (- n 1))})
(wc2 4)
(fun {wc3 n} {do (if (zero? n) NIL (set {after} n)) (cond {NIL 1} {(eq n n) n}) after (wc3 (- n 1))})
(wc3 4)
(fun {wc4 n} {do (if (zero? n) NIL (set {after} n)) (cond {T {quoted}}) after (wc4 (- n 1))})
(wc4 4)
(fun {wc5 n} {do (if (zero? n) NIL (set {after} n)) (cond {T (cond {T (+ n 1)})}) after (wc5 (- n 1))})
(wc5 4)
(fun {wc6 n} {do (if (zero? n) NIL (set {after} n)) (cond [T n]) after (wc6 (- n 1))})
(wc6 4)
(def {table} {{(> x 1) :x-big} {T :x-small}})
(def {x} 5)
(fun {wc7 n} {do (if (zero? n) NIL (set {after} n)) (unpack cond table) after (wc7 (- n 1))})
(wc7 4)
(fun {wk n} {do (if (zero? n) NIL (set {after} n)) (case n {4 :four} {3 (list :three)} {0 zz} {1 1} {2 :two}) after (wk (- n 1))})
(wk 4)
(fun {wk2 n} {do (if (zero? n) NIL (set {after} n)) (case :b {:a 1} {:b (+ 1 1)}) after (wk2 (- n 1))})
(wk2 4)
(fun {wk3 n} {do (if (zero? n) NIL (set {after} n)) (case (+ 1 1) {(+ 1 0) :one} {(+ 1 1) :two}) after (wk3 (- n 1))})
(wk3 4)
(w2 ?? NIL 2 4)
(w2 ?? 1 2 4)
(w1 ?? 1 4)
(w1 ?? NIL 4)
(w3 ?? NIL NIL 3 4)
(w3 ?? NIL NIL NIL 4)
(w2 zip {1 2} {3 4} 4)
(w2 zip {1 2 3} {4} 4)
(w2 zip NIL {1} 4)
(w2 zip {1} NIL 4)
(w1 flatten {1 {2 3} 4} 4)
(w1 flatten {{1} {2}} 4)
(w1 flatten {1 2} 4)
(w1 flatten {} 4)
(w1 distinct {1 2 1 3} 4)
(w1 distinct {1} 4)
(w1 distinct {} 4)
(w2 remove-all 1 {1 2 1} 4)
(w2 remove-all 9 {1 2} 4)
(w2 remove-all 1 {2 1} 4)
(w2 remove-all 1 {} 4)
(w2 remove-fst 1 {1 2 1} 4)
(w2 remove-fst 2 {1 2 1} 4)
(w2 remove-fst 9 {1 2} 4)
(w2 remove-fst 1 {} 4)
(w2 has-element? {1 2} 2 4)
(w2 has-element? {} 2 4)
(w2 starts-with? "abc" "a" 4)
(w2 starts-with? "abc" "z" 4)
(w2 ends-with? "abc" "c" 4)
(w2 ends-with? "abc" "z" 4)
(w2 ends-with? "a" "abc" 4)
(w2 contains? "abc" "b" 4)
(w2 contains? {1 2} 2 4)
(w2 repeat 2 {:r} 4)
(w2 repeat 0 {:r} 4)
(w2 unpack + {1 2} 4)
(w2 unpack list NIL 4)
(w3 flip - 1 2 4)
(w3 comp 1+ 1+ 1 4)
(w3 ghost + 1 2 4)
(w2 split 1 {1 2} 4)
(w1 sort-desc {1 3 2} 4)
(w2 best-of 2 {1 3 2} 4)
(w2 worst-of 2 {1 3 2} 4)
(w1 minimum {3 1 2} 4)
(w1 maximum {3 1 2} 4)
(w1 remove-min {3 1 2} 4)
(w1 remove-max {3 1 2} 4)
(w2 fdiv 1 3 4)
(w1 frecip 3 4)
(w3 all-between? 1 3 {2 2} 4)
(w3 all-between? 1 3 {} 4)
(w3 not-between? 1 3 2 4)
(w3 all-not-between? 1 3 {5} 4)
(w3 not-all-between? 1 3 {2} 4)
