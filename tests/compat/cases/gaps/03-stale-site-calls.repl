; 03-stale-site-calls: the Site a library function leaves, seen by errors that don't start a call of their own: too many arguments (found after the arguments), a value that isn't a function called, an unbound name in a let, if, and or set; through map, sort, each, dotimes, a method, a fexpr, flip, comp, a partial application, a function that returns and one that tail-calls the library; each the 5th time round at one place
(fun {one x} {x})
(fun {two x y} {list x y})
(fun {wa n} {do (set {g} (if (zero? n) one two)) (g 1 (mod 9 4)) (wa (- n 1))})
(wa 4)
(fun {wa2 n} {do (set {g} (if (zero? n) one two)) (g 1 (floor -5/2)) (wa2 (- n 1))})
(wa2 4)
(fun {wa3 n} {do (set {g} (if (zero? n) one two)) (g 1 (cond {T (+ n 1)})) (wa3 (- n 1))})
(wa3 4)
(fun {wa4 n} {do (set {g} (if (zero? n) one two)) (g 1 (zip {1} {2})) (wa4 (- n 1))})
(wa4 4)
(fun {wb n} {do ((cond {(zero? n) 5} {T two}) 1 2) (wb (- n 1))})
(wb 4)
(fun {wb2 n} {do ((?? NIL (if (zero? n) :atom list)) 1) (wb2 (- n 1))})
(wb2 4)
(fun {wb3 n} {do ((case n {0 "str"} {1 one} {2 one} {3 one} {4 one}) 1) (wb3 (- n 1))})
(wb3 4)
(fun {wb4 n} {do ((if (zero? n) (mod 7 2) list) 1) (wb4 (- n 1))})
(wb4 4)
(fun {wc n} {do (if (zero? n) NIL (set {after} n)) (let {{a (mod n 3)} {b after}} (list a b)) (wc (- n 1))})
(wc 4)
(fun {wd n} {do (if (zero? n) NIL (set {after} n)) (if (even? n) after after) (wd (- n 1))})
(wd 4)
(fun {we n} {do (if (zero? n) NIL (set {after} n)) (and (odd? 3) after) (we (- n 1))})
(we 4)
(fun {wf n} {do (if (zero? n) NIL (set {after} n)) (or NIL (odd? 2) after) (wf (- n 1))})
(wf 4)
(fun {wf2 n} {do (if (zero? n) NIL (set {after} n)) (or (between? 5 9 n) after) (wf2 (- n 1))})
(wf2 4)
(fun {wg n} {do (if (zero? n) NIL (set {after} n)) (set {v} (divmod n 3)) after (wg (- n 1))})
(wg 4)
(fun {wh n} {do (if (zero? n) NIL (set {after} n)) (map (fn {x} {mod x 3}) {4 5}) after (wh (- n 1))})
(wh 4)
(fun {wh2 n} {do (if (zero? n) NIL (set {after} n)) (map even? {4 5}) after (wh2 (- n 1))})
(wh2 4)
(fun {wh3 n} {do (if (zero? n) NIL (set {after} n)) (sort {3 1 2} (fn {a b} {< (mod a 5) (mod b 5)})) after (wh3 (- n 1))})
(wh3 4)
(fun {wh4 n} {do (if (zero? n) NIL (set {after} n)) (foldl (fn {acc x} {+ acc (square x)}) 0 {1 2}) after (wh4 (- n 1))})
(wh4 4)
(fun {wh5 n} {do (if (zero? n) NIL (set {after} n)) (filter odd? {1 2 3}) after (wh5 (- n 1))})
(wh5 4)
(def {obj} #({{:m (fn {} {mod 7 3})} {:k (fn {x} {floor x})}}))
(fun {wi n} {do (if (zero? n) NIL (set {after} n)) (obj :m) after (wi (- n 1))})
(wi 4)
(fun {wi2 n} {do (if (zero? n) NIL (set {after} n)) (hash-call obj :k -7/2) after (wi2 (- n 1))})
(wi2 4)
(def {ev} (fexpr {x} {do (eval x) after}))
(fun {wj n} {do (if (zero? n) NIL (set {after} n)) (ev (round 5/2)) (wj (- n 1))})
(wj 4)
(fun {ret x} {do (mod x 3) :done})
