; 04-stale-site-end: a program ended by an error that starts no call of its own (an unbound name) right after library
; functions returned, deep in user functions, once their native ways are warm (each called thousands of times at
; the same places first): the trace's 'at' is the last call the library's code made (lib/globals.dl), the 'called
; at' lines the user calls that aren't tail calls.
(fun {step x} {do (round x) (floor (- x)) (ceil x) (mod x 7)})
(fun {warm n acc} {if (zero? n) acc (warm (- n 1) (+ acc (step n)))})
(print "warm" (warm 3000 0))
(print "step" (map step {1 2 3 -4 5/2 -7/3 2.5 -0.5 9223372036854775807}))
(fun {kinds x} {list (even? x) (odd? x) (square x) (cube x) (>=0 x) (<0 x) (!=0 x) (positive? x) (negative? x)})
(print "kinds" (map kinds {0 1 -2 3/2 2.0}))
(def {tally} 0)
(dotimes {i 2000} (do
  (if (even? i) (set! {tally} (+ tally (div i 3))) (set! {tally} (- tally (mod i 5))))
  (between? 10 1 (pow 2 (mod i 4)))
  (xor (odd? i) (zero? (mod i 3)))))
(print "tally" tally)
(fun {lists n} {list (zip (range n) (range n 0 -1)) (flatten [(range n) {{a {b}}}]) (distinct (map (mod n) {3 5 3 7}))
  (remove-all 1 {1 2 1 3}) (remove-fst 2 {2 1 2}) (has-element? (range n) 2) (?? NIL NIL n) (avg (range 1 (+ n 1)))})
(print "lists" (lists 4) (lists 1))
(dotimes {i 300} (lists (+ 1 (mod i 4))))
(print "strings" (map (fn {s} {list (starts-with? s "ab") (ends-with? s "cd") (contains? s "bc")}) {"abcd" "xbcd" "ab" ""}))
(fun {choose x} {cond {(> x 100) :huge} {(> x 10) (case (mod x 3) {0 :tens-0} {1 :tens-1} {2 (list :tens-2)})} {T :small}})
(print "choose" (map choose {1 11 12 13 101}))
(dotimes {i 500} (choose i))

; then: library calls, and right after the last, a name that's bound nowhere
(fun {inner x} {do
  (cond {(> x 5) (pow x 2)} {T (zip {1} {2})})
  (between? 1 x 3)
  (step x)
  missing-name})
(fun {middle x} {list :never (inner x) :reached})
(fun {outer x} {+ 1 (middle x)})
(print "before" (try (outer 9) &err))
(print "and once more, uncaught")
(outer 9)
