; 05-error-items: a list can hold error values as items (hash-put of several entries gives the old value of each, or
; the error an entry's value was): such a list is an ordinary argument, but an item taken out and given to a function
; is that error.  So each library function (zip, flatten, distinct, remove-*, minimum, cond, case, ?? ...) stops
; where its code first passes an error item on, and a native way of it must too; the built-ins as they are.
(def {h} (hash-create))
(def {el} (hash-put h {:a 1} {:b (error "bee")} {:c 3} {:d (error "dee")}))
(print "el" el (len el) (map type-of el) h)
(def {nums} (hash-put h {:a 10} {:b (error "b2")} {:c 30}))
(print "nums" nums (map type-of nums) h)
(def {only} (hash-put h {:x (error "only")} {:y (error "y")}))
(print "only" only (type-of only) (len only) (map error-message only))

; the library: each stops at the first error item its code hands to a function
(print "zip" (zip el {1 2 3 4}) (zip {1} el) (zip NIL el) (zip nums {7}) (zip (tail nums) {7}))
(print "flatten" (flatten el) (flatten (list 1 nums)) (flatten (take 1 nums)))
(print "distinct" (distinct el) (distinct nums) (distinct (take 1 nums)))
(print "remove-all" (remove-all NIL el) (remove-all 1 nums) (remove-all 9 (take 1 nums)))
(print "remove-fst" (remove-fst NIL el) (remove-fst 1 nums) (remove-fst 10 nums) (remove-fst 9 nums))
(print "remove-min/max" (remove-min nums) (remove-max nums) (remove-min el))
(print "minimum" (minimum el) (maximum nums) (minimum only))
(print "has-element?" (has-element? el 3) (has-element? nums 3) (has-element? el (error "x")))
(print "avg" (avg el) (avg nums) (avg (take 1 nums)))
(print "??" (?? NIL (snd el)) (?? (fst nums) (snd nums)) (?? (snd nums) 1) (unpack ?? el) (unpack ?? (tail el)))
(print "cond" (cond {(snd el) 1} {T 2}) (cond {T (snd el)}) (cond {NIL (snd el)} {T :fine}))
(print "case" (case (snd el) {1 :one}) (case 1 {(snd el) :b} {1 :one}) (case 1 {1 (fst only)}))
(print "between?" (between? 1 3 (snd el)) (between? (fst nums) 3 2) (all-between? 0 100 nums) (all-between? 0 100 (take 1 nums)))
(print "sort-desc" (sort-desc el) (best-of 2 nums) (worst-of 1 only) (split 2 el))
(print "repeat" (repeat 2 {(snd el)}) (repeat 2 (snd {1 2})))
(print "first..." (first el) (second el) (third nums) (fourth el))
(print "unpack" (unpack list el) (unpack list (take 1 el)) (unpack + nums) (apply max nums))
(print "pack" (pack len 1 2) (pack (fn {l} {len l}) (fst el)))
(print "contains?" (contains? el (error "bee")) (contains? nums 30) (starts-with? el NIL))

; the built-ins: those that pass an item to a function stop; the rest take the items as values
(print "map" (map type-of el) (map (fn {x} {type-of x}) el) (map error? el) (map error-message el))
(print "filter" (filter error? el) (filter nil? el) (filter (fn {x} {T}) el))
(print "folds" (foldl (fn {a x} {cons x a}) NIL el) (foldr (fn {x a} {+ 1 a}) 0 el) (foldl + 0 nums))
(print "search" (count error? el) (any? error? el) (all? error? el) (find error? el) (find num? nums) (find (fn {x} {T}) only))
(print "sort" (sort el) (sort nums) (sort (join el nums)) (sort only (fn {a b} {T})))
(print "order" (eq el el) (eq only (hash-put h {:x (error "only")} {:y (error "y")})) (cmp el nums) (cmp only only))
(print "index" (index-of el NIL) (last-index-of el NIL) (elem? NIL el) (in? 3 nums) (index-of nums 30))
(print "parts" (reverse el) (join el {9}) (cons 0 el) (take 2 el) (drop 3 el) (init el) (head el) (end el) (tail only))
(print "items" (fst el) (snd el) (nth 3 el) (last el) (item-at el 1) (subset el 1 2) (error-message (last only)))
(print "strings" (str-join el ",") (str-join only) (format "{} {}" (fst el) (snd el)) (+ "el=" el) (to-str el))
(print "repr" (repr el) (repr only))
(save el)
(save only)
(print "len" (len el) (len (join el el el)) (len (filter error? (join el only))))
(print "eval" (eval (cons list el)) (eval (cons print (take 1 el))) (eval (cons type-of (tail el))))
(def {quoter} (fexpr {a} {list (type-of a) (map type-of &_)}))
(print "fexpr" (eval (cons quoter el)) (unpack quoter (tail el)))
(print "each") (each {x el} (print "  item" (repr x) (error? x)))
(print "each fn" (each (fn {x} {print "  each fn" x}) el))
(print "dotimes" (dotimes {i 4} (print "  " i (nth i el))))
(print "to#" (try (to# (list {:k 1} (snd el))) &err) (buffer (take 1 nums)))
(print "set" (do (set {e1} (snd el)) (list (type-of e1))) (do (def {e2} (fst only)) (error? e2)) (try e2 &err))
(fun {takes-list l} {list (len l) (type-of (snd l)) (error? (snd l))})
(print "fn" (takes-list el) (takes-list only) ((fn {l} {fst l}) only))
(print "done")
