; 09-bits: bit-and, bit-or, bit-xor, bit-not, shl, shr, bit?, hex, bin, lo, hi and word (two's complement, any size)
; at and across the edges of a long (2^63-1, -2^63, 2^64), and of a small integer (65535, 65536, -1024); whole numbers
; of other kinds (2.0, 4/2), fractions and other kinds (each error's message and code), partial application, too many
; arguments, errors as arguments, evaluation order, and results used again (a long made from big integers).
(def {edges} {0 1 -1 2 255 256 65535 65536 -1024 -1025 2147483647 2147483648 -2147483648 4294967295 4294967296
  9223372036854775807 -9223372036854775807 -9223372036854775808 9223372036854775808 18446744073709551615
  18446744073709551616 -18446744073709551616 340282366920938463463374607431768211456})
(each {x edges} (print x (bit-not x) (bit-and x 255) (bit-or x 1) (bit-xor x -1) (bit-and x -65536)
  (bit-and x 9223372036854775807) (bit-xor x 9223372036854775808)))
(print "and/or/xor" (bit-and 12 10) (bit-or 12 10) (bit-xor 12 10) (bit-and 255 15 7) (bit-or 1 2 4 8) (bit-xor 1 3 7 15))
(print "one arg" (bit-and 5) (bit-or -5) (bit-xor 9223372036854775808) (bit-and) (bit-or) (bit-xor))
(print "mixed" (bit-and -9223372036854775808 -1) (bit-or 9223372036854775807 -9223372036854775808)
  (bit-xor 18446744073709551615 9223372036854775807) (bit-and (- (shl 1 64) 1) -1) (bit-or (shl 1 64) (shl 1 63)))

; shifts across 63 and 64 bits, both ways, both signs
(each {k {0 1 7 31 32 62 63 64 65 100 127 128}} (print "shift" k (shl 1 k) (shl -1 k) (shl 3 k) (shr (shl 1 k) k)
  (shr -1 k) (shr 9223372036854775807 k) (shr -9223372036854775808 k) (shr 18446744073709551616 k)))
(print "shift" (shl 5 0) (shr 5 0) (shl 0 1000) (shr 0 1000) (shr -5 1) (shr -5 2) (shr 5 -1) (shl 5 -1))
(print "bit?" (map (fn {k} {bit? -9223372036854775808 k}) {0 62 63 64 100}) (map (fn {k} {bit? 9223372036854775807 k}) {0 62 63 64})
  (bit? 0 0) (bit? 1 0) (bit? 2 1) (bit? -2 0) (bit? (shl 1 200) 200) (bit? (shl 1 200) 199))

; hex and bin, with widths
(print "hex" (hex 0) (hex 255) (hex 4096) (hex 9223372036854775807) (hex -9223372036854775808) (hex 18446744073709551616) (hex -1))
(print "hex width" (hex 10 4) (hex 255 1) (hex 255 0) (hex 65535 8) (hex -10 4) (hex 9223372036854775808 20))
(print "bin" (bin 0) (bin 5) (bin 255) (bin 65536) (bin -5) (bin 5 8) (bin 9223372036854775807) (bin 9223372036854775808 70))
(print "whole kinds" (hex 255.0) (bin 4/2) (bit-and 3 1.0) (shl 1.0 2) (shr 8 2.0) (bit? 5 0.0) (hex 16 2.0) (lo 258.0))

; lo, hi and word
(print "lo hi" (lo #x1234) (hi #x1234) (lo 0) (hi 0) (lo -1) (hi -1) (hi #x123456) (lo #x123456) (lo 65536) (hi 65535))
(print "lo hi" (lo 9223372036854775807) (hi 9223372036854775807) (lo -9223372036854775808) (hi -9223372036854775808))
(print "word" (word #x34 #x12) (word 0 0) (word 255 255) (word 0 1) (word 1 0) (word 256 0) (word -1 0) (word 0 -1) (word 300 2))
(print "round trip" (map (fn {n} {word (lo n) (hi n)}) {0 1 255 256 4660 65535 65536 -1}))

; their errors (message and code), partial application, too many arguments, errors as arguments, order
(fun {try-it c} {try (eval c) (list &err &code)})
(each {c {{bit-and 1.5 1} {bit-or :a} {bit-xor "3" 1} {bit-not 1/2} {bit-not NIL} {shl 1/2 1} {shl 1 1.5} {shr 1 :k}
  {bit? 1.5 0} {bit? 1 "0"} {hex 1/2} {hex 1.5} {hex :x} {hex 10 -1} {hex 10 1/2} {bin "5"} {bin 5 :w}
  {lo 1/2} {hi "x"} {word 1.5 0} {word 0 :b} {bit-and 1 (complex 1 1)} {shl 1 (shl 1 100)}}}
  (print "error" c (try-it c)))
(print "partial" (bit-and) ((shl 1) 10) ((bit? 5) 0) ((word 1) 2) ((hex 255) 4) (map (shl 1) {0 1 2 3}) (shl 1))
(print "too many" (try (bit-not 1 2) &err) (try (shl 1 2 3) &err) (try (bit? 1 2 3) &err) (try (hex 1 2 3) &err) (try (lo 1 2) &err))
(print "error args" (try (bit-and 1 (error "e1")) &err) (try (shl (error "e2") 1) &err) (try (hex (error "e3") 2) &err))
(fun {say x} {do (write x " ") x})
(print "order" (bit-or (say 1) (say 2) (say 4)) (shl (say 1) (say 3)) (try (bit-and (say 1) (say 1.5) (say 3)) &err))
(def {made} (- (shl 1 70) (- (shl 1 70) 5)))
(print "made" made (int? made) (bit-and made 4) (shl made 2) (dotimes {i made} (write i)) (nth made (range 10)) (range made))
(print "bytes" (map lo (bytes "Hi\xff")) (from-bytes (map (fn {b} {bit-xor b 32}) (bytes "hello"))))
