; 10-buffers: buffers made every way, read and written (a buffer called with an index, buffer-get, buffer-put, a
; character as a byte), filled, copied (overlapping either way, counts past the end), compared (buffer-cmp against
; buffers and strings, parts of them), printed, saved, equal and ordered by their bytes, shared wherever they're kept
; (a list, a hash, a closure, a partial application), read into from a file and written from; each error's message
; and code, partial application and too many arguments.
(fun {show b} {list (len b) (bytes b) (repr b)})
(print "made" (buffer 3) (buffer 2 255) (buffer 2 \a) (buffer "hi") (buffer {1 2 255}) (buffer 0) (buffer "") (buffer NIL))
(def {a} (buffer {1 2 3}))
(def {c} (buffer a))
(buffer-put c 0 9)
(print "copy" a c (eq a c) (eq a (buffer {1 2 3})) (buffer (tail {7 8 9})) (buffer (drop 1 (range 5))) (buffer (str-chars "ab")))
(print "kinds" (type-of a) (buffer? a) (buffer? "x") (buffer? (bytes a)) (buffer? (error "e")) (repr a) (to-str a) (+ "b=" a))
(print "printed" a [a (buffer 1)] (str-join (list a a) "|") (format "<{}>" a))
(save a)
(save (list (buffer {0 255}) (buffer "")))
(print "read back" (eval (fst (read (output-of (save (buffer {7 0 255}))))))
  (eq (eval (fst (read (output-of (save a))))) a))

; reading: called with an index, buffer-get; a byte's index as a whole number of another kind
(def {b} (buffer {10 20 30}))
(print "get" (b 0) (b 2) (buffer-get b 1) (b 2.0) (b 4/2) (map (buffer-get b) {0 1 2}) ((buffer-get b) 1))
(fun {err c} {try (eval c) (list &err &code)})
(each {x {{b 3} {b -1} {b :x} {b 1.5} {b 0 1} {b} {buffer-get "abc" 0} {buffer-get b 9} {buffer-get b NIL}}}
  (print "get error" x (err x)))

; writing: the old byte; shared, so a change shows wherever the buffer is
(def {kept} (list b b))
(def {hb} (to# [[:b b]]))
(def {peek} (fn {i} {b i}))
(def {pg} (buffer-get b))
(print "put" (buffer-put b 1 99) (b 1) (buffer-put b 0 \A) (b 0) (buffer-put b 2 0.0) b)
(print "shared" kept (hb :b) (peek 0) (pg 1) (eq (fst kept) b) (len kept))
(fun {zero-it x} {buffer-put x 0 0})
(zero-it (snd kept))
(print "shared" b (hb :b) (peek 0))
(each {x {{buffer-put b 3 0} {buffer-put b 0 256} {buffer-put b 0 -1} {buffer-put b 0 "x"} {buffer-put b 0 1.5}
  {buffer-put "abc" 0 1} {buffer-put b :i 1}}} (print "put error" x (err x)))

; filling and copying (overlapping, either way; counts past the end)
(def {f} (buffer 6))
(print "fill" (buffer-fill f 1) (bytes f) (buffer-fill f 2 4) (bytes f) (buffer-fill f 3 1 2) (bytes f) (buffer-fill f 0 5 100) (bytes f))
(print "fill" (buffer-fill f \z 6) (bytes f) (buffer-fill f 7 0 0) (bytes f) (buffer-fill f 8 2 2.0) (bytes f))
(each {x {{buffer-fill f 0 7} {buffer-fill f 0 0 -1} {buffer-fill f 256} {buffer-fill f 0 1.5} {buffer-fill "s" 0}}}
  (print "fill error" x (err x)))
(def {g} (buffer {1 2 3 4 5 6 7 8}))
(print "copy" (buffer-copy g 0 (buffer {9 8})) (bytes g) (buffer-copy g 6 (buffer {7 6 5 4}) 1) (bytes g))
(print "overlap up" (buffer-copy g 1 g 0 5) (bytes g))
(print "overlap down" (buffer-copy g 0 g 3) (bytes g))
(print "from a string" (buffer-copy g 2 (buffer "abc") 1 1) (bytes g) (buffer-copy g 7 (buffer "xyz")) (bytes g))
(print "nothing" (buffer-copy g 8 (buffer "q")) (buffer-copy g 0 (buffer "q") 1) (buffer-copy g 0 g 0 0) (bytes g))
(each {x {{buffer-copy g 9 g} {buffer-copy g 0 "abc"} {buffer-copy g 0 g 9} {buffer-copy g -1 g} {buffer-copy g 0 g 0 -1}}}
  (print "copy error" x (err x)))

; comparing, as cmp orders strings
(def {s} (buffer "abcdef"))
(print "cmp" (buffer-cmp s 0 "abc") (buffer-cmp s 2 "cd") (buffer-cmp s 2 (buffer "cde")) (buffer-cmp s 2 "ce") (buffer-cmp s 2 "cc"))
(print "cmp" (buffer-cmp s 4 "efg") (buffer-cmp s 6 "") (buffer-cmp s 6 "a") (buffer-cmp s 1 "xbcd" 1) (buffer-cmp s 1 "xbcz" 1 2))
(print "cmp" (buffer-cmp s 1 (buffer "xbcz") 1 3) (buffer-cmp (buffer {0 255}) 0 "\x00\xff") (buffer-cmp (buffer {0 255}) 0 "\x00\xfe"))
(print "cmp" (buffer-cmp s 0 s) (buffer-cmp s 0 s 1) (buffer-cmp s 1 s) (buffer-cmp s 0 "") (buffer-cmp s 0 "abcdefg"))
(each {x {{buffer-cmp s 7 "a"} {buffer-cmp s 0 "a" 2} {buffer-cmp s 0 {97}} {buffer-cmp "abc" 0 "a"} {buffer-cmp s 0 "a" 0 -1}}}
  (print "cmp error" x (err x)))

; equality and order among buffers and other values
(print "eq" (eq (buffer {1 2}) (buffer {1 2})) (eq (buffer {1 2}) (buffer {1 3})) (eq (buffer {1}) {1}) (eq (buffer "a") "a"))
(print "order" (cmp (buffer {1 2}) (buffer {1 3})) (cmp (buffer {1 2}) (buffer {1})) (cmp (buffer {1}) (to# {})) (cmp (buffer {}) "z"))
(print "sorted" (sort (list (buffer {2}) "s" (buffer {1 0}) 5 (buffer {1}) (to# {{:k 1}}) (buffer {})))
  (min (buffer {3}) (buffer {2 9})) (max (buffer {3}) (buffer {2 9})) (elem? (buffer {2}) (list (buffer {2}))))
(print "as key" (err {hash-put (hash-create) [(buffer {1}) 1]}) (err {to# [[(buffer {1}) 2]]}))

; made, errors and the rest
(each {x {{buffer -1} {buffer 1.5} {buffer 2 256} {buffer {1 256}} {buffer {1 :x}} {buffer "ab" 1} {buffer :x} {buffer 2 -1}
  {buffer 2 "ab"} {from-bytes (buffer {1}) 2}}} (print "make error" x (err x)))
(print "partial" (buffer-put b 0) ((buffer-put b 0) 5) b ((buffer-fill b) 1) b (buffer-copy b) (buffer-cmp s 0))
(print "too many" (err {buffer 1 2 3}) (err {buffer? 1 2}) (err {buffer-get b 0 1}) (err {buffer-fill b 1 0 1 9}))
(print "bytes" (repr (from-bytes (buffer "a\x00\xff"))) (bytes (buffer "\xfe")) (len (buffer 1000)) (len (buffer (str-repeat "ab" 500))))

; a file's bytes read into one, and written from one, in this case's folder
(def {out} (open "buf.tmp" :write))
(write-bytes out (buffer {0 1 2 3 255}))
(write-bytes out (buffer {9 8 7 6}) 1 2)
(write-bytes out (buffer {5 5}) 2)
(close out)
(def {r} (buffer 4))
(def {in} (open "buf.tmp"))
(print "read" (read-buffer in r) (bytes r) (read-buffer in r 1 2) (bytes r) (read-buffer in r 3) (bytes r) (read-buffer in r) (read-buffer in r 4))
(close in)
(print "file" (bytes (read-file "buf.tmp")) (err {read-buffer in r}) (err {read-buffer 5 r}) (err {write-bytes stdout (buffer 1) 3}))
(remove "buf.tmp")
