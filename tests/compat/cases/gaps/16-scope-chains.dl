; 16-scope-chains: a name looked up from deep inside nested closures (8 calls' scopes, then lets and loop steps, then
; the global one), first found globally, then bound later at one level after another (eval of set code written at
; that level, which remembers its scope), nearer and farther, a level pushed past 8 bindings first, and set! from the
; inside changing the nearest; each lookup must find the nearest binding there is at that moment.
(def {v} :global)
(def {hooks} (hash-create))
(fun {hook k q} {hash-put hooks [k q]})
(fun {at k} {eval (hooks k)})
(def {mk} (fn {a} {do (hook :a {set {v} (list :a a)}) (fn {b} {do (hook :b {set {v} (list :b b)})
  (fn {c} {do (hook :c {set {v} (list :c c)}) (fn {d} {do (hook :d {set {v} (list :d d)})
  (hook :d-many {do (set {p1} 1) (set {p2} 2) (set {p3} 3) (set {p4} 4) (set {p5} 5) (set {p6} 6) (set {p7} 7) (set {p8} 8) (set {p9} 9)})
  (fn {e} {do (hook :e {set {v} (list :e e)}) (fn {f} {do (hook :f {set {v} (list :f f)})
  (fn {g} {do (hook :g {set {v} (list :g g)}) (fn {h} {list a b c d e f g h v (if (defined? p9) p9 :no-p9)})})})})})})})}))
(def {inner} (((((((mk 1) 2) 3) 4) 5) 6) 7))
(print "global" (inner 8) (inner 9) (map inner {10 11}))
(dotimes {i 3} (inner i))
(print "hooks" (hash-keys hooks))
(at :c)
(print "at c" (inner 8) (inner 9))
(at :f)
(print "at f" (inner 8) v)
(at :a)
(print "at a, farther" (inner 8))
(at :d-many)
(at :d)
(print "d with 9 more" (inner 8))
(at :g)
(print "at g, nearest" (inner 8) (map inner {1 2}))
(print "another chain" ((((((((mk :x) :y) :z) :w) :u) :t2) :s) :r) (inner 8))
(def {v} :global-again)
(print "global changed" (inner 8) v)

; set! from the innermost changes the nearest binding of the chain it's in
(def {mk2} (fn {a} {do =(v :a-local) (fn {b} {fn {c} {fn {n} {do (set! {v} (list :set n)) (list a b c v)}}})}))
(def {in2} (((mk2 1) 2) 3))
(print "set!" (in2 1) (in2 2) v)
(def {mk3} (fn {a} {fn {b} {fn {n} {do (set! {v} (list :set-global n)) (list a b v)}}}))
(print "set! global" (((mk3 1) 2) 5) v)

; lets and loop steps in the chain (a dotimes step, an each step, a let), each a scope of its own, binding v later
(def {v} :g3)
(def {made} NIL)
(fun {loops} {let {{x :let-x}} (dotimes {i 2} (do
  =(i-hook {set {v} (list :i i)})
  (each {y {:p :q}} (do
    =(y-hook {set {v} (list :y i y)})
    (let {{z (list i y)}} (set! {made} (cons (list (fn {} {list x i y z v}) i-hook y-hook {set {v} (list :z z)}) made)))))))})
(loops)
(def {made} (reverse made))
(fun {seen} {map (fn {m} {(fst m)}) made})
(print "loops" (seen))
(eval (snd (nth 0 made)))
(print "i 0" (seen))
(eval (thd (nth 3 made)))
(print "y 1 q" (seen))
(eval (nth 3 (nth 1 made)))
(print "z 0 q" (seen))
(eval (snd (nth 2 made)))
(print "i 1" (seen))
(each {m made} (eval (thd m)))
(print "every y" (seen) v)

; one closure called from scopes of every shape: what it sees is where it was made, never its caller's
(def {see} (let {{w :let-w}} (fn {} {list w v})))
(fun {caller1 w v} {see})
(fun {caller2} {do (set {w} :c2) (set {v} :c2) (see)})
(print "callers" (see) (caller1 1 2) (caller2) (let {{v :let} {w :let}} (see)) (dotimes {v 1} (print "  " (see))))
(def {w-hook} (let {{w :let-w2}} (list (fn {} {list w v}) {set {v} :in-the-let})))
(print "late in a let" ((fst w-hook)) (eval (snd w-hook)) ((fst w-hook)) v)
