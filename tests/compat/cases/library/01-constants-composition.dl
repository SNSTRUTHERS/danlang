; 01-constants-composition: lib/globals.dl's constants (math.pi, math.e, math.phi, math.gamma) and its composition
; helpers flip, comp and ghost: their values printed, ordinary calls, partial application (printed, then called), too
; many arguments, wrong kinds, errors as arguments, the order arguments are evaluated in, and ghost's &_ run as code.
; Ends with an error from inside flip, called from a user function (its trace through lib\globals.dl).

; the constants: fixed decimals, as many places as were written
(print math.pi)
(print math.e)
(print math.phi)
(print math.gamma)
(print (repr math.pi) (type-of math.e) (fixed? math.phi) (rational? math.gamma) (int? math.pi))
(print (* 2 math.pi))
(print (+ math.e 1/2) (- math.phi) (/ math.gamma 2))
(print (< math.gamma math.phi) (< math.e math.phi) (> math.pi 3.14159) (truncate math.pi) (to-fixed math.e 3) (cmp math.pi 22/7))
(print (eq math.phi (+ 1 (/ 1 math.phi))))

; flip: (flip f a b) is (f b a)
(print flip)
(print (flip - 1 10) (flip / 2 1) (flip cons {2 3} 1) (flip list :a :b) (flip join {1} {2}) (flip + " world" "hello"))
(print (flip - 9223372036854775807 -1) (flip - 65536 65535) (flip * -1025 -1024) (flip / 7 -7/2) (flip - 0.1 2.50))
(print (flip (fn {x y} {list :x x :y y}) 1 2))
(print (flip -))
(print ((flip -) 1))
(print (((flip -) 1) 10))
(print ((flip list 1) 2))
(print (flip))
(print (flip - 1 2 3))
(print (flip 5 1 2))
(print (flip "s" 1 2))
(print (flip :a 1 2))
(print (flip NIL 1 2))
(print (flip (error "flip's f") 1 2))
(print (flip - (error "flip's a") 2))
(print (flip - 1 (error "flip's b")))
(print (flip (do (print :f-first) list) (do (print :a-second) 1) (do (print :b-third) 2)))
(print (flip if T NIL))

; comp: (comp f g x) is (f (g x))
(print comp)
(print (comp - abs -5) (comp 1+ 1+ 1) (comp list list 1) (comp fst reverse {1 2 3}) (comp str-upper to-str :abc))
(print (comp square 1+ 9223372036854775807))
(print (comp - -))
(print ((comp - -) 5))
(print (comp len))
(print (((comp len) reverse) "abcd"))
(print (comp))
(print (comp 1 2 3))
(print (comp - abs -5 1))
(print (comp - "x" 1))
(print (comp (error "comp's f") 1 2))
(print (comp - abs (error "comp's x")))
(print (comp (do (print :f) -) (do (print :g) abs) (do (print :x) -7)))

; ghost: (ghost f x...) is (f x...), &_ run as code where ghost runs (its own scope)
(print ghost)
(print (ghost + 1 2) (ghost list 1 2 3) (ghost max 3 9 2) (ghost (fn {x} {* x x}) 7) (ghost str-join {"a" "b"} "-"))
(print (ghost))
(print (ghost +))
(print (ghost 5))
(print (ghost "x" 1))
(print (ghost if T :then :else))
(print (ghost if NIL :then))
(print (ghost print "printed" "by" "ghost"))
(print (ghost do (print :arg-a) (print :arg-b)))
(print (ghost list (fst {&_})))
(print (ghost list (fst {f})))
(print (ghost list (fst {(+ 1 2)}) (fst {math.e})))
(print (ghost (error "ghost's f") 1))
(print (ghost + 1 (error "ghost's arg")))
(print (ghost - 1))
(print ((ghost -) 1))

; an error from inside flip, called from a function: the program ends with its trace
(fun {use-flip x} {list :before (flip - x "nine")})
(print (use-flip 1))
(use-flip 2)
