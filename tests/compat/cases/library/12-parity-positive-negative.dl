; 12-parity-positive-negative: odd? and even? (by mod n 2: so -1 is odd, 3.0 is odd, 7/2 is neither), positive? and
; negative? and their aliases +? and -? (by pos? and neg?: a complex number by its real part, then imaginary): the
; small-integer range's edges, near and past 2^63, rationals, fixed decimals, complex numbers (odd?'s trunc error),
; non-numbers (the library's own errors), partial application, too many arguments, errors as arguments.
; Ends with even?'s error on a string inside a filter in a user function (the trace through lib\globals.dl).

(print odd? even?)
(print positive? negative?)
(print +? -? (eq +? positive?) (eq -? negative?))
(def {xs} {0 1 -1 2 -2 3 -3 65535 65536 -65535 -65536 -1024 -1025 9223372036854775807 9223372036854775808 -9223372036854775808 -9223372036854775809 18446744073709551617 7/2 -7/2 4/2 2.5 -2.50 0.1 3.0 -3.00 0.0 -0.0 1.000})
(print xs)
(print :odd (map odd? xs))
(print :even (map even? xs))
(print :pos (map positive? xs))
(print :neg (map negative? xs))
(print :+? (map +? xs))
(print :-? (map -? xs))
(print :neither (filter (fn {x} {not (or (odd? x) (even? x))}) xs))
(print :zero (filter (fn {x} {not (or (+? x) (-? x))}) xs))

; written directly
(print (odd? 65535) (even? 65536) (odd? -1025) (even? -1024) (odd? 9223372036854775807) (even? 9223372036854775808) (odd? -9223372036854775809))
(print (odd? (+ 9223372036854775807 2)) (even? (* 9223372036854775807 2)) (odd? (- 0 65537)) (even? (/ 10 5)) (odd? (/ 9 3)))
(print (positive? 1/9223372036854775808) (negative? -1/9223372036854775808) (positive? 0.0000000001) (negative? -0.0000000001))
(print (positive? math.gamma) (negative? (- math.pi)) (odd? (truncate math.pi)) (even? (truncate math.e)))

; complex numbers
(print (odd? (complex 1 2)))
(print (even? (complex 2 2)))
(print (odd? (complex 3 0)))
(print (positive? (complex 1 2)) (negative? (complex -1 2)) (positive? (complex 0 1)) (negative? (complex 0 -1)) (positive? (complex 0 -1)))

; non-numbers
(print (odd? "a") (even? \a) (positive? "1") (negative? NIL))
(print (odd? T) (even? {2}) (positive? :a) (negative? +) (+? (hash-create)) (-? "-1"))
(print (odd? {}) (even? ()) (positive? (fn {x} {x})))

; partial application, too many, errors
(print (odd?) (even?) (positive?) (negative?))
(print (odd? 1 2))
(print (even? 1 2))
(print (+? 1 2))
(print (odd? (error "odd's n")) (positive? (error "positive's a")) (-? (error "-?'s a")))
(print (map odd? (range 10)) (map even? (range -5 5)) (count odd? (range 101)) (count even? (range 101)))
(print (filter positive? {-2 -1 0 1 2}) (filter negative? {-2 -1 0 1 2}) (any? negative? {0 1}) (all? positive? {1 2}))

; even? of a string, in a filter inside a user function: the program ends with its trace
(fun {evens l} {list :evens (filter even? l)})
(print (evens (range 10)))
(evens {2 4 "six" 8})
