; 17-remove: remove-fst (the first item eq to f gone), remove-all (every one), remove-min and remove-max (the first
; item eq to the least or most, as min and max find it over the items run as code again by unpack: an S-expression
; among them is evaluated, a symbol looked up; among equal items min and max take the last, remove-fst removes the
; first equal one): numbers by value (1 and 1.0), NIL against () (a Q-expression isn't an S-expression), mixed
; kinds, wrong kinds, partial application, too many and too few arguments, errors.
; Ends with remove-max's error on a string, from a user function (the trace through lib\globals.dl).

(print remove-fst)
(print remove-all)
(print remove-min remove-max)
(print (remove-fst 2 {1 2 3 2}) (remove-fst 5 {1 2}) (remove-fst 1 {1}) (remove-fst 1 NIL) (remove-fst 1.0 {1 2}) (remove-fst 1/2 {0.5 1}))
(print (remove-fst {1} {{1} 1}) (remove-fst "a" {\a "a"}) (remove-fst :a {a :a}) (remove-fst NIL {() NIL {}}) (remove-fst 65536 {65535 65536.0 65536}))
(print (remove-fst 9223372036854775808 {9223372036854775807 9223372036854775808 -9223372036854775808}) (remove-fst -1025 {-1024 -1025 -1025}))
(print (remove-all 2 {1 2 3 2}) (remove-all 2 {2 2 2}) (remove-all 5 {1}) (remove-all 1 NIL) (remove-all NIL {NIL 1 {} ()}) (remove-all 7/2 {3.5 7/2 3.50 4}))
(print (remove-all (fst {a}) {a b a}) (remove-all "x" {"x" \x :x x}) (remove-all {} {{} NIL () {{}}}) (remove-all T {T 1 T}))
(print (map fixed? (remove-fst 1 {1.0 1 1.00})) (map fixed? (remove-fst 1.0 {1 1.0})))
(print (len (remove-all 0 (map (fn {x} {% x 3}) (range 300)))))

; wrong kinds and errors
(print (remove-fst 1 "abc"))
(print (remove-all \a "abc"))
(print (remove-fst 1 5))
(print (remove-all 1 :a))
(print (remove-fst 1 T))
(print (remove-all 1 (hash-create)))
(print (remove-fst (error "rf's f") {1}))
(print (remove-fst 1 (error "rf's l")))
(print (remove-all (error "ra's f") {1}))
(print (remove-fst 1))
(print ((remove-all 1) {1 2 1 3}))
(print ((remove-fst 1) {1 2 1 3}))
(print (remove-fst 1 {1} 2))
(print (remove-all 1 {1} 2))
(print (remove-fst))

; remove-min and remove-max
(print (remove-min {3 1 2 1}) (remove-max {3 1 2 3}) (remove-min {1}) (remove-max {1}) (remove-min {65536 -1025 9223372036854775808}) (remove-max {65536 -1025 9223372036854775808}))
(print (remove-min {"b" "a" 2 \c}) (remove-max {"b" "a" 2 \c}) (remove-min {:b :a "z"}) (remove-max {{1} {2} {1 2}}))
(print (remove-min {7/2 3.5 -1 -1.0}) (map fixed? (remove-min {7/2 3.5 -1 -1.0})) (map fixed? (remove-min {-1.0 2 -1})))
(print (map fixed? (remove-max {2 2.0 1})) (map fixed? (remove-max {2.0 2 1})))
(print (remove-max {(+ 1 2) 2}))
(print (remove-min {(+ 1 2) 2}))
(print (remove-min {(* 65536 65536) 4294967296}))
(print (remove-min {b a c}))
(print (remove-min {1 x-unbound}))
(print (remove-min NIL))
(print (remove-max NIL))
(print (remove-min))
(print (remove-min 5))
(print (remove-min "abc"))
(print (remove-min {3 1} {2}))
(print (remove-min {3 1} 2))
(print (remove-min (error "rm's list")))
(print (remove-min (map (fn {x} {% (* x 7) 11}) (range 11))) (remove-max (map (fn {x} {% (* x 7) 11}) (range 11))))

; remove-max of a string, from a user function: the program ends with its trace
(fun {drop-highest scores} {list :kept (remove-max scores)})
(print (drop-highest {70 95 80 95}))
(drop-highest "95 80")
