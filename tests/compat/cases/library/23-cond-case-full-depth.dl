; 23-cond-case-full-depth: a recursion through a cond clause's value, from the top level: 9,999 levels nest (the
; most there can be, as each level is one call nested), and a case recursion asked for 20,000 levels stops at the
; limit with "Too deep" (it isn't a tail call, as an if's branch would be: that one runs all 20,000).  The
; recursions count their own levels with set!, so where each stopped is printed; the counts of small ones, and of
; ones whose clause values carry an accumulator, show the same order of calls.  (The program ends normally.)

(fun {cd1 n} {cond {(=0 n) :bottom} {T (cd1 (1- n))}})
(print :cond-9999 (cd1 9999))

(def {levels} 0)
(fun {cs1 n} {do (set! {levels} (1+ levels)) (case (=0 n) {T :bottom} {NIL (cs1 (1- n))})})
(print :case-10 (cs1 10) levels)
(def {levels} 0)
(print :case-20000 (cs1 20000) :levels-run levels)

; an if's branch: a tail call, so all 20,000 levels run
(def {levels} 0)
(fun {lp n} {do (set! {levels} (1+ levels)) (if (=0 n) :bottom (lp (1- n)))})
(print :if-20000 (lp 20000) :levels-run levels)

; accumulators through the clause values
(fun {sum-to n acc} {cond {(=0 n) acc} {T (sum-to (1- n) (+ acc n))}})
(print (sum-to 100 0) (sum-to 1000 9223372036854775807))
(fun {fact n} {case (<= n 1) {T 1} {NIL (* n (fact (1- n)))}})
(print (fact 0) (fact 1) (fact 20) (fact 21) (fact 25))
(fun {collatz n steps} {cond {(=1 n) steps} {(even? n) (collatz (/ n 2) (1+ steps))} {T (collatz (+ 1 (* 3 n)) (1+ steps))}})
(print (collatz 27 0) (collatz 65536 0) (collatz 9223372036854775807 0))

; the order the levels ran in, by a trail of prints
(fun {trail n} {cond {(=0 n) (do (print :trail-bottom) :done)} {T (do (print :trail-level n) (trail (1- n)))}})
(print (trail 3))
