; 05-take-drop.dl - take, drop, the library's skip and split, and subset: counts of 0, within, at and past the end,
; huge, and whole numbers of other kinds; negative, fractional and wrong kinds as errors (their messages, and which
; is found first); take and drop put back together; partially applied

(def {l} {a b c d e})
(print (take 0 l) (take 1 l) (take 3 l) (take 5 l) (take 6 l) (take 100 l))
(print (drop 0 l) (drop 1 l) (drop 3 l) (drop 5 l) (drop 6 l) (drop 100 l))
(print (skip 2 l) (split 2 l) (split 0 l) (split 5 l) (split 9 l) (split 1 NIL))
(print (take 2 NIL) (drop 2 NIL) (take 0 NIL) (drop 0 {}) (take 1 {NIL}) (drop 1 {NIL NIL}))
(print (take 2.0 l) (take 4/2 l) (drop 3.0 l) (drop 6/2 l) (take (complex 2 0) l))
(print (take 100000000000000000000 l) (drop 100000000000000000000 l))
(print (take 2 {(+ 1 2) {x} "s"}) (drop 2 {(+ 1 2) {x} "s"}) (repr (take 1 {"s" \c})))
(print l)

; take and drop put back together
(dotimes {n 7} (print "  " n (take n l) (drop n l) (eq (join (take n l) (drop n l)) l) (split n l)))
(print (take 2 (drop 1 l)) (drop 1 (take 4 l)) (take 2 (take 3 l)) (drop 2 (drop 2 l)))

; errors
(print (take -1 l))
(print (drop -1 l))
(print (take 1.5 l))
(print (drop 1/2 l))
(print (take :a l))
(print (drop "1" l))
(print (take NIL l))
(print (take 2 "abcd"))
(print (drop 2 5))
(print (take l 2))
(print (take -1 5))
(print (drop 1.5 "s"))
(print (take 1 l 2))
(print (split -1 l))
(print (split 1 5))

; subset: from an index (0 to the length), so many items (as many as there are)
(print (subset l 0) (subset l 2) (subset l 5) (subset l 0 2) (subset l 1 3) (subset l 3 10) (subset l 5 0) (subset l 2 0))
(print (subset NIL 0) (subset {} 0 5) (subset l 1.0 2.0) (subset l 4/2) (subset l 0 100000000000000000000))
(print (subset l 6))
(print (subset l -1))
(print (subset l 1 -1))
(print (subset l 1.5))
(print (subset l 1 1/2))
(print (subset "abc" 1))
(print (subset l :x))
(print (subset l 100000000000000000000))
(print (subset l 9 -1))
(print (subset l 1 2 3))
(dotimes {i 6} (print "  " i (subset l i) (subset l i 1) (subset l i 2)))

; partially applied
(print (take 2) (drop 1) (subset l) (take) (split 1))
(print (map (take 2) {{1 2 3} {4} NIL}) (map (drop 1) {{1 2 3} {4} NIL}) ((subset l) 3) ((subset l) 1 2))
(print ((subset l 1) 2))
(print (map (fn {n} {take n l}) (range 6)))
(print (map (fn {n} {drop n l}) (range 6)))
(print (map (split 2) {{1 2 3} {4}}))

; the results are new lists: l is as it was
(print l)
