; 14-long.dl - very long lists: 100,000 items made by range, then len, fst, last, nth, item-at, sum, the folds, map,
; filter, reverse, sort (both ways, and of a list reversed), take, drop, subset, join, tail, init, cons, count, find,
; any?, all?, elem?, index-of, eq and cmp on them (sorts with a less function on 10,000 of them); a 1,000-item list
; printed whole

(def {big} (range 100000))
(print (len big) (fst big) (last big) (nth 99999 big) (item-at big 50000) (snd big) (thd big))
(print (sum big) (foldr + 0 big) (product (take 20 (drop 1 big))))
(def {plus1} (map 1+ big))
(print (len plus1) (fst plus1) (last plus1) (eq (drop 1 big) (init plus1)))
(def {evens} (filter (fn {x} {zero? (bit-and x 1)}) big))
(print (len evens) (take 5 evens) (last evens) (sum evens))
(print (take 5 (reverse big)) (last (reverse big)) (eq (reverse (reverse big)) big))
(def {sorted} (sort (reverse big)))
(print (take 5 sorted) (last sorted) (eq sorted big) (eq (sort big) big))
(def {tenk} (take 10000 big))
(def {down} (sort tenk >))
(print (take 5 down) (last down) (eq down (reverse tenk)))
(def {keyed} (sort (take 4000 tenk) (fn {a b} {< (bit-and a 7) (bit-and b 7)})))
(print (take 6 keyed) (take 3 (drop 500 keyed)) (last keyed) (len keyed))
(print (len (join big big)) (nth 100000 (join big big)) (len (join big NIL big NIL)) (len (cons -1 big)) (fst (cons -1 big)))
(print (len (tail big)) (len (init big)) (fst (tail big)) (last (init big)) (len (head big)) (end big))
(print (len (take 99999 big)) (drop 99997 big) (len (drop 3 big)) (subset big 99998) (len (subset big 10 50000)) (take 3 (subset big 77777 2)))
(print (count zero? big) (find (fn {x} {> x 5}) big) (any? neg? big) (all? num? (take 5000 big)) (find neg? (drop 90000 big)))
(print (elem? 99999 big) (elem? 100000 big) (index-of big 77777) (last-index-of big 3) (index-of big -1) (in? 50000 big))
(print (eq big (cons 0 (tail big))) (eq big (init big)) (cmp big (join big {0})) (cmp big plus1) (< (init big) big) (> big (init big)))
(print (len (map (fn {x} {[x x]}) (take 1000 big))) (take 3 (map (fn {x} {[x x]}) (take 1000 big))))
(print (foldl max 0 big) (unpack max (take 1000 big)) (unpack min (drop 99000 big)))
(print (len (str-chars (str-repeat "ab" 50000))) (len (str-split (str-repeat "a," 50000) ",")) (len (str-join (take 1000 big) ",")))

; a thousand items, printed whole
(print (range 1000))
(print (map (fn {i} {* i i}) (range 100)))
(print (len big) (take 3 big) (eq big (range 100000)))
