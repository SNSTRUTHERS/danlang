; 14-hash-tags.dl - tags: the hash's and its entries' (atoms), and the reserved ones: private (only methods reach
; the entry), locked (no entries added or removed), read-only (nothing changed), not NIL; every way a tag is added
; (hash-create, hash-put, hash-add-tag, hash-lock and the hash-make- ones, with keys and without), each taking effect
; on a hash already used without tags; the tests (hash-tag?, hash-locked?, hash-private?, hash-const?); every message

; a hash used untagged, then each reserved tag added: what it stops, and the messages
(def {h} #({{:a 1} {:b 2} {:c 3}}))
(print (h :a) (hash-put h {:a 10}) (hash-remove h :c) h)
(print "make-private:" (hash-make-private h :a) (hash-private? h :a) (hash-private? h :b) (hash-private? h))
(print (h :a))
(print (hash-get h :a))
(print (hash-put h {:a 11}))
(print (hash-remove h :a))
(print (hash-key? h :a) (len h) (hash-keys h) (hash-values h) h)
(print "make-not-nil:" (hash-make-not-nil h :b) (hash-tag? h {:b :__not_nil}))
(print (hash-put h {:b NIL}))
(print (hash-put h {:b 20}) (hash-remove h :b) h)
(hash-put h {:b 2} {:d 4})
(print "lock:" (hash-lock h) (hash-locked? h) (hash-locked? h :b))
(print (hash-put h {:new 1}))
(print (hash-put h {:b 21}) (hash-put h {:b NIL}) h (hash-keys h) (len h) (hash-key? h :b) (h :b))
(print (hash-remove h :d))
(print (hash-remove h :none))
(print "make-const:" (hash-make-const h) (hash-const? h))
(print (hash-put h {:b 22}))
(print (hash-put h {:none 1}))
(print (hash-remove h :b))
(print (hash-remove h :none))
(print (hash-add-tag h :still-taggable) h)

; entry tags: read-only and locked on one entry
(def {e} #({{:ro 1 :__read-only} {:lk 2 :__locked} {:free 3}}))
(print (hash-const? e :ro) (hash-locked? e :lk) (hash-const? e) (hash-locked? e))
(print (hash-put e {:ro 5}))
(print (hash-put e {:ro NIL}))
(print (hash-remove e :ro))
(print (hash-put e {:lk 5}) (hash-put e {:lk NIL}) e (hash-keys e))
(print (hash-remove e :lk) e)
(print (hash-put e {:free NIL}) e)

; tags given in hash-put's entries and hash-add-tag's {key tag}, then tested
(def {g} #({{:x 1}}))
(print (hash-put g {:x 1 :__private}) (g :x))
(def {g2} #({{:y 1}}))
(print (hash-add-tag g2 {:y :__read-only}) (hash-put g2 {:y 2}))
(def {g3} #({{:z 1}}))
(print (hash-put g3 {:__locked}) (hash-put g3 {:other 1}) (hash-locked? g3))
(def {g4} #({{:w 1}}))
(print (hash-make-private g4 :w :w) (g4 :w))
(def {g5} #({{:p 1} {:q 2}}))
(print (hash-make-const g5 :p :q) (hash-put g5 {:p 0}) (hash-put g5 {:q 0}))
(def {g6} (hash-clone #({{:k 1}}) {:k 1 :__private}))
(print (g6 :k))

; ordinary tags: added, added again (NIL), tested; in print and from#
(def {o} #({{:k 1} :first}))
(print (hash-add-tag o :second) (hash-add-tag o :second) (hash-add-tag o :SECOND) (hash-add-tag o {:k :etag}))
(print (hash-add-tag o :x :y {:k :e2}) o (from# o))
(print (hash-tag? o :first) (hash-tag? o :none) (hash-tag? o {:first}) (hash-tag? o {:k :etag}) (hash-tag? o {:k :none}))
(print (hash-locked? o) (hash-private? o) (hash-const? o) (hash-locked? o :k) (hash-private? o :k) (hash-const? o :k))

; the errors
(print (hash-tag? o {:none :t}))
(print (hash-tag? o 5))
(print (hash-tag? o {}))
(print (hash-tag? o {:k 5}))
(print (hash-tag? 5 :t))
(print (hash-add-tag o 5))
(print (hash-add-tag o {:none :t}))
(print (hash-add-tag o {:k 5}))
(print (hash-add-tag o {:k :a :b}))
(print (hash-add-tag o "str"))
(print (hash-add-tag 5 :t))
(print (hash-locked? o :none))
(print (hash-private? 5))
(print (hash-const? o 1.5))
(print (hash-lock o :none))
(print (hash-make-private o :none))
(print (hash-make-not-nil 5 :k))
(print (hash-put o {:k 1 "tag"}))
(print (hash-put o {:k 1 :ok 5}) (hash-tag? o {:k :ok}))
