(f 1 2 (starts-with? "abc" "a"))
(f 1 2 (starts-with? "abc" "c"))
(f 1 2 (starts-with? "abc" "x"))
(f 1 2 (ends-with? "abc" "bc"))
(f 1 2 (ends-with? "abc" "abcd"))
(f 1 2 (ends-with? "abc" "abcd"))
(f 1 2 (contains? "abc" "b"))
(f 1 2 (contains? "abc" "b"))
(f 1 2 (zip {1 2} {3 4}))
(f 1 2 (zip {1 2} {3 4}))
(f 1 2 (zip NIL {3 4}))
(f 1 2 (flatten {1 {2}}))
(f 1 2 (flatten {{1} 2}))
(f 1 2 (flatten {{1} 2}))
(f 1 2 (flatten NIL))
