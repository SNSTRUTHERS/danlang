; 03-sites: the place an error says it was made when it's made before another call starts (here: f given 3
; arguments, its arity error) right after a library function's call: where that call's code left evaluation.  Each
; three times (the first call learns its plans, the later ones use them)
(fun {f a b} {+ a b})
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (% -7 2))
(f 1 2 (div 7 2))
(f 1 2 (div 7 2))
(f 1 2 (div -7 2))
(f 1 2 (div -7 2))
(f 1 2 (div 8 2))
(f 1 2 (floor 7/2))
(f 1 2 (floor 7/2))
(f 1 2 (floor -7/2))
(f 1 2 (floor -7/2))
(f 1 2 (floor 3))
(f 1 2 (ceil 7/2))
(f 1 2 (ceil 7/2))
(f 1 2 (ceil -7/2))
(f 1 2 (ceil -7/2))
(f 1 2 (round 5/2))
(f 1 2 (round 5/2))
(f 1 2 (round -5/2))
(f 1 2 (round -5/2))
(f 1 2 (round 2.4))
(f 1 2 (even? 4))
(f 1 2 (even? 4))
(f 1 2 (even? -3))
(f 1 2 (even? 100001))
(f 1 2 (even? 2.0))
(f 1 2 (odd? 4))
(f 1 2 (odd? 3))
(f 1 2 (pow 2 10))
(f 1 2 (pow 2 10))
(f 1 2 (pow 2 9))
(f 1 2 (pow 2 0))
(f 1 2 (pow 2 -3))
(f 1 2 (pow 2 -3))
(f 1 2 (square 5))
(f 1 2 (cube 5))
(f 1 2 (cube 5))
(f 1 2 (>=0 5))
(f 1 2 (<=0 5))
(f 1 2 (>0 5))
(f 1 2 (<0 5))
(f 1 2 (!=0 5))
(f 1 2 (!=0 5))
(f 1 2 (!=1 5))
(f 1 2 (positive? 5))
(f 1 2 (negative? 5))
(f 1 2 (between? 1 10 5))
(f 1 2 (between? 1 10 5))
(f 1 2 (between? 1 10 0))
(f 1 2 (between? 10 1 5))
(f 1 2 (between? 10 1 5))
(f 1 2 (between? 10 1 0))
(f 1 2 (xor T NIL))
(f 1 2 (xor NIL NIL))
(f 1 2 (xor NIL NIL))
(f 1 2 (divmod 7 2))
(f 1 2 (divmod 7 2))
(f 1 2 (avg {1 2 3}))
(f 1 2 (avg {1 2 3}))
(f 1 2 (?? 1))
(f 1 2 (?? NIL))
