(f 1 2 (case 3 {1 2} {3 (* 2 2)}))
; a dependency redefined (mod calls floor), and put back
(def {floor0} floor)
(fun {floor a} {trunc a})
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(def {floor} floor0)
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (floor -7/2))
(f 1 2 (floor -7/2))
; a built-in the code calls, redefined and put back
(def {minus} -)
(def {-} +)
(f 1 2 (mod 7 2))
(print (mod 7 2) (round -5/2))
(def {-} minus)
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (round -5/2))
(f 1 2 (round -5/2))
; names the code's calls start with made local somewhere: their calls' plans go
(let {{floor 1}} 0)
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (floor -7/2))
(f 1 2 (div 7 2))
(let {{- 1} {zero? 1} {=0 1} {>= 1} {not 1}} 0)
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (even? 4))
(f 1 2 (even? 4))
(f 1 2 (>=0 4))
(f 1 2 (!=0 4))
(f 1 2 (!=0 4))
