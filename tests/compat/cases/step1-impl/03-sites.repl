(f 1 2 (xor T NIL))
(f 1 2 (starts-with? "abc" "a"))
(f 1 2 (starts-with? "abc" "a"))
(f 1 2 (ends-with? "abc" "abcd"))
(f 1 2 (ends-with? "abc" "abcd"))
(f 1 2 (round -5/2))
(f 1 2 (round 5/2))
(let {{mod 1} {eq 1} {if 1} {cons 1}} 0)
(f 1 2 (mod 7 2))
(f 1 2 (mod 7 2))
(f 1 2 (zip {1 2} {3 4}))
(f 1 2 (zip {1 2} {3 4}))
(f 1 2 (remove-all 1 {1 2 1}))
(f 1 2 (remove-all 1 {1 2 1}))
(f 1 2 (case 3 {1 2} {3 4}))
(f 1 2 (case 3 {1 2} {3 4}))
