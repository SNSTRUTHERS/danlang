; 05-cond-case: cond and case run their clauses' tests and values where the clauses were written, in order, each
; once: side effects, errors, clause shapes (one item, three, not a list, no scope), tail calls, clauses that unpack
; evaluates again (no scope, names), and tests that redefine what cond's own code calls
(def {log} {})
(fun {note x r} {do (def {log} (join log (list x))) r})
(print (cond {(note 1 NIL) (note :v1 1)} {(note 2 T) (note :v2 2)} {(note 3 T) (note :v3 3)}) log)
(def {log} {})
(print (case 2 {(note 1 1) (note :v1 :one)} {(note 2 2) (note :v2 :two)} {(note 3 2) :three}) log)
(print (cond {NIL 1} {T 2}) (cond {T 1} {T 2}) (cond {(> 2 1) :yes} {T :no}) (cond {NIL 1} {NIL 2} {:x 3}))
(print (try (cond {NIL 1}) &err) (try (cond) &err) (try (case 3 {1 :one}) &err) (try (case 3) &err))
(print (cond {(error "in test") 1} {T 2}) (cond {NIL 1} {T (error "in value")}) (case (error "x") {1 2}))
(print (case 1 {(error "in key") 2} {1 3}) (case 1 {1 (error "in case value")}))
; shapes: a clause of one item, of three, not a list, empty; from list (a scope, no code), cons (no scope)
(print (try (cond {NIL 1} {T}) &err) (try (cond {T}) &err) (cond {T 1 2}) (cond {NIL 1 2} {T 3 4}))
(print (try (cond 5) &err) (try (cond {NIL 1} 5) &err) (try (cond {}) &err) (try (cond {NIL 1} {}) &err))
(print (cond (list NIL 1) (list T 2)) (cond {NIL 1} (list T 2)) (cond (cons NIL {1}) (cons T {2})) (cond {NIL 1} (cons T {2})))
(print (case 2 (list 1 :a) (list 2 :b)) (case 2 {1 :a} (cons 2 {:b})) (case 2 {1 :a} (list 2 (+ 1 2))))
(print (apply cond {{NIL 1} {T 2}}) (unpack case {2 {1 :a} {2 :b}}) (apply cond (list {NIL 1} {T 2})))
; values: a function's value called; a function name's; tail position; a Q-expression's
(fun {seven} {7})
(print (cond {NIL 1} {T seven}) (cond {seven 1}) (cond {T {1 2}}) (cond {{} 1} {{1} 2}) (case 1 {1 seven}))
(fun {count n} {cond {(zero? n) :done} {T (count (- n 1))}})
(print (count 2000) (try (count 20000) &err))
(fun {loop n acc} {cond {(zero? n) acc} {T (loop (- n 1) (+ acc 1))}})
(print (loop 3000 0))
(fun {cnt n} {case n {0 :zero} {1 (cnt 0)} {2 (cnt 1)}})
(print (cnt 2))
; where the tests run: the scope the clause was written in (its &_, its locals)
(fun {extras} {cond {&_ (len &_)} {T 0}})
(fun {local x} {let {{y (* x 2)}} (cond {(> y 10) :big} {T y})})
(print (extras 1 2 3) (extras) (local 3) (local 30))
(def {here} 5)
(print (cond {NIL 1} {T here}) (case here {5 here}) (case :a {:b 1} {:a (+ here 1)}))
; x and clauses evaluated again by unpack (as cond's code goes from one clause to the next)
(print (try (case (to-sym "zz") {1 2} {3 4}) &err) (try (case (to-sym "f") {1 2} {3 4}) &err))
(print (try (cond {NIL 1} (to-sym "here")) &err) (try (cond {NIL 1} (head {(+ 1 2)})) &err))
(print (case (cons 1 NIL) {{2} :a} {{1} :b}) (case (list 1 2) {{1 2} :yes}) (case 1.0 {1 :int}) (case \a {"a" :s} {\a :c}))
(def {q} (cons NIL (cons 1 NIL)))
(print (try (cond {NIL 0} q {T 2}) &err) (try (cond q) &err))
; tests that redefine what cond's code calls: from then on its code, with what's there now
(def {fst0 head0 unpack0 cond0 eq0} fst head unpack cond eq)
(print (try (cond {(do (def {fst} snd) NIL) 1} {T 2} {:x 3}) &err))
(def {fst} fst0)
(print (try (cond {(do (def {head} tail) T) {a b}} {T 2}) &err))
(def {head} head0)
(print (try (cond {(do (def {unpack} (fn {f l} {:unpacked})) NIL) 1} {T 2}) &err))
(def {unpack} unpack0)
(print (try (cond {(do (fun {cond} {:mine}) NIL) 1} {T 2}) &err))
(def {cond} cond0)
(print (try (case 1 {(do (def {eq} (fn {a b} {T})) 2) :two} {3 :three}) &err))
(def {eq} eq0)
(print (cond {NIL 1} {T 2}) (case 3 {3 :ok}) log)
(print (try (case (to-sym "zz") {1 2}) &err) (try (case (to-sym "f") {1 2}) &err) (try (case (to-sym "zz") {1 2} 5) &err) (case (cons 1 NIL) {{2} :a}))
(print "the last: none of the clauses")
(cond {NIL 1} {(> 1 2) 2})
