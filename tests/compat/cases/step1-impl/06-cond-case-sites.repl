; 06-cond-case-sites: the place an error made right after a cond or case says it was made: where its last clause's
; code left evaluation; and the traces of errors inside clauses
(fun {f a b} {+ a b})
(f 1 2 (cond {NIL 1} {T 2}))
(f 1 2 (cond {NIL 1} {T 2}))
(f 1 2 (cond {NIL 1} {T (+ 1 2)}))
(f 1 2 (cond {NIL 1} {T (+ 1 2)}))
(f 1 2 (cond {(> 1 2) 1} {T (mod 7 2)}))
(f 1 2 (cond {(> 1 2) 1} {T (mod 7 2)}))
(f 1 2 (case 2 {1 :a} {2 :b}))
(f 1 2 (case 2 {1 :a} {2 :b}))
(f 1 2 (case 100000 {1 :a} {100000 :b}))
(f 1 2 (case 2 {1 :a} {(+ 1 1) (len {1 2})}))
(f 1 2 (cond (list NIL 1) (list T 2)))
(f 1 2 (cond {NIL 1} (cons T {2})))
(cond {NIL 1})
(cond {NIL 1} {NIL 2})
(case 5 {1 2})
(cond)
(cond {T})
(cond {NIL 1} {T})
(cond {(+ 1 "a") 2})
(cond {T (+ 1 "a")})
(case 1 {1 (+ 1 "a")})
(cond {NIL 1} 5)
(fun {g x} {cond {(> x 0) (+ x "s")} {T x}})
(g 1)
(g 1)
(fun {h x} {case x {1 (/ x 0)} {2 :two}})
(h 1)
(h 2)
