; flags: -w
; 07-redefine: the library's functions, and what their code calls, redefined (with -w's warnings, which say where
; evaluation was: a def's value can be a library function's call) and put back; partial applications and methods
(def {floor0 trunc0 minus0 mod0} floor trunc - mod)
(print (mod 7 2) (div 7 2) (floor -7/2) (round 5/2))
(fun {floor a} {:myfloor})
(print (try (mod 7 2) &err) (div 7 2) (round 5/2) (try (even? 3) &err))
(def {floor} floor0)
(print (mod 7 2) (div 7 2) (floor -7/2) (round 5/2))
(def {trunc} (fn {x} {+ x 1}))
(print (floor 7/2) (floor 3) (mod 7 2) (ceil 1/2))
(def {trunc} trunc0)
(def {-} +)
(print (mod 7 2) (round -5/2) (pow 2 -2) (ends-with? "abc" "c"))
(def {-} minus0)
(print (mod 7 2) (round -5/2) (pow 2 -2) (ends-with? "abc" "c"))
(def {x} (mod 7 2))
(def {mod} (floor 7/2))
(def {mod} mod0)
(def {cons} 5)
(print (try (divmod 7 2) &err) (try (zip {1} {2}) &err) (try (case 2 {1 2} {2 3}) &err))
(def {cons} (fn {x l} {join (list x) l}))
(print (divmod 7 2) (zip {1} {2}) (case 2 {1 2} {2 3}))
(def {zip} (fn {a b} {:z}))
(print (zip {1} {2}) (len {1}))
; partial applications, methods, functions given to built-ins
(def {m7} (mod 7))
(print (m7 2) (m7 3) ((mod 10) 4) ((pow 2) 10) ((between? 1) 2 3) (try ((case 1) {1 2}) &err))
(print (map (mod 10) {1 2 3 4}) (map even? {1 2 3}) (filter odd? {1 2 3 4 5}) (foldl (fn {a b} {+ a (mod b 3)}) 0 {1 2 3 4}))
(print (sort {5 3 8 1} (fn {a b} {< (mod a 3) (mod b 3)})) (any? even? {1 3 5}) (find (fn {x} {>0 (- x 2)}) {1 2 3}))
(def {h} #({{:m mod} {:f floor} {:r remove-all}}))

(print (h :m 7 2) (h :f 7/2) ((h :m 7) 3) (hash-call h :m 9 4) (h :r 1 {1 2 1}))
(set {mm} mod)
(print mod (mod 7) (eq mm mod) (eq mod %) (eq mod floor) (function? mod) (cmp mod %))
(print (try (mod 1 2 3) &err) (try (floor 1 2) &err) (try (zip {1}) &err) (function? (zip {1})) (try (cond 1 2 3) &err))
