; 08-eval-lists: the lists the library's functions give, evaluated (as code, eval runs a list where it remembers it
; was made): zip's pairs remember their own call's scope (a and b, the lists left there), remove-fst's tail its
; list's, the others none (they're the caller's)
(print (map (fn {p} {eval p}) (zip {len len len} {a a a})) (map (fn {p} {eval p}) (zip {len len} {b b})) (map (fn {p} {eval p}) (zip {fst snd} {a b})))
(print (map (fn {p} {eval (tail p)}) (zip {1 2 3} {a b a})) (eval (head (fst (zip {a} {b})))) (eval (head (tail (fst (zip {a} {b}))))))
(def {pairs} (zip {x y} {1 2}))
(print pairs (try (eval (fst pairs)) &err) (map (fn {p} {try (eval p) &err}) pairs))
(def {a} {:global-a})
(fun {g} {let {{a :let-a}} (zip {a a} {b b})})
(print (map (fn {p} {eval p}) (g)) (eval (join {len} (tail (fst (g))))))
(def {x} 10)
(fun {keep} {remove-fst 1 {1 x}})
(fun {drop2} {remove-fst 2 {1 x 2 x}})
(print (eval (keep)) (try (eval (drop2)) &err) (eval (remove-fst :z {:z (+ 1 2)})) (eval (head (remove-fst 1 {1 (* 2 x)}))))
(fun {scoped} {let {{x 99}} (remove-fst 1 {1 x})})
(print (eval (scoped)) (eval (remove-all 1 {1 x})) (eval (distinct {x x})) (eval (flatten {{x}})) (eval (divmod 7 2)))
(print (eval (minimum {{len {1 2}}})) (eval (?? NIL {+ x 1})) (eval (cond {T {+ x 2}})) (eval (case 1 {1 {+ x 3}})))
(fun {inner} {let {{x 5}} (?? NIL {+ x 1})})
(print (eval (inner)) (eval (maximum (list {+ x 1}))) (eval (fst (zip (list {- x 1}) {0}))))
; the pairs, and the lists left in their scopes, are what they'd be (each list's scope kept too)
(fun {deep} {let {{y 7}} (zip {y y y} (list 4 5 6))})
(print (map (fn {p} {eval p}) (deep)) (map (fn {p} {eval (head p)}) (deep)) (eval (head (tail (fst (deep))))))
