; 09-nums-given: whether a library function's call gave an integer kept in its value a Num, as its danlang code does
; (Op2 does a call of - itself, in the call, only for two integers kept in their values: then it doesn't say where it
; is again, and an error made right after says where its last argument's call was, (+ 70000 1); else (- x (g))).  x
; is a fresh integer each time, given to a function first, then looked at
(fun {f a b} {+ a b})
(fun {g} {+ 70000 1})
(fun {probe} {f 1 2 (- x (g))})
(def {x} 100001)
(probe)
(def {x} 100001)
(mod x 3)
(probe)
(def {x} 100001)
(>=0 x)
(probe)
(def {x} 100001)
(floor x)
(probe)
(def {x} 100001)
(def {x} (floor x))
(probe)
(def {x} 100001)
(def {x} (mod 300005 x))
(probe)
(def {x} 100001)
(def {x} (div 300005 x))
(probe)
(def {x} 100001)
(def {x} (round x))
(probe)
(def {x} -100001)
(def {x} (round x))
(probe)
(def {x} 100001)
(even? x)
(probe)
(def {x} 100001)
(def {x} (pow x 1))
(probe)
(def {x} 100001)
(pow x 2)
(probe)
(def {x} 100001)
(square x)
(probe)
(def {x} 100001)
(def {x} (square 1001))
(probe)
(def {x} 100001)
(!=0 x)
(probe)
(def {x} 100001)
(!=1 x)
(probe)
(def {x} 100001)
(positive? x)
(probe)
(def {x} 100001)
(between? 1 x 5)
(probe)
(def {x} 100001)
(between? 1 200000 x)
(probe)
(def {x} 100001)
(avg (list x x))
(probe)
(def {x} 100001)
(def {x} (avg (list x x)))
(probe)
(def {x} 100001)
(distinct (list x 100001 1 x))
(probe)
(def {x} 100001)
(remove-all x {1 2 3})
(probe)
(def {x} 100001)
(remove-all 5 (list 6 x))
(probe)
(def {x} 100001)
(remove-fst x (list 1 x))
(probe)
(def {x} 100001)
(has-element? (list 1 2) x)
(probe)
(def {x} 100001)
