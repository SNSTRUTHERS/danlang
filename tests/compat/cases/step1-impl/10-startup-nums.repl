; 10-startup-nums: the shared small integers are kept in their values (no Num made for them) till something makes one
; (printing a number does, so nothing here prints one before it's looked at): Op2 does (- v (h)) in the call only for
; two such integers, and then an error made right after says where (h)'s code was ({+ 70000 70001}), else (- v (h))
(fun {f a b} {+ a b})
(fun {h} {+ 70000 70001})
(fun {probe} {f v v (- v (h))})
(def {v} 2)
(probe)
(probe)
(def {v} 1)
(probe)
(def {v} 0)
(probe)
(def {v} -1)
(probe)
(def {v} 3)
(probe)
(def {v} 1023)
(probe)
(def {v} 65535)
(probe)
