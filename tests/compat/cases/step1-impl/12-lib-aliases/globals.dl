; 12-lib-aliases: a library of its own (danlang loads the globals.dl in the folder it runs in before lib/'s; run as
; the program too, it's the program once args is there) whose functions are lib/globals.dl's, but trunc is another
; built-in (abs), and there's no =0 and no -?: floor's code takes abs for its integer part, and even?'s and pow's
; calls are of names bound nowhere (their errors); round, mod, div and divmod call that floor.  Each call is made
; several times over (the same code), and once more after a call of the code with the names it binds made local
(if (defined? args)
  (do
    (print "floor" (map floor {7/2 7/2 7/2 7/2 -7/2 -7/2 -7/2 7 7 7}))
    (print "ceil" (map ceil {7/2 7/2 7/2 7/2 -7/2 -7/2 -7/2}))
    (print "round" (map round {5/2 5/2 5/2 5/2 -5/2 -5/2 -5/2}))
    (print "mod" (map (fn {x} {mod x 3}) {7 7 7 7 -7 -7 -7}) (map (fn {x} {% x 2}) {7/2 7/2 7/2 7/2}))
    (print "div" (map (fn {x} {div x 2}) {7 7 7 7 -7 -7 -7}))
    (print "divmod" (map (fn {x} {divmod x 4}) {9 9 9 9 -9 -9}))
    (print "even?" (map (fn {x} {try (even? x) &err}) {4 4 4 4}))
    (print "odd?" (map odd? {3 3 3 3 4 4}))
    (print "pow" (map (fn {x} {try (pow 2 x) &err}) {3 3 3 3}))
    (print "square" (map square {3 3 3 3}) "cube" (map cube {3 3 3 3})))
  (do
    :(trunc abs)
    :(=1 one?)
    (fun {floor a} {
      let {
        do
          =(tr (trunc a))
          (<=> (cmp a tr) {< (1- tr)} {tr})
      }
    })
    (fun {ceil a} {
      let {
        do
         =(tr (trunc a))
         (<=> (cmp a tr) {> (1+ tr)} {tr})
      }
    })
    (fun {round a} {
      ?((neg? a) (- (floor (- 1/2 a))) (floor (+ a 1/2)))
    })
    (fun {div a b} ?{
      (and (num? a) (num? b))
      (floor (/ a b))
      (error "Cannot perform 'div' on non-numbers")
    })
    (fun {mod a b} ?{
      (and (num? a) (num? b))
      (- a (* b (floor (/ a b))))
      (error "Cannot perform 'mod' on non-numbers")
    })
    :(% mod)
    (fun {divmod a b} ?{
      (and (num? a) (num? b))
      (cons (div a b) (list (mod a b)))
      (error "Cannot perform 'divmod' on non-numbers")
    })
    (fun {odd? n} ?{
      (num? n)
      (=1 (mod n 2))
      (error "Cannot perform 'odd?' on non-number")
    })
    (fun {even? n} ?{
      (num? n)
      (=0 (mod n 2))
      (error "Cannot perform 'even?' on non-number")
    })
    (fun {negative? a} ?{(num? a) (neg? a) (error "Only numbers can be negative")})
    (fun {pow a b} ?{
      (not (eq b (trunc b)))
      (error "'pow' takes a whole number as its power")
      ?((-? b)
        (/ 1 (pow a (- b)))
        ?((zero? b)
          1
          ?((even? b)
            (* (pow a (/ b 2)) (pow a (/ b 2)))
            (* a (pow a (1- b)))
          )
        )
      )
    })
    (fun {square n} {* n n})
    (fun {cube n}   {* n (square n)})))
