; 14-error-runs: the code of flatten, zip, remove-all, remove-fst and distinct given a list with errors in it (as
; hash-put makes one) ends in an error: then the place its code left isn't one kept for the way it went, and a call
; that goes the same way right after (the plans the same) runs its code, and an error made right after that (f given
; 3 arguments) says where that code left evaluation (each test's first lines learn its plans)
(def {h} (hash-create))
(def {m} (cons 5 (hash-put h 1 2)))
(def {e2} (hash-put h 1 2))
(fun {f a b} {+ a b})
(fun {t-flatten x y} {do (try (flatten x)) (f 1 2 (flatten y))})
(t-flatten {5 6} {5 6})
(t-flatten {5 6} {5 6})
(t-flatten m {5 6})
(t-flatten m {5 6})
(t-flatten {{5} 6} {{5} 6})
(t-flatten {{5} 6} {{5} 6})
(t-flatten (list m) {{5} 6})
(fun {t-zip x y} {do (try (zip x {1 2})) (f 1 2 (zip y {1 2}))})
(t-zip {5 6} {5 6})
(t-zip {5 6} {5 6})
(t-zip e2 {5 6})
(t-zip e2 {5 6})
(fun {t-remove-all x y} {do (try (remove-all 9 x)) (f 1 2 (remove-all 9 y))})
(t-remove-all {5 6} {5 6})
(t-remove-all {5 6} {5 6})
(t-remove-all m {5 6})
(t-remove-all m {5 6})
(fun {t-remove-fst x y} {do (try (remove-fst 9 x)) (f 1 2 (remove-fst 9 y))})
(t-remove-fst {5 6} {5 6})
(t-remove-fst {5 6} {5 6})
(t-remove-fst m {5 6})
(t-remove-fst m {5 6})
(fun {t-distinct x y} {do (try (distinct x)) (f 1 2 (distinct y))})
(t-distinct {5 6} {5 6})
(t-distinct {5 6} {5 6})
(t-distinct m {5 6})
(t-distinct m {5 6})
