; 15-names-bound: a name the library's code binds is a local one from the call that binds it on (a call headed by it,
; as a global's name, then takes its general way: an error made right after it says it was made there), and not
; before: distinct of one item binds no hd or tl, nor do remove-all and remove-fst of NIL; ?? of n arguments binds &1
; ... &(n - 1), whichever of them is the first that isn't NIL; remove-all of a list whose items all go binds hd and
; tl.  The probe (NAME v (g)): NAME is +, and while it's no local's name the call does it itself, so the error after
; it (zz is unbound) says where (g)'s code was
(def {hd} +)
(def {tl} +)
(def {&1} +)
(def {&3} +)
(def {&4} +)
(fun {g} {+ 70000 70001})
(fun {probe-hd} {list (hd v (g)) zz})
(fun {probe-tl} {list (tl v (g)) zz})
(fun {probe-1} {list (&1 v (g)) zz})
(fun {probe-3} {list (&3 v (g)) zz})
(fun {probe-4} {list (&4 v (g)) zz})
(def {v} 100003)
(probe-hd)
(def {v} 100003)
(probe-hd)
(def {v} 100003)
(probe-tl)
(def {v} 100003)
(probe-tl)
(def {v} 100003)
(probe-1)
(def {v} 100003)
(probe-1)
(def {v} 100003)
(probe-3)
(def {v} 100003)
(probe-3)
(def {v} 100003)
(probe-4)
(def {v} 100003)
(probe-4)
(map distinct (list {1} {2} {3} {4} {5}))
(def {v} 100003)
(probe-hd)
(map (fn {l} {remove-all 1 l}) (list NIL NIL NIL NIL NIL))
(map (fn {l} {remove-fst 1 l}) (list NIL NIL NIL NIL NIL))
(def {v} 100003)
(probe-tl)
(map ?? {5 5 5 5 5})
(def {v} 100003)
(probe-1)
(each {x (list {5 1} {5 1} {5 1} {5 1} {5 1 2 3})} (print (apply ?? x)))
(def {v} 100003)
(probe-1)
(def {v} 100003)
(probe-3)
(def {v} 100003)
(probe-4)
(each {x (list {NIL 6} {NIL 6} {NIL 6} {NIL 6} {NIL NIL NIL 6 7})} (print (apply ?? x)))
(def {v} 100003)
(probe-4)
(map (fn {l} {remove-all 1 l}) (list NIL NIL NIL NIL {1 1}))
(def {v} 100003)
(probe-hd)
(def {v} 100003)
(probe-tl)
