; 17-distinct-compares: distinct of lists whose items are compared as eq compares them, only as far as it goes into
; them: a function or a hash reached, or not (the items differ before it, or are of other kinds), items that share
; their parts (2^12 ways through one, few of them compared), and items nested deeper than 10000 lists (and not so
; deep); each call several times over (its code's, then its native's), and an error made right after the last
(def {f} (fn {x} {+ x 1}))
(def {g} (fn {x} {- x 1}))
(def {h} #({{:a 1}}))
(def {k} #({{:a 1}}))
(fun {times n l} {map (fn {i} {distinct l}) (range n)})
(print (times 4 (list 1 f 2 f g)))
(print (times 4 (list (list 1 f) (list 2 f) (list 1 f) (list 1 g) (list 2 g))))
(print (times 4 (list (list 1 h) (list 1 k) (list 2 h) h k)))
(print (times 4 (list (list 1 (list 2 f)) (list 2 (list 2 f)) 3 (list 1 (list 2 f)) (list 1 (list 2 g)))))
(print (times 4 (list :a "a" \a {a} f h 1 {1} :a f)))
(def {x} {})
(dotimes {i 12} (set! {x} (list x x)))
(def {x2} {})
(dotimes {i 12} (set! {x2} (list x2 x2)))
(print (map len (times 4 (list x 1 x 2 x2 {x} 1))))
(def {y} {0})
(dotimes {i 12000} (set! {y} (list y)))
(def {y2} {0})
(dotimes {i 12000} (set! {y2} (list y2)))
(def {z} {0})
(dotimes {i 9000} (set! {z} (list z)))
(print (map len (times 4 (list y z y2 1 z))))
(print (map len (times 4 (list z 1 z 2 y))))
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {probe l g} {g 1 2 (distinct l)})
(map (fn {g} {probe (list z 1 z 2 (list 3 f) (list 4 g)) g}) (list f3 f3 f3 f3 f2))
