; 18-deep-compares: the library's functions that compare values (has-element?, remove-all, remove-fst, distinct,
; starts-with? and contains? of lists, between?) given lists nested deeper than 10000 lists, or not so deep, to
; compare; each call several times over (its code's, then its native's, or its code's again when the natives go no
; deeper), and an error made right after the last
(def {y} {0})
(dotimes {i 12000} (set! {y} (list y)))
(def {y2} {0})
(dotimes {i 12000} (set! {y2} (list y2)))
(def {y3} {1})
(dotimes {i 12000} (set! {y3} (list y3)))
(def {z} {0})
(dotimes {i 9000} (set! {z} (list z)))
(def {z2} {0})
(dotimes {i 9000} (set! {z2} (list z2)))
(fun {times n f} {map (fn {i} {f}) (range n)})
(print "has-element?" (times 4 (fn {} {has-element? (list 1 z y) y2})) (times 4 (fn {} {has-element? (list 1 z y3) y2}))
  (times 4 (fn {} {has-element? (list y 1) z2})) (times 4 (fn {} {has-element? (list z) z2})))
(print "remove-all" (times 4 (fn {} {len (remove-all y2 (list y z y3 1 y))})) (times 4 (fn {} {len (remove-all z2 (list z y z))})))
(print "remove-fst" (times 4 (fn {} {len (remove-fst y2 (list z y3 y 1))})) (times 4 (fn {} {len (remove-fst z2 (list y z z))})))
(print "distinct" (times 4 (fn {} {len (distinct (list y z y2 y3 z2 1))})))
(print "starts-with?" (times 4 (fn {} {starts-with? (list y z) y2})) (times 4 (fn {} {starts-with? (list z y3 y) y2}))
  (times 4 (fn {} {starts-with? (list z2 y) z})))
(print "contains?" (times 4 (fn {} {contains? (list z y3 y) y2})) (times 4 (fn {} {contains? (list y3 z2) z})))
(print "between?" (times 4 (fn {} {between? z y y2})) (times 4 (fn {} {between? y y3 y2})) (times 4 (fn {} {between? y3 y y2}))
  (times 4 (fn {} {between? z z2 z})) (times 4 (fn {} {between? z2 y z})))
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {probe g} {g 1 2 (has-element? (list z y) y2)})
(map (fn {g} {probe g}) (list f3 f3 f3 f3 f2))
