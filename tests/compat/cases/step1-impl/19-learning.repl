; 19-learning: the Site an error says it was made at, made right after a library function's call (f2 given 3
; arguments), when the plans change before each call (a global hash given a new value and called), before every
; other one, or not at all; and calls made in the tail position of a library function's code (remove-all's, between?'s)
; while its way is learned: has-element?, contains?, avg (one way each), starts-with? (its way from its scan) ...
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(def {state} #({{:n 0}}))
(fun {churn i} {do (def {state} #({{:n i}})) (state :n)})
(fun {at i every} {if (== 0 (% i every)) (churn i) NIL})
(def {big} (range 300))
(fun {gs n} {join (map (fn {i} {f3}) (range n)) (list f2)})
(fun {run every c} {map (fn {g} {do (at (len &_) every) (g 1 2 (c))}) (gs 6)})
(run 1 (fn {} {has-element? big -1}))
(run 2 (fn {} {has-element? big -1}))
(run 1000 (fn {} {has-element? big -1}))
(run 1 (fn {} {contains? big 5}))
(run 2 (fn {} {contains? "abcdef" "e"}))
(run 1000 (fn {} {contains? big 5}))
(run 1 (fn {} {avg big}))
(run 2 (fn {} {avg {1 2 3 4}}))
(run 1000 (fn {} {avg big}))
(run 1 (fn {} {starts-with? big -1}))
(run 2 (fn {} {starts-with? big -1}))
(run 3 (fn {} {starts-with? big 0}))
(run 1000 (fn {} {starts-with? big -1}))
(run 1000 (fn {} {starts-with? "abcdef" "ab"}))
(run 1000 (fn {} {starts-with? "abcdef" "b"}))
(run 1 (fn {} {starts-with? "abcdef" "cd"}))
(run 1 (fn {} {remove-all 7 {7 7 7 1 2 7}}))
(run 2 (fn {} {remove-all 7 {7 7 7 1 2 7}}))
(run 1000 (fn {} {remove-all 7 {7 7 7 1 2 7}}))
(run 1000 (fn {} {remove-all 7 {7 7 7}}))
(run 1 (fn {} {between? 9 1 5}))
(run 1000 (fn {} {between? 9 1 5}))
(run 1000 (fn {} {between? 9 1 50}))
(run 1000 (fn {} {remove-fst 7 {1 7 2}}))
(run 1 (fn {} {zip {1 2 3} {4 5}}))
(run 1000 (fn {} {zip {1 2 3} {4 5}}))
(run 1000 (fn {} {mod 17 5}))
(run 1 (fn {} {mod 17 5}))
