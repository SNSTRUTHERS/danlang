; 10-clause-scopes: each clause's test and value run in the scope the clause was written in, whichever call of cond
; runs it: a call's scope, a let's, a loop's, a closure's; one clause's code run from many scopes in turn and from
; recursion inside itself (its code compiled once, run in each); a set in a test or a value binding in that scope;
; clauses made in one function and given to cond in another; clauses kept in a variable, run after their scope's
; variables have changed
(fun {sign x} {cond {(< x 0) :neg} {(> x 0) :pos} {T :zero}})
(print (map sign {-2 0 3 -1/2 0.0 1.5}))
(fun {nest n} {cond {(zero? n) {}} {T (cons n (nest (- n 1)))}})
(print (nest 5) (nest 0))
(fun {fact n} {case n {0 1} {1 1} {n (* n (fact (- n 1)))}})
(print (fact 10) (fact 0) (fact 1))
(fun {both n} {cond {(< n 2) n} {T (+ (both (- n 1)) (both (- n 2)))}})
(print (both 15))
(fun {binds x} {do (cond {(do =(seen x) (> x 5)) =(r :big)} {T =(r :small)}) (list seen r)})
(def {seen} :global-seen)
(def {r} :global-r)
(print (binds 9) (binds 2) seen r)
(fun {make-clause tag} {list (fn {x} {eq x tag}) tag})
(fun {test-with c x} {cond {((fst c) x) (list :matched (snd c))} {T :no}})
(def {c1} (make-clause :a))
(print (test-with c1 :a) (test-with c1 :b) (test-with (make-clause :z) :z))
(fun {clauses n} {[{(> n 10) :many} {(> n 1) :some} {T :few}]})
(fun {run-all cs} {cond (fst cs) (snd cs) (thd cs)})
(print (run-all (clauses 20)) (run-all (clauses 5)) (run-all (clauses 0)))
(def {kept} (let {{lim 3}} [{(> v lim) :over} {T :under}]))
(fun {try-kept vv} {do (def {v} vv) (cond (fst kept) (snd kept))})
(print (try-kept 1) (try-kept 4) (try-kept 3) (try-kept 100))
(def {acc} {})
(each {i (range 5)} (def {acc} (cons (cond {(even? i) [:even i]} {T [:odd i]}) acc)))
(print acc)
(dotimes {i 4} (print i (case (mod i 3) {0 :zero} {1 :one} {2 :two})))
(fun {counter} {let {{n 0}} (fn {} {do (set! {n} (+ n 1)) (cond {(> n 2) [:done n]} {T [:not-yet n]})})})
(def {ct} (counter))
(print (ct) (ct) (ct) (ct))
(fun {in-let x} {let {{y (* x x)} {z (+ x 1)}} (case y {4 [:four z]} {9 [:nine z]} {y [:other y z]})})
(print (in-let 2) (in-let 3) (in-let 5))
(fun {shadow cond-test} {cond {cond-test :shadowed-name} {T :not}})
(print (shadow T) (shadow NIL))
(fun {deep-same n} {cond {(zero? n) :bottom} {T (cond {(even? n) (deep-same (- n 1))} {T (deep-same (- n 1))})}})
(print (deep-same 50))
(def {cl} {(> y 0) (list :y-positive y)})
(fun {with-y y} {cond cl {T (list :not y)}})
(def {y} 7)
(print (with-y -5) (with-y 5) (cond cl {T :no}))
