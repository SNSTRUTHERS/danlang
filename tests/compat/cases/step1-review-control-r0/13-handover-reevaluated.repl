; 13-handover-reevaluated: going on to the next clause, cond's code puts the clauses left in code again (unpack), so
; one that isn't its own value is evaluated again, in unpack's call (f the function, l the list): a name (f, l, &_,
; a global, an unbound one), a call (made with head or cons), a list with no scope (cons's, an item of a list); at the
; second clause, the third, the last; for case, its key too.  Each value or error and its trace
(def {here} {T :here-value})
(cond {NIL 1} (to-sym "here"))
(cond {NIL 1} {NIL 2} (to-sym "here"))
(cond {NIL 1} (to-sym "l"))
(cond {NIL 1} (to-sym "f"))
(cond {NIL 1} (to-sym "&_"))
(cond {NIL 1} (to-sym "nowhere"))
(cond {NIL 1} (fst {(list T :made)}))
(cond {NIL 1} {NIL 2} (fst {(list T :made)}) {T 4})
(cond {NIL 1} (fst {(error "evaluated again")}))
(cond {NIL 1} (cons (to-sym "l") {:l-was-true}))
(cond {NIL 1} (cons NIL {2}) (cons (to-sym "f") {:f-true}))
(cond {NIL 1} (fst {{T :item}}))
(cond {NIL 1} (fst {{(print "in unpack's scope") :printed}}))
(cond {(print "first") 1} {NIL 2} (cons T {:third}) {T :fourth})
(case 2 {1 :a} (to-sym "here"))
(case (to-sym "x") {1 :a} {2 :b})
(case (fst {(+ 1 1)}) {1 :a} {2 :b})
(case (fst {(+ 1 1)}) {2 :first-match})
(case (cons 1 NIL) {{2} :a} {{1} :b})
(case (to-sym "l") {1 :a} {{{1 :a} {(to-sym "l") :c}} :b})
(case 5 {1 :a} (cons 5 {:c}))
(case 5 {1 :a} (cons (to-sym "x") {:x-was-5}))
(fun {k x} {case x {1 :one} (cons 2 {:two}) {3 :three}})
(k 1)
(k 2)
(k 3)
(k 4)
(fun {f a b} {+ a b})
(f 1 2 (cond {NIL 1} (cons T {2})))
(f 1 2 (cond {NIL 1} (cons T {(+ 1 2)})))
(f 1 2 (case 2 {1 :a} (cons 2 {(+ 2 2)})))
