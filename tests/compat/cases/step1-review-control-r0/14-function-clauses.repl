; 14-function-clauses: a clause's test or value that's a function is called (with nothing): a lambda of no formals
; (its value), of formals (given nothing, itself), an fexpr, a built-in that takes nothing (called) or needs
; something (itself), a special form, a partial application, a method's hash, a buffer; an error made inside one
; (its trace: the call the clause's item was made into); a value that's a function's name is a tail call, so a loop
; through one runs in no more levels
(fun {none} {:none-called})
(fun {needs x} {x})
(def {fx} (fexpr {} {:fexpr-called}))
(def {bad} (fn {} {error "bad inside"}))
(def {bad2} (fn {} {+ 1 "a"}))
(def {hh} (hash-create))
(cond {none 1})
(cond {NIL 1} {T none})
(cond {needs :needs-is-true})
(cond {NIL 1} {T needs})
(cond {fx :fexpr-was-true})
(cond {NIL 1} {T fx})
(cond {NIL 1} {T list})
(cond {list :list-gave-nil} {T :list-was-nil})
(cond {NIL 1} {T cons})
(cond {NIL 1} {T (cons 1)})
(cond {NIL 1} {T do})
(cond {NIL 1} {T and})
(cond {NIL 1} {T if})
(cond {if 1})
(cond {NIL 1} {T hh})
(cond {hh :hash-true})
(cond {bad 1})
(cond {NIL 1} {T bad})
(cond {NIL 1} {bad2 2})
(cond {NIL 1} {T bad2})
(case :none-called {none :matched-none})
(case 3 {1 :a} {3 bad})
(case 3 {bad 1})
(fun {f a b} {+ a b})
(f 1 2 (cond {NIL 1} {T none}))
(f 1 2 (cond {none 1}))
(f 1 2 (cond {NIL 1} {T list}))
(f 1 2 (cond {NIL 1} {T needs}))
(def {n} 0)
(fun {spin} {do (def {n} (+ n 1)) (cond {(eq n 12000) n} {T spin})})
(spin)
(def {n} 0)
(fun {spin2} {do (def {n} (+ n 1)) (case (eq n 12000) {T n} {NIL spin2})})
(spin2)
(fun {err-at m} {do (def {n} (+ n 1)) (cond {(eq n m) (error "stopped")} {T (err-at m)})})
(def {n} 0)
(err-at 5)
(fun {err-tail} {do (def {n} (+ n 1)) (cond {(eq n 5) (error "stopped in tail")} {T err-tail})})
(def {n} 0)
(err-tail)
