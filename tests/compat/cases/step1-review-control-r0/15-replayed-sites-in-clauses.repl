; 15-replayed-sites-in-clauses: a library function called in a clause's value, from one call of cond (case) run in
; a loop: from its third run the native's value is used, with the Site its code left kept.  The last run gives the
; value to a function of one argument: the error, made before another call starts, says where that was.  The last
; argument the same way as the ones before, or another; integers kept in their values or given a Num (printed)
(fun {two a b} {list a b})
(fun {one a} {list a})
(fun {via f ps} {each {p ps} ((snd p) 1 (cond {NIL 0} {T (f (fst p))}))})
(fun {via2 f ps} {each {p ps} ((snd p) 1 (case 1 {0 0} {1 (f (fst p) 3)}))})
(def {m} 100003)
(def {m2} 100004)
(def {r} 7/2)
(print m m2 r)
(via floor (list [7/2 two] [7/2 two] [9/2 two] [11/2 one]))
(via floor (list [7/2 two] [7/2 two] [9/2 two] [-11/2 one]))
(via floor (list [7 two] [8 two] [9 two] [m one]))
(via floor (list [m two] [m two] [m two] [100005 one]))
(via ceil (list [7/2 two] [7/2 two] [9/2 two] [11/2 one]))
(via round (list [5/2 two] [7/2 two] [9/2 two] [11/2 one]))
(via round (list [-5/2 two] [-7/2 two] [-9/2 two] [-11/2 one]))
(via even? (list [4 two] [6 two] [8 two] [m2 one]))
(via even? (list [m2 two] [m2 two] [m2 two] [10 one]))
(via odd? (list [5 two] [7 two] [9 two] [m one]))
(via cube (list [5 two] [7 two] [9 two] [m one]))
(via square (list [5 two] [7 two] [9 two] [r one]))
(via >0 (list [5 two] [7 two] [9 two] [m one]))
(via !=0 (list [5 two] [7 two] [9 two] [r one]))
(via positive? (list [5 two] [7 two] [9 two] [m one]))
(via2 mod (list [7 two] [8 two] [10 two] [m one]))
(via2 mod (list [m two] [m two] [m two] [11 one]))
(via2 div (list [7 two] [8 two] [10 two] [m one]))
(via2 pow (list [2 two] [2 two] [2 two] [m one]))
(via2 divmod (list [7 two] [8 two] [10 two] [m one]))
(fun {via-b f ps} {each {p ps} ((thd p) 1 (cond {NIL 0} {T (f (fst p) (snd p))}))})
(via-b starts-with? (list ["abc" "a" two] ["abd" "a" two] ["abe" "a" two] ["xyz" "x" one]))
(via-b starts-with? (list ["abc" "b" two] ["abd" "b" two] ["abe" "b" two] ["xyz" "q" one]))
(via-b ends-with? (list ["abc" "c" two] ["abd" "d" two] ["abe" "e" two] ["xyz" "z" one]))
(via-b ends-with? (list ["a" "abc" two] ["a" "abd" two] ["a" "abe" two] ["x" "xyz" one]))
(via-b contains? (list ["abc" "b" two] ["abd" "b" two] ["abe" "b" two] ["xyz" "y" one]))
(via-b xor (list [T NIL two] [T NIL two] [NIL T two] [T NIL one]))
(via-b zip (list [{1 2} {3 4} two] [{1 2} {3 4} two] [{5 6} {7 8} two] [{1 2 3} {4 5 6} one]))
(via-b remove-fst (list [3 {1 3} two] [3 {2 3} two] [3 {4 3} two] [3 {5 3} one]))
(via-b remove-all (list [3 {1 3} two] [3 {2 3} two] [3 {4 3} two] [3 {5 3} one]))
(via-b has-element? (list [{1 3} 3 two] [{2 3} 3 two] [{4 3} 3 two] [{5 3} 3 one]))
(via-b between? (list [1 5 two] [1 5 two] [1 5 two] [1 5 one]))
(via-b ?? (list [NIL 5 two] [NIL 6 two] [NIL 7 two] [NIL 8 one]))
(via flatten (list [{1 {2}} two] [{3 {4}} two] [{5 {6}} two] [{7 {8 {9}}} one]))
(via distinct (list [{1 2 1} two] [{3 4 3} two] [{5 6 5} two] [{7 8 7} one]))
(via minimum (list [{3 1 2} two] [{3 1 2} two] [{6 4 5} two] [{9 7 8} one]))
(via avg (list [{1 2 3} two] [{4 5 6} two] [{7 8 9} two] [{10 11 12} one]))
