; 18-in-loops: cond and case run again and again from one call: in while, each, dotimes, map, filter, foldl, sort (its
; less), any?, all?, find and count, with tests that have side effects; in loops long enough that the library
; functions in their clauses have their natives' values used
(def {i} 0)
(def {log} {})
(while (< i 6) (do (def {log} (cons (cond {(even? i) [:e i]} {(eq (mod i 3) 1) [:m i]} {T [:o i]}) log)) (def {i} (+ i 1))))
(print log)
(def {n} 0)
(each {x (range 10)} (case (mod x 4) {0 (def {n} (+ n 100))} {1 (def {n} (+ n 10))} {2 (def {n} (+ n 1))} {3 NIL}))
(print n)
(dotimes {k 5} (print (cond {(> k 3) "big"} {(> k 1) "mid"} {T "small"}) (case k {0 :zero} {k (pow 2 k)})))
(print (map (fn {x} {case (type-of x) {:number (* x 2)} {:string (+ x "!")} {:atom x}}) {1 "a" :b 2.5}))
(print (filter (fn {x} {cond {(odd? x) T} {(> x 6) T}}) (range 12)))
(print (foldl (fn {acc x} {cond {(eq x 0) acc} {(even? x) (+ acc x)} {T (- acc x)}}) 0 (range 10)))
(print (sort {5 3 8 1 9 2} (fn {a b} {cond {(< a b) T} {T NIL}})))
(print (sort {"pear" "fig" "apple"} (fn {a b} {case (cmp (len a) (len b)) {-1 T} {0 (< a b)} {1 NIL}})))
(print (any? (fn {x} {cond {(> x 4) T} {T NIL}}) (range 6)) (all? (fn {x} {case (mod x 2) {0 T} {1 T}}) (range 6)))
(print (find (fn {x} {cond {(eq (mod x 7) 6) T} {T NIL}}) (range 20)) (count (fn {x} {case (even? x) {T T} {NIL NIL}}) (range 9)))
(fun {fizz k} {cond {(zero? (mod k 15)) "FizzBuzz"} {(zero? (mod k 3)) "Fizz"} {(zero? (mod k 5)) "Buzz"} {T k}})
(print (map fizz (range 1 31)))
(fun {collatz k steps} {cond {(eq k 1) steps} {(even? k) (collatz (div k 2) (+ steps 1))} {T (collatz (+ (* 3 k) 1) (+ steps 1))}})
(print (map (fn {k} {collatz k 0}) (range 1 30)))
(print (minimum (map (fn {k} {collatz k 0}) (range 2 50))) (maximum (map (fn {k} {collatz k 0}) (range 2 50))))
