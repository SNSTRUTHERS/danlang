; 19-names-local-timing: the names cond's, case's and minimum's code binds become a local's (so calls named by them
; take their general way) as their code makes them: case's x at its first call, cond's &3 when it's given three
; clauses, unpack's f when it goes past a clause, minimum's f too.  Probes: (x v (g)), (&3 v (g)) and (f v (g)), Op2's
; fast way (the Site (g)'s code left) while the name is no local's, the general way after
(def {x} +)
(def {&3} +)
(def {f} +)
(fun {g} {+ 70000 70001})
(fun {p a b} {+ a b})
(fun {px} {p v v (x v (g))})
(fun {p3} {p v v (&3 v (g))})
(fun {pf} {p v v (f v (g))})
(def {v} 100003)
(px)
(px)
(p3)
(p3)
(pf)
(pf)
(cond {T 1})
(cond {T 1} {T 2})
(px)
(p3)
(pf)
(case 1 {1 :a})
(px)
(p3)
(pf)
(cond {T 1} {T 2} {T 3})
(p3)
(pf)
(cond {NIL 1} {T 2})
(pf)
