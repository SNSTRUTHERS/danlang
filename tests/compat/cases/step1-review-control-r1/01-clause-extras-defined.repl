; 01-clause-extras-defined: clauses written in a function that takes extra arguments see its &_, &1 ... and
; (defined? &1) says whether its call had them (the clause's scope, not cond's own call): tests and values that use
; them, at the first clause, after a hand-over, for case too; then errors made right after (the probe p takes two)
(fun {p a b} {+ a b})
(fun {firsts} {cond {(defined? &2) (list :two &1 &2)} {(defined? &1) (list :one &1)} {T (list :none &_)}})
(firsts)
(firsts 7)
(firsts 7 8)
(firsts 7 8 9)
(fun {kind} {case (len &_) {0 :zero} {1 (list :one &1)} {2 (list :two &_)} {(len &_) (list :many (last &_))}})
(map (fn {n} {unpack kind (range n)}) {0 1 2 3 5})
(fun {via} {cond {NIL 0} (list (defined? &1) &_) {T :no-extras}})
(via)
(via :x :y)
(fun {deep} {cond {&_ (cond {(defined? &3) &3} {T (len &_)})} {T :empty}})
(list (deep) (deep 1) (deep 1 2) (deep 1 2 3) (deep 1 2 3 4))
(p 1 2 (firsts 1 2))
(p 1 2 (firsts 1 2))
(p 1 2 (kind 1 2 3))
(p 1 2 (kind 1 2 3))
(p 1 2 (via 1))
(p 1 2 (deep 1 2 3))
(fun {ext-test} {cond {(defined? &5) :five} {(even? (len &_)) (mod (len &_) 3)} {T (floor (/ (len &_) 2))}})
(map (fn {n} {unpack ext-test (range n)}) {0 1 2 3 4 5 6 7})
(each {n (range 6)} (if (eq n 5) (p 1 2 (unpack ext-test (range n))) (unpack ext-test (range n))))
(each {n (range 6)} (if (eq n 5) (p 1 2 (unpack ext-test (range (+ n 1)))) (unpack ext-test (range (+ n 1)))))
