; 05-nested-handovers: cond and case inside one another's tests and values, the inner ones going over to their code
; part way (a clause unpack evaluates again: a name, a call, a list with no scope, which then runs in unpack's call,
; where the function's own names aren't; a clause that isn't one), the outer ones not, and the other way round; each
; value, and the place an error made right after says it was
(fun {p a b} {+ a b})
(def {here} {T :here})
(cond {(case 1 {2 NIL} (cons 1 {T})) (cond {NIL 0} (to-sym "here"))} {T :outer})
(cond {(cond {NIL 0} (fst {{T 1}})) :inner-item} {T :no})
(case (cond {NIL 0} (cons T {3})) {(case 3 {1 0} (cons 3 {3})) (cond {NIL 1} 5)} {3 :three})
(case (cond {NIL 0} (cons T {3})) {(case 3 {1 0} (cons 3 {3})) :matched} {3 :three})
(cond {NIL 0} (cons (cond {NIL 1} {T T}) {(case 2 {1 :a} (cons 2 {(cond {NIL 0} (fst {(list T :deep)}))}))}))
(fun {f x} {cond {(case x {1 T} (list 2 T) {x NIL}) (cond {NIL 0} (list T (list :inner x)))} (list T (case x {3 :three} {x (list :other x)}))})
(map f {1 2 3 4})
(p 1 2 (f 1))
(p 1 2 (f 2))
(p 1 2 (f 3))
(p 1 2 (f 4))
(each {x {1 2 3 4 1 2 3 4}} (f x))
(each {x {1 2 3 4 1 2 3}} (if (eq x 3) (p 1 2 (f x)) (f x)))
(fun {fx x} {cond {(case x {1 T} (cons 2 {T}) {x NIL}) (cond {NIL 0} (cons T {(list :inner x)}))} (cons T {(case x {3 :three} {x (list :other x)})})})
(map (fn {x} {try (fx x) &err}) {1 2 3 4})
(p 1 2 (fx 1))
(p 1 2 (fx 3))
(fun {g x} {case x {0 (cond {(even? x) (case (mod x 3) {0 :zero} (list 1 :one))})} (list x (cond (list (odd? x) (floor (/ x 2))) {T (mod x 4)}))})
(map g {0 1 2 3 4 5})
(each {x {0 1 2 3 4 5 1 3}} (if (eq x 3) (p 1 2 (g x)) (g x)))
(each {x {0 1 2 3 4 5 1 4}} (if (eq x 4) (p 1 2 (g x)) (g x)))
(cond {NIL 0} (cons (case 1 {1 (cond {NIL 2} 5)}) {:never}))
(case 1 {2 0} (cons (cond {NIL 0} (to-sym "nowhere")) {:never}))
