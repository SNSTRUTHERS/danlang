; 06-guard-nested-tests: a test that runs another cond (case), whose own test redefines what the outer one's code
; calls (fst, eval, unpack, tail, head, eq, cond, case): the inner goes on with what's there at once, the outer from
; that test on; restored by a later test of either, or not until afterwards; each value or error, and its trace
(fun {p a b} {+ a b})
(def {fst0 eval0 unpack0 tail0 head0 eq0 cond0 case0 cons0} fst eval unpack tail head eq cond case cons)
(cond {(cond {(do (def {fst} snd) NIL) 1} {T NIL}) :a} {T :b} {T :c})
(def {fst} fst0)
(cond {(cond {(do (def {fst} snd) NIL) 1} {(do (def {fst} fst0) T) NIL}) :a} {T :b} {T :c})
(cond {(case 1 {(do (def {eval} (fn {x} {list :my-eval x})) 1) NIL}) :a} {T :b})
(def {eval} eval0)
(cond {(case 1 {(do (def {eval} (fn {x} {list :my-eval x})) 1) T}) :a} {T :b})
(def {eval} eval0)
(case 2 {(cond {(do (def {unpack} (fn {f l} {list :my-unpack (len l)})) T) 1}) :one} {2 :two} {3 :three})
(def {unpack} unpack0)
(case 2 {(cond {(do (def {eq} (fn {a b} {T})) T) 1}) :one} {2 :two})
(def {eq} eq0)
(case 2 {(cond {(do (def {eq} (fn {a b} {NIL})) T) 2}) :two} {2 :two-again} {3 :three})
(def {eq} eq0)
(cond {(cond {(do (def {tail} (fn {l} {list {T :from-tail}})) NIL) 1} {T NIL}) :a} {NIL :b} {T :c})
(def {tail} tail0)
(cond {(cond {(do (def {head} (fn {l} {list NIL})) T) NIL}) :a} {T :b})
(def {head} head0)
(cond {(cond {(do (fun {cond} {list :new-cond (len &_)}) NIL) 1} {T NIL}) :a} {T :b} {T :c})
(def {cond} cond0)
(case 1 {(case 1 {(do (fun {case} {list :new-case &_}) 1) 2}) :a} {1 :b} {3 :c})
(def {case} case0)
(case 1 {(cond {(do (def {cons} (fn {x l} {list :my-cons x})) T) 2}) :a} {1 :b})
(def {cons} cons0)
(fun {f x} {cond {(cond {(do (if (eq x 2) (def {fst} snd) NIL) NIL) 0} {T NIL}) :a} {(eq x 1) (list :one (mod 7 2))} {T (list :other (floor 7/2))}})
(map (fn {x} {do (def {fst} fst0) (f x)}) {1 2 3 1 3})
(def {fst} fst0)
(each {x {1 3 1 3 1 3 1}} (if (eq x 1) (f x) (f x)))
(p 1 2 (f 1))
(p 1 2 (f 3))
(p 1 2 (do (def {fst} fst0) (f 2)))
(def {fst} fst0)
(cond {NIL 1} {T 2})
(case 2 {1 :a} {2 :b})
