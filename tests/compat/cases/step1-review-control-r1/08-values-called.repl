; 08-values-called: a clause's value that's a call of an fexpr (its arguments as written, remembering the clause's
; scope), of a hash (a key's value, a method given &0, a key that isn't there), of a buffer (a byte, an index past
; its end), of a function given too many arguments, in tail position: each value, the errors they make and their
; traces, and the place an error made right after says it was
(fun {p a b} {+ a b})
(def {quoted} (fexpr {x} {list :got x (eval x)}))
(def {h} (hash-create))
(hash-put h (list :k 41) (list :m (fn {n} {list :method n (len (hash-keys &0))})) (list :fl floor))
(def {b} (buffer "AB"))
(fun {two x y} {list x y})
(fun {pick n} {cond {(eq n 0) (quoted (+ n 1))} {(eq n 1) (h :k)} {(eq n 2) (h :m n)} {(eq n 3) (b 1)} {(eq n 4) (h :fl 7/2)} {(eq n 5) (h :nope)} {(eq n 6) (b 9)} {(eq n 7) (two n n n)} {T (h :k 1)}})
(map (fn {n} {try (pick n) (+ "E:" &err)}) (range 9))
(pick 5)
(pick 6)
(pick 7)
(pick 8)
(p 1 2 (pick 0))
(p 1 2 (pick 1))
(p 1 2 (pick 2))
(p 1 2 (pick 3))
(p 1 2 (pick 4))
(each {n {4 4 4 4}} (if (eq n 9) 0 (pick n)))
(p 1 2 (pick 4))
(fun {kpick n} {case n {0 (quoted n)} {1 (h :m (floor 9/2))} {2 (b (mod 7 2))} {n (h (if (even? n) :k :nope))}})
(map (fn {n} {try (kpick n) (+ "E:" &err)}) (range 5))
(kpick 3)
(p 1 2 (kpick 2))
(each {n {0 1 2 0 1 2}} (kpick n))
(each {n {2 2 2 2 4}} (if (eq n 4) (p 1 2 (kpick n)) (kpick n)))
(each {n {1 1 1 1 3}} (if (eq n 3) (kpick n) (kpick n)))
