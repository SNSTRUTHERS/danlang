; 09-errors-right-after: errors made right after cond or case gives its value, before another call starts, each say
; the place the last call left: an unbound name later in the same call, a function given too many, a call whose first
; item isn't a function, set! of an unbound name, a buffer's index; after a value that's a library call (its code's
; place, or the place its native keeps), a constant, a hand-over, a function's value, a no match caught
(fun {p a b} {+ a b})
(def {bf} (buffer "AB"))
(fun {v1 x} {cond {(> x 5) (mod x 4)} {(> x 2) (floor (/ x 2))} {T (case x {0 :zero} {1 (even? x)} {x (between? 0 9 x)})}})
(fun {v2 x} {case (mod x 3) {0 (cond (list (odd? x) (remove-all 1 (list 1 x))) {T (zip (list x) {1})})} {1 (?? NIL (div x 2))} {2 (square x)}})
(fun {v3 x} {cond {NIL 0} (cons (zero? (mod x 2)) {(starts-with? "abc" "a")}) {T (ends-with? "abc" "bc")}})
(map v1 (range 9))
(map v2 (range 9))
(map v3 (range 4))
(fun {probes f x} {list (try (list (f x) unbound-a) &err) (try (p 1 2 (f x)) &err) (try ((f x) 1) &err) (try (set! {unbound-b} (f x)) &err) (try (bf (f x)) &err)})
(map (fn {x} {probes v1 x}) (range 9))
(each {x (range 9)} (v1 x))
(each {x (range 9)} (v2 x))
(each {x (range 4)} (v3 x))
(list (v1 7) unbound-a)
(p 1 2 (v1 7))
((v1 4) 1)
(set! {unbound-b} (v1 1))
(bf (v1 0))
(list (v2 3) unbound-a)
(p 1 2 (v2 4))
((v2 5) 1)
(set! {unbound-b} (v2 6))
(bf (v2 7))
(list (v3 0) unbound-a)
(p 1 2 (v3 1))
((v3 2) 1)
(each {x (list 7 7 7 7 7 4 4 4 4 4 1 1 1 1 1)} (if (eq x 99) 0 (v1 x)))
(each {x {1 2 3 4 7}} (if (eq x 7) (list (v1 x) unbound-a) (v1 x)))
(each {x {1 2 3 4 4}} (if (eq x 4) (p 1 2 (v1 x)) (v1 x)))
(each {x {3 4 5 3 4 5 1}} (if (eq x 1) ((v1 x) 1) (v1 x)))
(each {x {3 4 5 6 7 8 3}} (if (eq x 3) (set! {unbound-b} (v2 x)) (v2 x)))
(each {x {3 4 5 6 7 8 4}} (if (eq x 4) (p 1 2 (v2 x)) (v2 x)))
(each {x {0 1 2 3 0 1 2 3 1}} (if (eq x 1) (bf (v3 x)) (v3 x)))
(p 1 2 (try (cond {NIL 1}) (mod 7 2)))
(p 1 2 (try (case 1 {2 3}) (cond {T (floor 9/2)})))
