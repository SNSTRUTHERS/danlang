; 11-code-as-values: values that are code (an S-expression or a symbol taken out of a quoted list, read's) as a
; clause's test or value (run as code where the clause was made: called), as case's key (the same) and as case's x
; (compared as it is at first; from the first clause that doesn't match, evaluated again by unpack, in its call); the
; empty S-expression (NIL as code, but not equal to NIL); each value or error, its trace, and errors made right after
(fun {p a b} {+ a b})
(def {sx} (fst {(+ 1 2)}))
(def {sy} (fst {(print "ran")}))
(def {nm} (to-sym "here"))
(def {here} 42)
(def {empty} (fst {()}))
(list (type-of sx) (type-of empty) (eq empty NIL) (eq empty ()))
(cond (list sx :sx-true))
(cond (list NIL 0) (list sy :printed))
(cond (list nm (list :name-test nm)))
(cond (list T sx))
(cond (list T nm))
(cond (list T sy))
(cond (list empty :empty-test) {T :empty-was-nil})
(cond (list T empty))
(case 3 (list sx :three))
(case 42 (list 1 0) (list nm :here))
(case sx (list 3 :no) {T :default})
(case sx {(fst {(+ 1 2)}) :same-code} {T :default})
(case sx (list 0 :no) {3 :evaluated-again})
(case nm (list 0 :no) {42 :name-again})
(case empty {NIL :nil-key} {empty :never})
(case empty (list 1 :no) {NIL :was-empty-sexpr})
(case (fst {(print "x again")}) {1 :a} {2 :b})
(fun {cx x} {case x (list 1 :one) (list (fst {(+ 1 1)}) :two) {3 :three}})
(map cx (list 1 2 3 sx))
(p 1 2 (cx 2))
(p 1 2 (cx 3))
(p 1 2 (cx sx))
(each {x (list 1 2 3 1 2 3 sx)} (if (eq x sx) (p 1 2 (cx x)) (cx x)))
(fun {cs n} {cond (list (eq n 0) sx) (list (eq n 1) nm) (list (eq n 2) (fst {(mod 7 2)})) {T (fst {(floor 7/2)})}})
(map cs (range 4))
(each {n {0 1 2 3 0 1 2 3 2}} (if (eq n 2) (if (eq n 9) 0 (cs n)) (cs n)))
(p 1 2 (cs 2))
(p 1 2 (cs 3))
(p 1 2 (cs 1))
