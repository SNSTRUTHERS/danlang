; 14-tests-redefine-natived: a clause's test that redefines a library function its value calls, or one that calls (a
; native's guard: floor for mod, mod for even?, trunc for floor, remove-all for distinct, eq for remove-fst, zip
; itself), and restores it in a later test or after: the value is what the code gives with what's there then; in a
; loop, so the native's value would be used the calls before; the places errors made right after say they were
(fun {p a b} {+ a b})
(def {floor0 mod0 trunc0 remove-all0 eq0 zip0 even?0} floor mod trunc remove-all eq zip even?)
(fun {t1 x} {cond {(do (if (eq x 3) (def {floor} (fn {a} {list :my-floor a})) NIL) NIL) 0} {T (mod 7 x)}})
(map t1 {2 2 2 3 2})
(def {floor} floor0)
(each {x {2 2 2 2}} (t1 x))
(p 1 2 (t1 2))
(p 1 2 (t1 3))
(def {floor} floor0)
(p 1 2 (t1 2))
(fun {t2 x} {case x {(do (if (eq x 5) (def {mod} (fn {a b} {:my-mod})) NIL) 0) :zero} {x (list (even? x) (odd? x))}})
(map t2 {1 2 5 4})
(def {mod} mod0)
(map t2 {1 2 4})
(fun {t3 x} {cond {(do (if (eq x 0) (def {trunc} (fn {a} {truncate (* 2 a)})) (def {trunc} trunc0)) NIL) 0} {T (list (floor (/ 7 2)) (ceil (/ 7 2)) (round 7/2))}})
(map t3 {1 0 1 0 1})
(def {trunc} trunc0)
(fun {t4 x} {cond {(do (if (eq x 0) (def {remove-all} (fn {f l} {list :mine})) (def {remove-all} remove-all0)) NIL) 0} {T (distinct (list x 1 x 2))}})
(map t4 {1 0 2 0 3})
(def {remove-all} remove-all0)
(fun {t5 x} {cond {(do (if (eq x 0) (def {eq} (fn {a b} {T})) (def {eq} eq0)) NIL) 0} {T (remove-fst 3 (list 1 2 3 x))}})
(map t5 {1 0 2 0})
(def {eq} eq0)
(fun {t6 x} {cond {(do (if (eq x 0) (fun {zip a b} {list :my-zip}) (def {zip} zip0)) NIL) 0} {T (zip0 (list x 1 2) {4 5 6})}})
(map t6 {1 0 2 0 3})
(def {zip} zip0)
(fun {t7 x} {case x {(do (if (eq x 9) (def {even?} (fn {n} {:my-even})) NIL) 0) 0} {x (list (pow 2 x) (even? x))}})
(map t7 {3 4 9})
(def {even?} even?0)
(map t7 {3 4})
(each {x {2 2 2 3}} (if (eq x 3) (p 1 2 (t1 x)) (t1 x)))
(def {floor} floor0)
(each {x {2 2 2 2 2}} (if (eq x 9) 0 (t1 x)))
(p 1 2 (t1 2))
(each {x {4 4 4 4}} (t3 1))
(p 1 2 (t3 1))
(p 1 2 (t3 0))
(def {trunc} trunc0)
(p 1 2 (t3 1))
