; 16-calls-made-at-run-time: cond and case called by code made as the program runs (eval of a list with the function
; in it, of read's code, of cons's), through another name (def'd, a let's, a function's formal, a hash's value), as
; an fexpr gives them (a copy that remembers the caller's scope): the clauses' scopes as each way gives them; the
; values, and the places errors made right after say they were
(fun {p a b} {+ a b})
(def {k} 5)
(eval (list cond (list (> k 1) :list-made) (list T :no)))
(eval (cons cond (list {(> k 9) :a} {T :b})))
(eval (cons cond {{(> k 9) :a} {T :scope-less}}))
(eval (fst (read "(cond {(> k 1) :read} {T :no})")))
(eval (fst (read "(case k {1 :one} {5 :five})")))
(def {my-cond my-case} cond case)
(my-cond {NIL 0} {(> k 1) (mod k 3)})
(my-case k {1 :a} {5 (floor (/ k 2))})
(let {{c cond}} (c {NIL 0} {T :let-bound}))
((fn {c x} {c {(eq x 1) :one} {T :other}}) cond 1)
(def {tbl} (hash-create))
(hash-put tbl (list :c cond) (list :k case))
(tbl :c {NIL 1} {T :from-hash})
(tbl :k 5 {5 :hash-case})
(def {fx} (fexpr {f} {do f}))
(def {cond-copy} (eval (list fx cond)))
(list (eq cond-copy cond) (cond-copy {NIL 0} {T :copy}))
(cond-copy {NIL 0} 5)
(cond-copy {NIL 0} (cons T {:copy-handed}))
(eval (list case 5 {5 :evaled-case}))
(fun {via-unpack l} {unpack cond l})
(via-unpack (list {NIL 1} {T :unpacked}))
(via-unpack {{NIL 1} {T :unpacked-no-scope}})
(p 1 2 (eval (list cond (list (> k 1) (mod k 3)))))
(p 1 2 (eval (fst (read "(cond {(> k 1) (floor (/ k 2))} {T :no})"))))
(p 1 2 (my-case k {1 :a} {5 (floor (/ k 2))}))
(p 1 2 (tbl :c {NIL 1} {T (mod 9 4)}))
(p 1 2 (cond-copy {NIL 0} {T (mod 9 4)}))
(p 1 2 (via-unpack (list {NIL 1} {T (div 9 4)})))
(each {i (range 4)} (if (eq i 3) (p 1 2 (eval (list cond (list (> i 1) (mod i 3))))) (eval (list cond (list (> i 1) (mod i 3)) {T (mod 7 3)}))))
(each {i (range 4)} (if (eq i 3) (p 1 2 (cond-copy {(> i 1) (mod i 3)})) (cond-copy {(> i 1) (mod i 3)} {T (mod 7 3)})))
