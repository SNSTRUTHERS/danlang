; 17-minimum-maximum-kinds: minimum and maximum of lists of every kind of value (numbers of each kind, characters,
; strings, atoms, lists with and without a scope, T, NIL, functions, hashes, mixed kinds: the order cmp has), of items
; unpack evaluates again (a symbol, a call), of one item, none, not a list; remove-min and remove-max; the value, and
; the place an error made right after says it was (the list made for min or max, or wherever the code got to)
(fun {p a b} {+ a b})
(def {h1 h2} (hash-create) (hash-create))
(hash-put h1 (list :a 1))
(fun {f1} {1})
(fun {f2} {2})
(minimum (list 3 1/2 0.25 -7 100003 12345678901234567890))
(maximum (list 3 1/2 0.25 -7 100003 12345678901234567890))
(list (minimum (list \b \a "a" :a)) (maximum (list \b \a "a" :a)) (minimum (list "b" "ab" "")) (maximum (list :b :a)))
(list (minimum (list {2} {1 2} {1})) (maximum (list {2} {1 2} {1})) (minimum (list T NIL 1)) (maximum (list T NIL 1)))
(list (minimum (list f2 f1)) (maximum (list f1 f2)) (minimum (list h1 h2)) (maximum (list h2 h1)) (minimum (list cons h1 1)) (maximum (list cons h1 1 f1)))
(list (minimum (list 2 2.0 4/2)) (maximum (list 2 2.0 4/2)) (minimum (list (complex 1 2) (complex 1 1))))
(minimum (list (to-sym "f1") 5))
(minimum (list (fst {(+ 1 2)}) 5))
(minimum (list (cons 1 NIL) {0}))
(minimum (list 7))
(minimum NIL)
(minimum 5)
(maximum "abc")
(list (remove-min (list 3 1 2 1)) (remove-max (list 3 1 3 2)) (remove-min (list "b" "a")))
(p 1 2 (minimum (list 3 1 2)))
(p 1 2 (maximum (list "b" "a" "c")))
(p 1 2 (minimum (list 7)))
(p 1 2 (minimum (list (to-sym "f1") 5)))
(p 1 2 (remove-min (list 3 1 2)))
(fun {lo n} {cond {(> n 2) (minimum (list n (- n 1) (floor (/ n 2))))} {T (maximum (list n 2 (mod n 3)))}})
(map lo (range 6))
(each {n (range 6)} (lo n))
(each {n {3 3 3 3 4}} (if (eq n 4) (p 1 2 (lo n)) (lo n)))
(each {n {1 1 1 1 2}} (if (eq n 2) (p 1 2 (lo n)) (lo n)))
