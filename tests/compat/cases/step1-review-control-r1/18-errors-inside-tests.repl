; 18-errors-inside-tests: errors made inside a clause's test or case's key right after a library call there, before
; another call starts (a buffer's index past its end, a hash's value given an argument when it isn't a method): the
; test's error is cond's (case's) value, its trace the place that call left; from the first run of the code, then as
; the natives' values are used (a loop, the error only the last time round); in the first clause, a later one after
; a hand-over, and in case's key
(fun {p a b} {+ a b})
(def {bf} (buffer "AB"))
(def {h} (hash-create))
(hash-put h (list 0 (fn {v} {list :m0 v})) (list 1 (fn {v} {list :m1 v})))
(fun {t1 x} {cond {(bf (mod x 3)) :first} {T :never}})
(fun {t2 x} {cond {NIL 0} {(eq x 99) 1} {(h (floor (/ x 2)) x) :second} {T :never}})
(fun {t3 x} {case x {(bf (div x 3)) :key-byte} {x :x}})
(fun {t4 x} {case (between? 0 9 x) {(h (round (/ x 4)) x) :key} {T :t} {NIL :nil}})
(fun {t5 x} {cond {NIL 0} (cons NIL {1}) {(bf (ceil (/ x 4))) :after-handover}})
(fun {t6 x} {cond {(h (mod x 3) x) :hashed} {T :never}})
(map (fn {x} {try (t1 x) &err}) {0 1 2 3})
(map (fn {x} {try (t2 x) &err}) {1 2 3 4})
(map (fn {x} {try (t3 x) &err}) {0 3 6})
(map (fn {x} {try (t4 x) &err}) {1 2 9})
(map (fn {x} {try (t5 x) &err}) {1 9})
(map (fn {x} {try (t6 x) &err}) {0 1 2})
(t1 2)
(t2 4)
(t3 6)
(t4 9)
(t5 9)
(t6 2)
(each {x {0 1 3 4 0 1 3 4 2}} (t1 x))
(each {x {0 1 2 3 0 1 2 3 4}} (t2 x))
(each {x {0 1 2 3 4 5 0 1 2 6}} (t3 x))
(each {x {0 1 2 3 4 1 2 3 4 9}} (t4 x))
(each {x {1 2 3 4 1 2 3 4 9}} (t5 x))
(each {x {0 1 3 4 6 7 0 1 2}} (t6 x))
(each {x {0 1 0 1 0 1 0 1 -1}} (t1 x))
(each {x {-1 -4 -1 -4 -1 -7 2}} (t6 x))
