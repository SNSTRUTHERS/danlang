; 19-in-special-forms: cond and case as the test and body of while, inside and, or, if, let's bindings and body, do
; (not last, and last: tail position), try's expression and handler, each and dotimes bodies; their clauses with the
; library's functions, so the natives' values are used as the loops run; the values, the order things print in, and
; at the end an error made right after one, its trace
(fun {p a b} {+ a b})
(def {i} 0)
(def {seen} {})
(while (cond {(< i 8) (odd? (+ i 1 (mod i 2)))} {T NIL}) (do (def {seen} (cons (case (mod i 3) {0 (floor (/ i 2))} {1 (ceil (/ i 3))} {2 (round (/ i 4))}) seen)) (def {i} (+ i 1))))
(print i (reverse seen))
(fun {w n} {do (set k 0) (set acc {}) (while (case (> k n) {T NIL} {NIL T}) (do (set acc (cons (cond {(odd? k) (pow 2 k)} {T (square k)}) acc)) (set k (+ k 1)))) (reverse acc)})
(print (w 6) (w 0))
(print (map (fn {x} {and (cond {(>0 x) x} {T NIL}) (case (mod x 2) {0 :even} {1 :odd})}) {-1 1 2}))
(print (map (fn {x} {or (cond {(<0 x) :neg} {T NIL}) (case x {0 :zero} {x (divmod x 3)})}) {-5 0 7}))
(print (map (fn {x} {if (cond {(even? x) T} {T NIL}) (case x {2 :two} {x (div x 2)}) (cond {(> x 4) (mod x 4)} {T x})}) (range 8)))
(print (map (fn {x} {let {{a (cond {(odd? x) (* x 3)} {T x})} {b (case a {3 :three} {a (floor (/ a 2))})}} (list a b (cond {(> a 5) :big} {T :small}))}) (range 5)))
(print (map (fn {x} {do (cond {(even? x) (print "e" x)} {T NIL}) (case x {1 (print "one")} {x NIL}) (cond {T (mod x 3)})}) (range 4)))
(print (map (fn {x} {try (cond {(> x 1) (case x {2 (error "two")} {x (mod x 2)})} {T (error "small")}) (cond {(eq &err "two") :caught-two} {T (case &err {"small" :caught-small})})}) (range 4)))
(each {x (range 3)} (print (cond {(zero? x) (between? 1 3 2)} {T (contains? "abc" (to-str x))})))
(dotimes {x 3} (print (case x {0 (starts-with? "abc" "a")} {1 (ends-with? "abc" "c")} {2 (has-element? {1 2} 2)})))
(print "the last: an error made right after one, in a while loop's body, not caught")
(def {i} 0)
(while (< i 5) (do (if (eq i 4) (p 1 2 (cond {(odd? i) (mod i 3)} {T (floor (/ i 3))})) (cond {(odd? i) (mod i 3)} {T (floor (/ i 3))})) (def {i} (+ i 1))))
