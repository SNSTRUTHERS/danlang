; 04-cond-as-a-function-value: cond, case, minimum and maximum given as the function to the built-ins that apply one
; (sort's less, with two clauses from the list each time; foldl's, with the accumulator as case's key; filter's;
; map's), to try as its handler (given the message), to each, and kept in a hash as a method and in a variable
; under another name; their clauses the list's items (with a scope: list's) or not (a quoted list's items); each
; value or error, and at the end an error made right after one, not caught, its trace
(fun {p a b} {+ a b})
(def {cls} (list (list T :a) (list NIL :b) (list (> 2 1) :c) (list (< 2 1) :d)))
(print (sort cls cond))
(print (try (sort {{T 1} {NIL 2}} cond) &err))
(print (foldl case 2 (list (list 2 3) (list 3 :three))) (try (foldl case 0 (list (list 1 2))) &err))
(print (filter cond (list (list T T) (list T NIL) (list NIL T))) (map cond (list (list T (mod 9 4)) (list (even? 3) 1))))
(print (try (map cond (list (list T 1) (list NIL 2))) &err) (try (filter case (list 1 2)) &err))
(print (try (error "boom") cond) (try (error "boom2") case) (try (error "boom3") minimum))
(def {log} {})
(each cond (list (list T (do (def {log} (cons :e1 log)) 1)) (list (> 1 0) 2)))
(print log)
(def {choose} cond)
(def {pick-key} case)
(print (choose (list NIL 1) (list T (floor 7/2))) (pick-key 3 (list 3 (mod 7 4))) (eq choose cond))
(def {obj} (hash-create))
(hash-put obj (list :sel cond) (list :key case) (list :lo minimum) (list :hi maximum))
(print (obj :sel (list NIL 0) (list T :method)) (obj :key 5 (list 5 :five)) (obj :lo {4 2 8}) (obj :hi (list "b" "c" "a")))
(print (map minimum (list {3 1} {7})) (map maximum (list (list 1/2 0.25) {"x"})) (sort (list {2 1} {1 3}) (fn {a b} {< (minimum a) (minimum b)})))
(def {cls2} (list (list T :a) (list (> 2 1) (mod 7 2)) (list 1 :d)))
(print (sort cls2 cond) (sort cls2 case))
(each {i (range 4)} (sort cls2 cond))
(print "the last: an error made right after sort with cond, not caught")
(p 1 2 (sort cls2 cond))
