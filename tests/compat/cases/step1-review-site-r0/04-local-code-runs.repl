; 04-local-code-runs: as 01-03, but where the library's code itself binds the name (its first call, or a way not
; seen before), so it's a local one and the call (hd ...) says where it is, each time
(def {hd} +)
(def {tl} -)
(def {&3} +)
(fun {id v} {do v})
(fun {g} {list (hd (id 100) 1) (tl (id 100) 1) (&3 (id 100) 1) &1})
(fun {g1} {list (hd (id 100) 1) &1})
(fun {g2} {list (tl (id 100) 1) &1})
(fun {g3} {list (&3 (id 100) 1) &1})
(g 0)
(g 0)
(g1)
(g2)
(g3)
(remove-fst 1 {2 1})
(g1)
(g2)
(?? NIL NIL NIL 5)
(g3)
