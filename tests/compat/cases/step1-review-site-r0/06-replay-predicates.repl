; 06-replay-predicates: as 05-replay-numbers, for the library's tests and the functions of any number of arguments
(fun {probe g args bind} {do (if bind (set y 0) NIL) (list (unpack g args) y)})
(fun {run g l} {map (fn {p} {probe g (fst p) (snd p)}) l})
