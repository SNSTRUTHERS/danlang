; 07-replay-strings: as 05-replay-numbers, for the string helpers (and index-of's lists)
(fun {probe g args bind} {do (if bind (set y 0) NIL) (list (unpack g args) y)})
(fun {run g l} {map (fn {p} {probe g (fst p) (snd p)}) l})
