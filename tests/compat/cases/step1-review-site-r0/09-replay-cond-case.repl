; 09-replay-cond-case: the place an error made right after a cond's or a case's call says it was made (y, unbound),
; the call made in a loop (its clauses' code run as cond's code runs it: each test, then the first true one's value,
; made lists both), the clauses of each shape: written in the call, made by list, ones that aren't clauses, a test
; that changes a global cond's code uses, a cond in a cond
(fun {classify x} {cond {(< x 0) :neg} {(== x 0) :zero} {(< x 10) (+ "small:" x)} {T (list x)}})
(fun {named n} {case n {1 "one"} {2 (+ "tw" "o")} {(+ 1 2) :three} {n n}})
(fun {nested x} {cond {(> x 5) (cond {(> x 50) :huge} {T :big})} {T (case x {1 :one} {x :other})}})
(fun {probe f x bind} {do (if bind (set y 0) NIL) (list (f x) y)})
(fun {run f l} {map (fn {p} {probe f (fst p) (snd p)}) l})
(run classify (list [-1 T] [-1 T] [-1 T] [-1 NIL]))
(run classify (list [-1 T] [0 T] [5 T] [50 T] [-1 NIL]))
(run classify (list [-1 T] [-1 T] [-1 T] [0 NIL]))
(run classify (list [5 T] [5 T] [5 T] [5 NIL]))
(run classify (list [5 T] [5 T] [5 T] [50 NIL]))
(run classify (list [50 T] [50 T] [50 T] [5 NIL]))
(run named (list [1 T] [1 T] [1 T] [1 NIL]))
(run named (list [1 T] [2 T] [3 T] [4 T] [2 NIL]))
(run named (list [3 T] [3 T] [3 T] [3 NIL]))
(run named (list [3 T] [3 T] [3 T] [9 NIL]))
(run named (list [:a T] [:a T] [:a T] ["s" NIL]))
(run nested (list [60 T] [60 T] [60 T] [60 NIL]))
(run nested (list [60 T] [6 T] [1 T] [2 T] [6 NIL]))
(run nested (list [1 T] [1 T] [1 T] [2 NIL]))
(fun {made x} {cond (list (> x 0) :pos) (list T (list x))})
(run made (list [1 T] [1 T] [1 T] [-1 NIL]))
(run made (list [-1 T] [-1 T] [-1 T] [1 NIL]))
(fun {odd-shapes x} {cond {(== x 0) :zero} x {T :rest}})
(run odd-shapes (list [0 T] [0 T] [0 T] [0 NIL]))
(run odd-shapes (list [0 T] [0 T] [0 T] [{T :x} NIL]))
(fun {short x} {cond {(== x 0)} {T :rest}})
(run short (list [1 T] [1 T] [1 T] [0 NIL]))
(def {count} 0)
(fun {busy x} {cond {(do (set! {count} (+ count 1)) (> x 0)) :pos} {(do (set! {count} (+ count 1)) T) :other}})
(run busy (list [1 T] [-1 T] [1 T] [-1 T] [-1 NIL]))
(print count)
(def {head0} head)
(fun {rebind x} {cond {(do (def {head} head0) (> x 0)) :pos} {T :other}})
(run rebind (list [1 T] [-1 T] [1 T] [-1 NIL]))
(fun {rebind2 x} {cond {(do (def {head} (fn {l} {head0 l})) (> x 0)) :pos} {T (do (def {head} head0) :other)}})
(run rebind2 (list [1 T] [-1 T] [1 T] [-1 NIL]))
(def {head} head0)
(run rebind2 (list [-1 T] [-1 T] [-1 T] [1 NIL]))
(def {head} head0)
(fun {err-test x} {cond {(== x 0) :zero} {(+ x "no") :never} {T :rest}})
(run err-test (list [0 T] [0 T] [0 T] [1 NIL]))
(run err-test (list [0 T] [0 T] [0 T] [0 NIL]))
(fun {no-match x} {cond {(== x 0) :zero} {(== x 1) :one}})
(run no-match (list [0 T] [1 T] [0 T] [5 NIL]))
(fun {no-case x} {case x {0 :zero} {1 :one}})
(run no-case (list [0 T] [1 T] [0 T] [5 NIL]))
