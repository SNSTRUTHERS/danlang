; 14-starts-with-num-given-midway: as 13, print giving 0 a Num before the last call
(fun {probe g args v bind} {do (print v) (if bind (set y 0) NIL) (list (unpack g args) y)})
(fun {run g l} {map (fn {p} {probe g (fst p) (snd p) (thd p)}) l})
(run starts-with? (list [{"abc" "a"} "x" T] [{"abc" "a"} "x" T] [{"abc" "a"} "x" T] [{"abc" "a"} 0 NIL]))
