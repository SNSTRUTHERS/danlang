; 18-errors-in-loop: as 05-replay-numbers, the call made in try, with calls between whose code makes an error (by
; zero, not a number, not a whole power, not a list ...), then calls whose values the native would give
(fun {probe g args bind} {do (if bind (set y 0) NIL) (list (try (unpack g args)) y)})
(fun {run g l} {map (fn {p} {probe g (fst p) (snd p)}) l})
(run mod (list [{7 2} T] [{7 2} T] [{7 2} T] [{7 0} T] [{7 2} NIL]))
(run mod (list [{7 2} T] [{7 2} T] [{7 2} T] [{7 0} NIL]))
(run mod (list [{7 2} T] [{7 2} T] [{7 2} T] [{"a" 2} T] [{7 2} NIL]))
(run mod (list [{7 2} T] [{7 2} T] [{7 2} T] [{"a" 2} NIL]))
(run floor (list [{7/2} T] [{7/2} T] [{7/2} T] [{"x"} T] [{7/2} NIL]))
(run floor (list [{7/2} T] [{7/2} T] [{7/2} T] [{"x"} NIL]))
(run even? (list [{4} T] [{4} T] [{4} T] [{:a} T] [{4} NIL]))
(run pow (list [{2 3} T] [{2 3} T] [{2 3} T] [{2 1/2} T] [{2 3} NIL]))
(run pow (list [{2 3} T] [{2 3} T] [{2 3} T] [{2 1/2} NIL]))
(run pow (list [{2 3} T] [{2 3} T] [{2 3} T] [{0 -1} T] [{2 3} NIL]))
(run zip (list [{{1} {2}} T] [{{1} {2}} T] [{{1} {2}} T] [{{1} 5} T] [{{1} {2}} NIL]))
(run zip (list [{{1} {2}} T] [{{1} {2}} T] [{{1} {2}} T] [{{1} 5} NIL]))
(run cond (list [{{T 1}} T] [{{T 1}} T] [{{NIL 1}} T] [{{T 1}} NIL]))
(run cond (list [{{T 1}} T] [{{T 1}} T] [{{NIL 1}} NIL]))
(run case (list [{1 {1 2}} T] [{1 {1 2}} T] [{1 {2 2}} T] [{1 {1 2}} NIL]))
(run case (list [{1 {1 2}} T] [{1 {1 2}} T] [{1 {2 2}} NIL]))
(run avg (list [{{1 2}} T] [{{1 2}} T] [{NIL} T] [{{1 2}} NIL]))
(run avg (list [{{1 2}} T] [{{1 2}} T] [{NIL} NIL]))
(run between? (list [{1 5 3} T] [{1 5 3} T] [{1 5} T] [{1 5 3} NIL]))
(run between? (list [{1 5 3} T] [{1 5 3} T] [{1 5} NIL]))
(run minimum (list [{{3 1 2}} T] [{{3 1 2}} T] [{NIL} T] [{{3 1 2}} NIL]))
(run minimum (list [{{3 1 2}} T] [{{3 1 2}} T] [{NIL} NIL]))
