; 19-nums-given-replayed: whether a library function's call, when its native's value is used (the call made in a
; loop: the third call on), gave its argument a Num, as its code does: x a fresh integer each time, given to the
; function, then looked at by Op2's (- x (g)), done in the call only for integers kept in their values (then an error
; made right after says it was where g's code left evaluation, {+ 70000 1}; else (- x (g)))
(fun {g} {+ 70000 1})
(fun {fresh i} {+ 100000 i})
(fun {probe x} {list (- x (g)) &1})
(fun {tst h} {map (fn {i} {do (set x (fresh i)) (h x) (unpack probe (if (== i 6) [x] [x 0]))}) {1 2 3 4 5 6}})
(tst (fn {x} {mod x 3}))
(tst (fn {x} {mod 3 x}))
(tst (fn {x} {div x 7}))
(tst floor)
(tst ceil)
(tst round)
(tst even?)
(tst odd?)
(tst (fn {x} {pow x 2}))
(tst (fn {x} {pow x 3}))
(tst (fn {x} {pow 2 (- x 99990)}))
(tst square)
(tst cube)
(tst >=0)
(tst <=0)
(tst >0)
(tst <0)
(tst !=0)
(tst !=1)
(tst positive?)
(tst negative?)
(tst (fn {x} {between? 1 200000 x}))
(tst (fn {x} {between? x 1 5}))
(tst (fn {x} {between? 1 x 5}))
(tst (fn {x} {xor x NIL}))
(tst (fn {x} {avg [x 1]}))
(tst (fn {x} {avg [x]}))
