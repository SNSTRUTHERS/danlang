; 20-tail-and-higher-order: as 05-replay-numbers, the library's functions reached in other ways: in tail position of a
; function of the program's (and between?'s own tail call), by map, filter, foldl, sort, count and find (their last
; call's place), as a hash's methods, partially applied (a copy: no native), and called through a variable
(fun {tc x} {floor x})
(fun {tc2 a b} {do (+ a b) (mod a b)})
(fun {tc3 x} {if (> x 0) (even? x) (round x)})
(def {h} (hash-create {{:f floor} {:m mod} {:b between?}}))
(def {fl} floor)
(fun {probe f x bind} {do (if bind (set y 0) NIL) (list (f x) y)})
(fun {run f l} {map (fn {p} {probe f (fst p) (snd p)}) l})
(run tc (list [7/2 T] [7/2 T] [7/2 T] [7/2 NIL]))
(run tc (list [7/2 T] [-7/2 T] [7/2 T] [-7/2 NIL]))
(run (fn {x} {tc2 x 3}) (list [7 T] [7 T] [7 T] [-7 NIL]))
(run tc3 (list [4 T] [-5/2 T] [4 T] [-5/2 T] [3 T] [-5/2 NIL]))
(run tc3 (list [4 T] [-5/2 T] [4 T] [-5/2 T] [3 T] [4 NIL]))
(run (fn {x} {between? x 1 5}) (list [9 T] [9 T] [9 T] [0 NIL]))
(run (fn {x} {map floor x}) (list [{7/2 -7/2} T] [{7/2 -7/2} T] [{7/2 -7/2} T] [{-7/2 7/2} NIL]))
(run (fn {x} {filter even? x}) (list [{1 2 3} T] [{1 2 3} T] [{1 2 3} T] [{2 3 4} NIL]))
(run (fn {x} {foldl mod 1000 x}) (list [{7 5 3} T] [{7 5 3} T] [{7 5 3} T] [{7 5 3} NIL]))
(run (fn {x} {foldl (fn {a b} {pow b a}) 1 x}) (list [{2 3} T] [{2 3} T] [{2 3} T] [{2 3 0} NIL]))
(run (fn {x} {sort x xor}) (list [{3 NIL 2} T] [{3 NIL 2} T] [{3 NIL 2} T] [{NIL NIL} NIL]))
(run (fn {x} {count odd? x}) (list [{1 2 3} T] [{1 2 3} T] [{1 2 3} T] [{1 2} NIL]))
(run (fn {x} {find (fn {s} {starts-with? s "b"}) x}) (list [{"ab" "bc"} T] [{"ab" "bc"} T] [{"ab" "bc"} T] [{"ab" "cb"} NIL]))
(run (fn {x} {h :f x}) (list [7/2 T] [7/2 T] [7/2 T] [-7/2 NIL]))
(run (fn {x} {h :m x 3}) (list [7 T] [7 T] [7 T] [-7 NIL]))
(run (fn {x} {h :b 5 1 x}) (list [3 T] [3 T] [3 T] [9 NIL]))
(run (fn {x} {(mod x) 3}) (list [7 T] [7 T] [7 T] [7 NIL]))
(run (fn {x} {(zip x) {1 2}}) (list [{3 4} T] [{3 4} T] [{3 4} T] [{3 4} NIL]))
(run fl (list [7/2 T] [7/2 T] [7/2 T] [-7/2 NIL]))
(run (fn {x} {% x 3}) (list [7 T] [7 T] [7 T] [-7 NIL]))
