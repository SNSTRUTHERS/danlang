; 22-other-errors-after: other errors made before another call starts, right after a library function's value (the
; call made in a loop, the error only in the last): the arity error of the function it's an argument of, a call whose
; first item's value isn't a function, set! of a name bound nowhere, a hash's value called that isn't a method, a
; buffer's byte past its end
(fun {k2 a b} {+ a b})
(fun {k3 a b c} {list a b c})
(fun {id v} {do v})
(def {h1} (hash-create {{3 id} {-4 id} {1 id}}))
(def {h2} (hash-create {{3 5} {-4 5} {1 5}}))
(def {b8} (buffer 8))
(def {b2} (buffer 2))
(fun {arity f x bind} {(if bind k3 k2) 1 2 (f x)})
(fun {head f x bind} {(if bind id (f x)) 1})
(fun {setb f x bind} {do (if bind (set zz 0) NIL) (set! {zz} (f x))})
(fun {method f x bind} {(if bind h1 h2) (f x) 1})
(fun {byte f x bind} {(if bind b8 b2) (f x)})
(fun {run p f l} {map (fn {q} {p f (fst q) (snd q)}) l})
(run arity floor (list [7/2 T] [7/2 T] [7/2 T] [7/2 NIL]))
(run arity floor (list [7/2 T] [-7/2 T] [7/2 T] [-7/2 NIL]))
(run arity even? (list [4 T] [4 T] [4 T] [5 NIL]))
(run arity (fn {x} {zip x {1}}) (list [{1} T] [{1} T] [{1} T] [NIL NIL]))
(run arity (fn {x} {between? 1 9 x}) (list [5 T] [5 T] [5 T] [0 NIL]))
(run head floor (list [7/2 T] [7/2 T] [7/2 T] [-7/2 NIL]))
(run head round (list [5/2 T] [5/2 T] [5/2 T] [-5/2 NIL]))
(run head (fn {x} {mod x 2}) (list [7 T] [7 T] [7 T] [8 NIL]))
(run setb floor (list [7/2 T] [7/2 T] [7/2 T] [7/2 NIL]))
(run setb (fn {x} {pow 2 x}) (list [3 T] [3 T] [3 T] [-3 NIL]))
(run setb (fn {x} {remove-all 1 x}) (list [{1 2} T] [{1 2} T] [{1 2} T] [{1 1} NIL]))
(run method floor (list [7/2 T] [7/2 T] [7/2 T] [-7/2 NIL]))
(run method ceil (list [1/2 T] [1/2 T] [1/2 T] [1/2 NIL]))
(run byte floor (list [7/2 T] [7/2 T] [7/2 T] [7/2 NIL]))
(run byte (fn {x} {div x 2}) (list [7 T] [7 T] [7 T] [6 NIL]))
