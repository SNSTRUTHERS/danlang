; 23-depth-traces: as 05-replay-numbers, with only so many levels of calls left (10000 nest at most): near the limit
; the native leaves the value to its code (its room for the calls the code nests, and a margin), whose error "Too deep"
; says where it was; a little further from it, the native's value, the place its code left
(fun {deep n f} {if (zero? n) (f) (fst (list (deep (- n 1) f)))})
(fun {probe g args bind} {do (if bind (set y 0) NIL) (list (unpack g args) y)})
(fun {at n g args} {deep n (fn {} {map (fn {p} {probe g (fst p) (snd p)}) (list [args T] [args T] [args T] [args NIL])})})
(at 9997 mod {7 2})
(at 9997 even? {-3})
(at 9997 floor {-7/2})
(at 9997 (fn {l} {zip l l}) {{1 2 3}})
