; flags: -w
; 25-nums-given-shared: whether a library function's call gave an integer a Num, as its code does, when its native's
; value is used (one call, made four times, the last with other arguments: the code's values three times, then the
; native's), for integers the call makes or is given (floor's tr, mod's a, has-element?'s items ...).  look tells: with
; -w, a def that changes v's kind says where evaluation is, and for (- k (g)) that's g's line (Op2 does it in the
; call, k an integer kept in its value) or look's (k has a Num)
(fun {g} {+ 70000 1})
(fun {id v} {do v})
(fun {look k} {do (def {v} id) (def {v} (- k (g)))})
(fun {each-call f a b k} {map (fn {i} {do (unpack f (if (== i 4) b a)) (look k)}) {1 2 3 4}})
(each-call floor {7/2} {9/2} 4)
(each-call ceil {7/2} {11/2} 6)
(each-call mod {7 5} {13 5} 13)
(each-call div {70 9} {80 9} 8)
(each-call round {7/2} {23/2} 12)
(each-call pow {2 3} {2 5} 5)
(each-call avg {{1 3}} {{5 9}} 14)
(each-call distinct {{7 7}} {{11 11}} 11)
(each-call has-element? {{7} 7} {{15} 15} 15)
(each-call remove-all {7 {7 1}} {16 {16 1}} 16)
(each-call starts-with? {{7} 7} {{17} 17} 17)
(each-call even? {70} {90} 45)
(each-call minimum {{70 71}} {{90 91}} 91)
(each-call divmod {70 9} {82 9} 82)
(each-call contains? {{7} 7} {{1 19} 19} 19)
(each-call odd? {71} {93} 46)
(each-call floor {700000000000000000001/100000000000000000000} {900000000000000000001/100000000000000000000} 9)
(each-call floor {7/2} {-9/2} -5)
(each-call floor {-7/2} {-11/2} -5)
(each-call mod {-7 5} {-9 5} -9)
(each-call >=0 {7} {21} 21)
(each-call !=1 {7} {22} 22)
(each-call between? {1 9 5} {1 30 23} 23)
(each-call square {7} {24} 24)
(each-call positive? {7} {25} 25)
(each-call zip {{7} {8}} {{26} {27}} 26)
(each-call flatten {{7 {8}}} {{28 {29}}} 28)
(each-call remove-fst {7 {7 1}} {31 {31 1}} 31)
(each-call maximum {{7 8}} {{32 33}} 33)
(each-call ?? {NIL 7} {NIL 34} 34)
(each-call between? {9 1 5} {35 1 5} 35)
(each-call cube {7} {36} 36)
