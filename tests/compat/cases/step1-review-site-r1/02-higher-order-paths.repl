; 02-higher-order-paths: library functions applied by built-ins (map, filter, foldl, foldr, sort, each, dotimes), not
; called from compiled code: once a run of its code has been seen the native's value is had, and the place an error
; made right after the built-in says it was made (f given 3 arguments: before another call starts) is where the last
; application's code left evaluation.  The way each goes changes along the list
(fun {f a b} {+ a b})
(f 1 2 (map floor {7/2 7/2 7/2 7/2}))
(f 1 2 (map floor {7/2 7/2 7/2 -7/2}))
(f 1 2 (map floor {7/2 -7/2 7/2 -7/2 7/2 -7/2}))
(f 1 2 (map floor {-7/2 -7/2 -7/2 3}))
(f 1 2 (map ceil {7/2 7/2 7/2 -7/2 -7/2 -7/2 4}))
(f 1 2 (map round {5/2 5/2 5/2 -5/2 -5/2 -5/2 5/2}))
(f 1 2 (map even? {1 2 3 4 5 6 -7 -9}))
(f 1 2 (map odd? {1 2 3 4 5 6}))
(f 1 2 (filter even? {-3 -5 -7 -9 100000000000000000001}))
(f 1 2 (filter (fn {x} {even? x}) {1 2 3 4 5 6}))
(f 1 2 (foldl mod 1000 {7 5 3 2}))
(f 1 2 (foldl div 1000 {7 5 3 2}))
(f 1 2 (foldl div -1000 {7 5 3 2}))
(f 1 2 (foldr mod 1000 {7 5 3 2}))
(f 1 2 (foldl pow 2 {1 2 2 0}))
(f 1 2 (foldl xor NIL {T NIL T NIL NIL}))
(f 1 2 (sort {3 1 2 5 4} xor))
(f 1 2 (map flatten {{{1} 2} {{1} 2} {{1} 2} {1 {2}} {1 {2}} {1 {2}} NIL}))
(f 1 2 (map distinct {{1 2 1} {1 2 1} {1 2 1} {1} {1} {1} NIL}))
(f 1 2 (map (fn {l} {remove-all 1 l}) {{1 2 1} {1 2 1} {1 2 1} {1 1} {1 1} {1 1}}))
(f 1 2 (map (fn {l} {remove-fst 1 l}) {{1 2} {1 2} {1 2} {2 1} {2 1} {2 1} NIL}))
(f 1 2 (map minimum {{3 1 2} {3 1 2} {3 1 2}}))
(f 1 2 (map ?? {1 NIL 2 NIL NIL}))
(f 1 2 (map (fn {s} {starts-with? s "a"}) {"ab" "ab" "ab" "ba" "ba" "ba" "ab"}))
(f 1 2 (map (fn {s} {ends-with? s "abc"}) {"ab" "ab" "ab" "xabc" "xabc" "xabc" "ab"}))
(f 1 2 (map (fn {s} {contains? s "b"}) {"ab" "ab" "ab" "xy" "xy"}))
(f 1 2 (each floor {7/2 7/2 7/2 -7/2}))
(f 1 2 (dotimes 5 even?))
(f 1 2 (dotimes 5 square))
(f 1 2 (map (mod 7) {2 3 4 5}))
(f 1 2 (map (div 7) {2 3 4 5}))
(f 1 2 (map (between? 1 10) {5 5 5 0 0 0 11}))
(f 1 2 (map (zip {1 2}) {{3 4} {3 4} {3 4} NIL NIL NIL}))
