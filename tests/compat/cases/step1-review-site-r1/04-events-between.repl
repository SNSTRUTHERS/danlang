; 04-events-between: a library function called twice with one argument (its code runs: from the second its Site is
; kept), then something else done, then called with another and an error made right after (f given 3 arguments).
; What's done between changes no plan: the shared 0, 1, 2 or -1 given a Num (to-str), an error caught, a
; dependency redefined and put back with nothing run between, a cond or case of other calls, map of another
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 fn x h} {h 1 2 (fn x)})
(fun {p2 fn x y h} {h 1 2 (fn x y)})
(fun {d l} {map (fn {q} {if (== (len q) 3) (p1 (fst q) (snd q) (thd q)) (p2 (fst q) (snd q) (thd q) (nth 3 q))}) l})
(def {floor0} floor)
(def {trunc0} trunc)
(fun {ev-none x} {x})
(fun {ev-str0 x} {to-str 0})
(fun {ev-str1 x} {to-str 1})
(fun {ev-str2 x} {to-str 2})
(fun {ev-str-1 x} {to-str -1})
(fun {ev-try x} {try (floor "x")})
(fun {ev-floor x} {do (def {floor} (fn {a} {trunc a})) (def {floor} floor0) x})
(fun {ev-trunc x} {do (def {trunc} (fn {a} {truncate a})) (def {trunc} trunc0) x})
(fun {ev-cond x} {cond {(> x 1) (floor 7/2)} {T (ceil 7/2)}})
(fun {ev-case x} {case x {1 (mod 7 2)} {0 (div 7 3)}})
(fun {ev-map x} {map floor {7/2 -7/2 3}})
(d (list (list even? -3 f3) (list even? -3 f3) (list ev-none 0 f3) (list even? -100000000000000000001 f2)))
(d (list (list even? -3 f3) (list even? -3 f3) (list ev-str1 0 f3) (list even? -3 f2)))
(d (list (list even? -5 f3) (list even? -5 f3) (list ev-str1 0 f3) (list even? -7 f2)))
(d (list (list even? 4 f3) (list even? 4 f3) (list ev-str0 0 f3) (list even? 6 f2)))
(d (list (list starts-with? "abc" "c" f3) (list starts-with? "abc" "c" f3) (list ev-str2 0 f3) (list starts-with? "abc" "c" f2)))
(d (list (list starts-with? "abc" "a" f3) (list starts-with? "abc" "a" f3) (list ev-str0 0 f3) (list starts-with? "cba" "a" f2)))
(d (list (list starts-with? "abc" "x" f3) (list starts-with? "abc" "x" f3) (list ev-str-1 0 f3) (list starts-with? "abc" "x" f2)))
(d (list (list ends-with? "ab" "abc" f3) (list ends-with? "ab" "abc" f3) (list ev-str2 0 f3) (list ends-with? "a" "abc" f2)))
(d (list (list ends-with? "a" "abc" f3) (list ends-with? "a" "abc" f3) (list ev-str1 0 f3) (list ends-with? "a" "ab" f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list ev-try 0 f3) (list mod -7 2 f2)))
(d (list (list floor 7/2 f3) (list floor 7/2 f3) (list ev-try 0 f3) (list floor 9/2 f2)))
(d (list (list floor 7/2 f3) (list floor 7/2 f3) (list ev-floor 0 f3) (list floor 9/2 f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list ev-floor 0 f3) (list mod 9 2 f2)))
(d (list (list div -7 2 f3) (list div -7 2 f3) (list ev-trunc 0 f3) (list div -9 2 f2)))
(d (list (list round -5/2 f3) (list round -5/2 f3) (list ev-cond 2 f3) (list round -7/2 f2)))
(d (list (list round 5/2 f3) (list round 5/2 f3) (list ev-cond 0 f3) (list round 7/2 f2)))
(d (list (list div 7 2 f3) (list div 7 2 f3) (list ev-case 1 f3) (list div 9 2 f2)))
(d (list (list div 8 2 f3) (list div 8 2 f3) (list ev-case 0 f3) (list div 10 2 f2)))
(d (list (list ceil 7/2 f3) (list ceil 7/2 f3) (list ev-map 0 f3) (list ceil 9/2 f2)))
(d (list (list pow 2 3 f3) (list pow 2 3 f3) (list ev-str1 0 f3) (list pow 2 5 f2)))
(d (list (list pow 2 0 f3) (list pow 2 0 f3) (list ev-str0 0 f3) (list pow 3 0 f2)))
(d (list (list !=0 0 f3) (list !=0 0 f3) (list ev-str0 0 f3) (list !=0 0 f2)))
(d (list (list xor T NIL f3) (list xor T NIL f3) (list ev-try 0 f3) (list xor NIL T f2)))
(d (list (list zip {1 2} {3 4} f3) (list zip {1 2} {3 4} f3) (list ev-map 0 f3) (list zip {5} {6} f2)))
(d (list (list remove-fst 1 {1 2} f3) (list remove-fst 1 {1 2} f3) (list ev-case 1 f3) (list remove-fst 3 {3} f2)))
