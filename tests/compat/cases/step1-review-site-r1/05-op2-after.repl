(d1 pa square (list (list 5 f3 70001) (list 5 f3 70001) (list 5 f3 70001) (list 7 f2 70001)))
(d1 pv square (list (list 100000 f3 70001) (list 100000 f3 70001) (list 100000 f3 70001) (list 3037000500 f2 70001)))
(d1 pv cube (list (list 3 f3 70001) (list 3 f3 70001) (list 3 f3 70001) (list 4 f2 70001)))
