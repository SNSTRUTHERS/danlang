; 05-op2-after: what a call of + right after a library function's call sees, done in the call (Op2) for integers kept
; in their values: the function's value, or one of its arguments (through id), each given a Num or not as the code
; gives them, added to k (70001, one of each probe's own: never given a Num).  Done in the call, + doesn't say where
; it is, so the error right after (f given 3 arguments) says where the code before it left evaluation
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {id v} {do v})
(fun {pv g x h k} {h 1 2 (+ (g x) k)})
(fun {pa g x h k} {h 1 2 (do (g x) (+ (id x) k))})
(fun {pv2 g x y h k} {h 1 2 (+ (g x y) k)})
(fun {pa2 g x y h k} {h 1 2 (do (g x y) (+ (id x) k))})
(fun {pb2 g x y h k} {h 1 2 (do (g x y) (+ (id y) k))})
(fun {d1 p g l} {map (fn {q} {p g (fst q) (snd q) (thd q)}) l})
(fun {d2 p g l} {map (fn {q} {p g (fst q) (snd q) (thd q) (nth 3 q)}) l})
(d1 pv floor (list (list 7/2 f3 70001) (list 7/2 f3 70001) (list 7/2 f3 70001) (list 7/2 f2 70001)))
(d1 pv floor (list (list -7/2 f3 70001) (list -7/2 f3 70001) (list -7/2 f3 70001) (list -9/2 f2 70001)))
(d1 pv floor (list (list 3 f3 70001) (list 3 f3 70001) (list 3 f3 70001) (list 100000 f2 70001)))
(d1 pv floor (list (list -7/2 f3 70001) (list -7/2 f3 70001) (list -7/2 f3 70001) (list -200001/2 f2 70001)))
(d1 pa floor (list (list 3 f3 70001) (list 3 f3 70001) (list 3 f3 70001) (list 5 f2 70001)))
(d1 pa floor (list (list 70000 f3 70001) (list 70000 f3 70001) (list 70000 f3 70001) (list 70002 f2 70001)))
