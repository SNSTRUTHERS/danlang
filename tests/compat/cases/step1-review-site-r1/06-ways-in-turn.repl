; 06-ways-in-turn: each library function called with arguments for which its code goes one way, then another, then
; back, in one loop, and an error made right after (f given 3 arguments) after the first call, the first two, the
; first three ... each time where the last call left evaluation: a way seen for the first time runs the code, a way
; seen before (with no plan changed since) has its value had natively
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {p2 g x y h} {h 1 2 (g x y)})
(fun {p3 g x y z h} {h 1 2 (g x y z)})
(fun {d l} {map (fn {q} {if (== (len q) 3) (p1 (fst q) (snd q) (thd q)) (if (== (len q) 4) (p2 (fst q) (snd q) (thd q) (nth 3 q)) (p3 (fst q) (snd q) (thd q) (nth 3 q) (nth 4 q)))}) l})
