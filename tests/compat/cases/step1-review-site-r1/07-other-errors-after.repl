; 07-other-errors-after: errors made right after a library function's call, before another call starts, other than an
; arity error: &1 unbound later in the same list (the call made through unpack, which evaluates a list made each
; time, so the function's own calls are the same each time), &1 unbound after it in do, if, and, or; its value not a
; function, called; a hash given its value as a key whose value isn't a method; a buffer given it as an index past its
; end.  Each after calls that had the native's value
(fun {pl g x} {list (g x) &1})
(fun {pl2 g x y} {list (g x y) &1})
(fun {pd g x} {do (g x) &1})
(fun {pi g x} {if (g x) &1 &1})
(fun {pa g x} {and (g x) &1})
(fun {po g x} {or (g x) &1})
(fun {run p l} {map (fn {q} {unpack p q}) l})
(run pl (list (list floor 7/2 0) (list floor 7/2 0) (list floor 7/2 0) (list floor 9/2)))
(run pl (list (list floor -7/2 0) (list floor -7/2 0) (list floor -7/2 0) (list floor -9/2)))
(run pl (list (list even? 4 0) (list even? 4 0) (list even? 4 0) (list even? 6)))
(run pl (list (list round -5/2 0) (list round -5/2 0) (list round -5/2 0) (list round -7/2)))
(run pl (list (list starts-with? "abc" 0) (list starts-with? "abc" 0) (list starts-with? "abc" 0) (list starts-with? "abc")))
(run pl2 (list (list mod 7 2 0) (list mod 7 2 0) (list mod 7 2 0) (list mod 9 4)))
(run pl2 (list (list div -7 2 0) (list div -7 2 0) (list div -7 2 0) (list div -9 2)))
(run pl2 (list (list starts-with? "abc" "c" 0) (list starts-with? "abc" "c" 0) (list starts-with? "abc" "c" 0) (list starts-with? "abc" "c")))
(run pl2 (list (list ends-with? "a" "abc" 0) (list ends-with? "a" "abc" 0) (list ends-with? "a" "abc" 0) (list ends-with? "b" "abc")))
(run pl2 (list (list pow 2 3 0) (list pow 2 3 0) (list pow 2 3 0) (list pow 2 5)))
(run pl2 (list (list xor T NIL 0) (list xor T NIL 0) (list xor T NIL 0) (list xor NIL T)))
(run pd (list (list floor 7/2 0) (list floor 7/2 0) (list floor 7/2 0) (list floor 9/2)))
(run pd (list (list ceil -7/2 0) (list ceil -7/2 0) (list ceil -7/2 0) (list ceil -9/2)))
(run pi (list (list even? -3 0) (list even? -3 0) (list even? -3 0) (list even? -5)))
(run pi (list (list >=0 5 0) (list >=0 5 0) (list >=0 5 0) (list >=0 -5)))
(run pa (list (list !=0 5 0) (list !=0 5 0) (list !=0 5 0) (list !=0 6)))
(run pa (list (list positive? 5 0) (list positive? 5 0) (list positive? 5 0) (list positive? 6)))
(run po (list (list odd? 4 0) (list odd? 4 0) (list odd? 4 0) (list odd? 6)))
(run po (list (list ?? NIL 0) (list ?? NIL 0) (list ?? NIL 0) (list ?? NIL)))
(fun {f3 a b c} {+ a b})
(fun {ph g x} {(g x) 1 2 3})
(map (fn {x} {ph ?? x}) (list f3 f3 f3 5))
(map (fn {x} {ph minimum x}) (list (list f3) (list f3) (list f3) {5}))
(def {hs} (hash-create {{3 (fn {v} {v})} {-4 7} {2 (fn {v} {v})} {-3 8}}))
(fun {pm g x} {hs (g x) 5})
(map (fn {x} {pm floor x}) {7/2 7/2 7/2 -7/2})
(map (fn {x} {pm round x}) {5/2 5/2 5/2 -5/2})
(def {buf} (buffer 4))
(fun {pb g x} {buf (g x)})
(map (fn {x} {pb floor x}) {7/2 7/2 7/2 9/2})
(map (fn {x} {pb square x}) {1 1 1 3})
(map (fn {x} {pb floor x}) {-7/2 -7/2 -7/2 -9/2})
