; 08-names-made-local: a name a library function's code calls by (floor, cmp, trunc, zero?, 1-, not, =0, >=, index-of,
; eq, cons, fst, len, and, if) made a local one in the middle of a loop, by let, a function's formal, set, dotimes,
; each, a partial application, a method's call: from then on the calls that start with it don't go their plan's way.
; The function called twice, the name made local, the function called again and an error made right after (f given 3
; arguments); then the same with the name local already
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {p2 g x y h} {h 1 2 (g x y)})
(fun {d l} {map (fn {q} {if (== (len q) 3) (p1 (fst q) (snd q) (thd q)) (p2 (fst q) (snd q) (thd q) (nth 3 q))}) l})
(fun {by-let x} {let {{floor 1}} x})
(fun {by-formal cmp} {cmp})
(fun {by-set x} {do (set trunc 1) x})
(fun {by-dotimes x} {dotimes {zero? 1} x})
(fun {by-each x} {each {1- {1}} x})
(fun {by-partial x} {(fn {not y} {y}) 1})
(fun {by-fn =0} {=0})
(fun {by-let2 x} {let {{>= 1} {index-of 2}} x})
(def {hm} (hash-create {{:m (fn {eq} {eq})}}))
(fun {by-method x} {hm :m x})
(fun {by-let3 x} {let {{cons 1} {fst 2} {len 3}} x})
(fun {by-let4 x} {let {{and 1} {if 2}} x})
