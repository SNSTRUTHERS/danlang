(d (list (list floor 7/2 f3) (list floor 7/2 f3) (list by-formal 0 f3) (list floor 9/2 f2)))
(d (list (list ceil -7/2 f3) (list ceil -7/2 f3) (list ceil -7/2 f3) (list ceil 7/2 f2)))
(d (list (list floor -7/2 f3) (list floor -7/2 f3) (list by-set 0 f3) (list floor -9/2 f2)))
(d (list (list pow 2 3 f3) (list pow 2 3 f3) (list pow 2 3 f3) (list pow 2 4 f2)))
(d (list (list pow 2 0 f3) (list pow 2 0 f3) (list by-dotimes 0 f3) (list pow 3 0 f2)))
(d (list (list !=0 0 f3) (list !=0 0 f3) (list !=0 0 f3) (list !=0 5 f2)))
(d (list (list floor -7/2 f3) (list floor -7/2 f3) (list by-each 0 f3) (list floor -9/2 f2)))
(d (list (list pow 2 1 f3) (list pow 2 1 f3) (list pow 2 1 f3) (list pow 2 3 f2)))
(d (list (list xor T NIL f3) (list xor T NIL f3) (list by-partial 0 f3) (list xor NIL T f2)))
(d (list (list !=1 1 f3) (list !=1 1 f3) (list !=1 1 f3) (list !=1 2 f2)))
(d (list (list even? -3 f3) (list even? -3 f3) (list by-fn 0 f3) (list even? -5 f2)))
(d (list (list starts-with? "abc" "c" f3) (list starts-with? "abc" "c" f3) (list starts-with? "abc" "c" f3) (list starts-with? "abc" "x" f2)))
(d (list (list ends-with? "a" "abc" f3) (list ends-with? "a" "abc" f3) (list by-let2 0 f3) (list ends-with? "b" "abc" f2)))
