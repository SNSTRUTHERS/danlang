(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list mod 7 2 f3) (list mod 9 2 f2)))
(d (list (list div -7 2 f3) (list div -7 2 f3) (list div -7 2 f3) (list div -9 2 f2)))
