; 09-redefine-restore: in the middle of a loop, a global a library function's code uses (floor, -, cmp, trunc,
; index-of, the function itself) given another value and then its own back: with the function called in between (its
; code runs the new one, and its calls learn the new value) or not; then the function called again, and an error made
; right after (f given 3 arguments) says where its code left evaluation
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {p2 g x y h} {h 1 2 (g x y)})
(fun {d l} {map (fn {q} {if (== (len q) 3) (p1 (fst q) (snd q) (thd q)) (p2 (fst q) (snd q) (thd q) (nth 3 q))}) l})
(def {floor0 minus0 cmp0 trunc0 index-of0 mod0 even0} floor - cmp trunc index-of mod even?)
(fun {floor-away x} {do (def {floor} (fn {a} {trunc a})) (def {floor} floor0) x})
(fun {floor-used x} {do (def {floor} (fn {a} {trunc a})) (mod 7 2) (def {floor} floor0) x})
(fun {minus-away x} {do (set! {-} +) (set! {-} minus0) x})
(fun {minus-used x} {do (set! {-} +) (mod 7 2) (round -5/2) (set! {-} minus0) x})
(fun {cmp-used x} {do (def {cmp} (fn {a b} {0})) (floor 7/2) (def {cmp} cmp0) x})
(fun {trunc-used x} {do (def {trunc} (fn {a} {truncate a})) (floor 7/2) (pow 2 3) (def {trunc} trunc0) x})
(fun {index-of-used x} {do (def {index-of} (fn {s x} {0})) (starts-with? "abc" "c") (def {index-of} index-of0) x})
(fun {mod-used x} {do (fun {mod a b} {0}) (even? 3) (def {mod} mod0) x})
(fun {even-used x} {do (def {even?} (fn {n} {=0 (mod n 2)})) (pow 2 4) (def {even?} even0) x})
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list floor-away 0 f3) (list mod 9 2 f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list floor-used 0 f3) (list mod 9 2 f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list floor-used 0 f3) (list mod 9 2 f3) (list mod 9 2 f3) (list mod 11 2 f2)))
(d (list (list div -7 2 f3) (list div -7 2 f3) (list floor-used 0 f3) (list div -9 2 f2)))
(d (list (list round -5/2 f3) (list round -5/2 f3) (list floor-used 0 f3) (list round -7/2 f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list minus-away 0 f3) (list mod 9 2 f2)))
(d (list (list mod 7 2 f3) (list mod 7 2 f3) (list minus-used 0 f3) (list mod 9 2 f2)))
(d (list (list round -5/2 f3) (list round -5/2 f3) (list minus-used 0 f3) (list round -7/2 f2)))
(d (list (list floor 7/2 f3) (list floor 7/2 f3) (list cmp-used 0 f3) (list floor 9/2 f2)))
(d (list (list floor -7/2 f3) (list floor -7/2 f3) (list cmp-used 0 f3) (list floor -9/2 f2)))
(d (list (list floor 7/2 f3) (list floor 7/2 f3) (list trunc-used 0 f3) (list floor 9/2 f2)))
(d (list (list pow 2 3 f3) (list pow 2 3 f3) (list trunc-used 0 f3) (list pow 2 5 f2)))
(d (list (list starts-with? "abc" "c" f3) (list starts-with? "abc" "c" f3) (list index-of-used 0 f3) (list starts-with? "abc" "c" f2)))
(d (list (list even? 3 f3) (list even? 3 f3) (list mod-used 0 f3) (list even? 5 f2)))
(d (list (list even? -3 f3) (list even? -3 f3) (list mod-used 0 f3) (list even? -5 f2)))
(d (list (list pow 2 4 f3) (list pow 2 4 f3) (list even-used 0 f3) (list pow 2 6 f2)))
(d (list (list pow 2 4 f3) (list pow 2 4 f3) (list pow 2 4 f3) (list pow 2 6 f2)))
