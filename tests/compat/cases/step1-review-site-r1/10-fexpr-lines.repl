; 10-fexpr-lines: an fexpr called at the top level: its call has no plan to learn (an fexpr's never has one), so from
; one line to the next no plan changes, and the library function its body calls has its value had natively once a
; run of its code has been seen (on an earlier line), the place an error made right after it (f given 3 arguments)
; says being where the code left evaluation.  Between them, lines that are a number (printed, so given a Num: the
; shared 0, 1, 2 ...) or a list
(fun {f2 a b} {+ a b})
(def {pf} (fexpr {x} {f2 1 2 (floor (eval x))}))
(def {pe} (fexpr {x} {f2 1 2 (even? (eval x))}))
(def {ps} (fexpr {x} {f2 1 2 (starts-with? "abc" (eval x))}))
(def {pn} (fexpr {x} {f2 1 2 (ends-with? (eval x) "abc")}))
(def {pp} (fexpr {x} {f2 1 2 (pow 2 (eval x))}))
(def {pc} (fexpr {x} {f2 1 2 (cond {(> (eval x) 1) (floor (eval x))} {T (ceil (eval x))})}))
(pf 7/2)
(pf 7/2)
(pf 7/2)
(pf 9/2)
(pf -7/2)
(pf -7/2)
(pf -7/2)
3
(pf 3)
(pf 3)
{1 2}
(pf 5)
(pe -3)
(pe -3)
(pe -3)
(pe -5)
1
(pe -5)
(pe -7)
(pe 4)
(pe 4)
0
(pe 4)
(ps "c")
(ps "c")
(ps "c")
2
(ps "c")
(ps "b")
(ps "b")
1
(ps "b")
(ps "a")
(ps "a")
(pn "a")
(pn "a")
(pn "a")
3
(pn "a")
(pn "ab")
(pn "ab")
(pn "ab")
(pp 3)
(pp 3)
(pp 3)
(pp 0)
(pp 0)
(pp 0)
(pp -2)
(pp -2)
(pp -2)
(pc 7/2)
(pc 7/2)
(pc 7/2)
(pc -7/2)
(pc -7/2)
