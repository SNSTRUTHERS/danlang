; 11-natives-in-clauses: library functions called in cond's and case's clauses (their tests, their values, case's
; key), in a loop so their values are had natively once a run of their code has been seen, and an error made right
; after the cond or case (f given 3 arguments): where the last clause run left evaluation.  The clause taken changes
; along the list, and the last has none taken (cond's and case's errors, made by their code)
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {c1 x h} {h 1 2 (cond {(even? x) (floor (/ x 4))} {(>0 x) (ceil (/ x 4))} {T (round (/ x 2))})})
(fun {c2 x h} {h 1 2 (cond {(starts-with? x "a") (ends-with? x "c")} {(contains? x "b") (zip {1} {2})} {T (?? NIL x)})})
(fun {c3 x h} {h 1 2 (cond {(even? x) (floor x)} {(odd? x) x})})
(fun {c4 x h} {h 1 2 (cond {(!=0 x) (div x 2)} {(xor x T) (mod x 2)})})
(fun {k1 x h} {h 1 2 (case (mod x 3) {0 (div x 3)} {1 (floor (/ x 2))} {2 (pow 2 x)})})
(fun {k2 x h} {h 1 2 (case (floor x) {3 (ceil x)} {-4 (round x)})})
(fun {k3 x h} {h 1 2 (case x {(floor 7/2) (mod x 2)} {(ceil 7/2) (div x 2)} {x (even? x)})})
(fun {run c l} {map (fn {q} {c (fst q) (snd q)}) l})
(run c1 (list (list 4 f3) (list 4 f3) (list 4 f3) (list 8 f2)))
(run c1 (list (list 4 f3) (list 4 f3) (list 4 f3) (list 7 f2)))
(run c1 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 9 f2)))
(run c1 (list (list -7 f3) (list -7 f3) (list -7 f3) (list -9 f2)))
(run c1 (list (list 4 f3) (list 7 f3) (list -7 f3) (list 4 f3) (list 7 f3) (list -7 f3) (list -5 f2)))
(run c2 (list (list "abc" f3) (list "abc" f3) (list "abc" f3) (list "abd" f2)))
(run c2 (list (list "xbc" f3) (list "xbc" f3) (list "xbc" f3) (list "xyz" f2)))
(run c2 (list (list "xyz" f3) (list "xyz" f3) (list "xyz" f3) (list "xbz" f2)))
(run c3 (list (list 4 f3) (list 4 f3) (list 4 f3) (list 6 f2)))
(run c3 (list (list 3 f3) (list 3 f3) (list 3 f3) (list 7/2 f2)))
(run c4 (list (list 7 f3) (list 7 f3) (list 7 f3) (list -7 f2)))
(run c4 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 0 f2)))
(run k1 (list (list 6 f3) (list 6 f3) (list 6 f3) (list 9 f2)))
(run k1 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 10 f2)))
(run k1 (list (list 8 f3) (list 8 f3) (list 8 f3) (list 5 f2)))
(run k1 (list (list 6 f3) (list 7 f3) (list 8 f3) (list 6 f3) (list 7 f3) (list 8 f3) (list 11 f2)))
(run k2 (list (list 7/2 f3) (list 7/2 f3) (list 7/2 f3) (list 13/4 f2)))
(run k2 (list (list -7/2 f3) (list -7/2 f3) (list -7/2 f3) (list -15/4 f2)))
(run k2 (list (list 7/2 f3) (list 7/2 f3) (list 7/2 f3) (list 9/2 f2)))
(run k3 (list (list 3 f3) (list 3 f3) (list 3 f3) (list 4 f2)))
(run k3 (list (list 4 f3) (list 4 f3) (list 4 f3) (list 5 f2)))
(run k3 (list (list 5 f3) (list 5 f3) (list 5 f3) (list 3 f2)))
