; 12-depth-room: library functions called in a loop with only so many levels of calls left (k: 90 to 115 from the
; limit of 10000), where the native, with its margin, gives up having their values for the code's, and an error
; made right after the last call (f given 3 arguments): its place, and the calls it's in, as the code leaves them
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {p2 g x y h} {h 1 2 (g x y)})
(fun {probe1 g a b} {map (fn {q} {p1 g (fst q) (snd q)}) (list (list a f3) (list a f3) (list a f3) (list b f2))})
(fun {probe2 g a b c} {map (fn {q} {p2 g (fst q) (snd q) (thd q)}) (list (list a b f3) (list a b f3) (list a b f3) (list a c f2))})
(fun {deep n f} {if (zero? n) (f) (fst (list (deep (- n 1) f)))})
(fun {at k f} {deep (- 9997 k) f})
