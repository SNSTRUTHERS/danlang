; 13-plan-churn: the library functions called in a loop that changes a plan every time round (op given another value
; and called), so no way of theirs is ever kept for the plans there are: their values, each from the code, and the
; last loop's error (f given 3 arguments) placed where the last call's code left evaluation
(fun {f a b} {+ a b})
(def {l} (range 300))
(def {op} +)
(fun {churn i} {do (def {op} (if (== (bit-and i 1) 0) + -)) (op 1 2)})
(fun {all i} {list (floor (/ i 7)) (ceil (/ i -7)) (round (/ i 4)) (mod i 7) (div i -7) (even? i) (odd? i) (pow 2 (mod i 9))
  (square i) (cube i) (>=0 (- i 150)) (!=0 (mod i 3)) (between? 100 10 i) (xor (even? i) (odd? i)) (avg (list i 1))
  (?? NIL (mod i 2)) (starts-with? (to-str i) "1") (ends-with? (to-str i) "0") (contains? (to-str i) "5")
  (len (zip l (take (mod i 7) l))) (flatten (list i (list i))) (distinct (list (mod i 3) (mod i 2) 1))
  (remove-all (mod i 3) {0 1 2 0}) (remove-fst (mod i 3) {0 1 2 0}) (has-element? l i) (minimum (list i 5))
  (maximum (list i 5)) (cond {(even? i) :even} {T :odd}) (case (mod i 3) {0 :zero} {1 :one} {2 :two})})
(def {out} (map (fn {i} {do (churn i) (all i)}) (range 300)))
(print (len out))
(print (fst out))
(print (nth 151 out))
(print (nth 299 out))
(print (foldl + 0 (map (fn {r} {fst r}) out)))
(map (fn {i} {do (churn i) (if (== i 9) (f 1 2 (floor (/ i -2))) (floor (/ i -2)))}) (range 10))
