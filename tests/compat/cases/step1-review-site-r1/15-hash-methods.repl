; 15-hash-methods: library functions kept in a hash: called as its methods (a copy of the function with the hash
; bound, &0: one with no native way, its code runs each time), or had with hash-get and called (the function itself),
; in loops, and an error made right after the last call (f given 3 arguments)
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(def {h} (hash-create {{:floor floor} {:mod mod} {:zip zip} {:even even?} {:sw starts-with?}}))
(fun {pm k x g} {g 1 2 (h k x)})
(fun {pm2 k x y g} {g 1 2 (h k x y)})
(fun {pg k x g} {g 1 2 ((hash-get h k) x)})
(fun {pg2 k x y g} {g 1 2 ((hash-get h k) x y)})
(map (fn {q} {pm :floor (fst q) (snd q)}) (list (list 7/2 f3) (list 7/2 f3) (list 7/2 f3) (list -7/2 f2)))
(map (fn {q} {pm :floor (fst q) (snd q)}) (list (list -7/2 f3) (list -7/2 f3) (list -7/2 f3) (list -9/2 f2)))
(map (fn {q} {pg :floor (fst q) (snd q)}) (list (list 7/2 f3) (list 7/2 f3) (list 7/2 f3) (list -7/2 f2)))
(map (fn {q} {pg :floor (fst q) (snd q)}) (list (list -7/2 f3) (list -7/2 f3) (list -7/2 f3) (list -9/2 f2)))
(map (fn {q} {pm :even (fst q) (snd q)}) (list (list -3 f3) (list -3 f3) (list -3 f3) (list -5 f2)))
(map (fn {q} {pg :even (fst q) (snd q)}) (list (list -3 f3) (list -3 f3) (list -3 f3) (list -5 f2)))
(map (fn {q} {pm2 :mod (fst q) (snd q) (thd q)}) (list (list 7 2 f3) (list 7 2 f3) (list 7 2 f3) (list -7 2 f2)))
(map (fn {q} {pg2 :mod (fst q) (snd q) (thd q)}) (list (list 7 2 f3) (list 7 2 f3) (list 7 2 f3) (list -7 2 f2)))
(map (fn {q} {pm2 :zip (fst q) (snd q) (thd q)}) (list (list {1 2} {3} f3) (list {1 2} {3} f3) (list {1 2} {3} f3) (list NIL {3} f2)))
(map (fn {q} {pg2 :zip (fst q) (snd q) (thd q)}) (list (list {1 2} {3} f3) (list {1 2} {3} f3) (list {1 2} {3} f3) (list NIL {3} f2)))
(map (fn {q} {pm2 :sw (fst q) (snd q) (thd q)}) (list (list "abc" "c" f3) (list "abc" "c" f3) (list "abc" "c" f3) (list "abc" "a" f2)))
(map (fn {q} {pg2 :sw (fst q) (snd q) (thd q)}) (list (list "abc" "c" f3) (list "abc" "c" f3) (list "abc" "c" f3) (list "abc" "a" f2)))
(map (fn {q} {if (fst q) (pm :floor (snd q) (thd q)) (pg :floor (snd q) (thd q))}) (list (list T 7/2 f3) (list NIL 7/2 f3) (list T 7/2 f3) (list NIL 7/2 f3) (list T -7/2 f3) (list NIL -7/2 f2)))
(map (fn {q} {if (fst q) (pm :floor (snd q) (thd q)) (pg :floor (snd q) (thd q))}) (list (list NIL 7/2 f3) (list NIL 7/2 f3) (list NIL 7/2 f3) (list T 7/2 f2)))
