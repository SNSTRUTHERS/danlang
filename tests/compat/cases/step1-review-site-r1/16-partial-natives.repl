; 16-partial-natives: library functions partially applied (a copy with the first arguments bound: no native way, its
; code runs each time) and called with the rest, between calls of the function itself (whose value is had natively
; once a run of its code has been seen), in loops, and an error made right after the last call (f given 3 arguments)
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {pp g x y h} {h 1 2 ((g x) y)})
(fun {pf g x y h} {h 1 2 (g x y)})
(fun {run l} {map (fn {q} {(fst q) (snd q) (thd q) (nth 3 q) (nth 4 q)}) l})
(run (list (list pf mod 7 2 f3) (list pf mod 7 2 f3) (list pf mod 7 2 f3) (list pp mod 7 2 f2)))
(run (list (list pp mod 7 2 f3) (list pp mod 7 2 f3) (list pp mod 7 2 f3) (list pf mod 7 2 f2)))
(run (list (list pf mod 7 2 f3) (list pp mod 7 2 f3) (list pf mod 7 2 f3) (list pp mod 7 2 f3) (list pf mod -7 2 f2)))
(run (list (list pf div -7 2 f3) (list pf div -7 2 f3) (list pp div -7 2 f3) (list pf div -9 2 f2)))
(run (list (list pf zip {1 2} {3 4} f3) (list pf zip {1 2} {3 4} f3) (list pp zip {1 2} {3 4} f3) (list pf zip {1} {3} f2)))
(run (list (list pf zip {1 2} {3 4} f3) (list pf zip {1 2} {3 4} f3) (list pf zip {1 2} {3 4} f3) (list pp zip {1} {3} f2)))
(run (list (list pf remove-all 1 {1 2 1} f3) (list pf remove-all 1 {1 2 1} f3) (list pp remove-all 1 {1 1} f3) (list pf remove-all 1 {1 1} f2)))
(run (list (list pf starts-with? "abc" "c" f3) (list pf starts-with? "abc" "c" f3) (list pp starts-with? "abc" "c" f3) (list pf starts-with? "abc" "c" f2)))
(run (list (list pf ends-with? "a" "abc" f3) (list pf ends-with? "a" "abc" f3) (list pp ends-with? "a" "abc" f3) (list pf ends-with? "b" "abc" f2)))
(run (list (list pf pow 2 3 f3) (list pf pow 2 3 f3) (list pp pow 2 3 f3) (list pf pow 2 5 f2)))
(run (list (list pf xor T NIL f3) (list pf xor T NIL f3) (list pp xor T NIL f3) (list pf xor NIL T f2)))
(run (list (list pf ?? NIL 2 f3) (list pf ?? NIL 2 f3) (list pp ?? NIL 2 f3) (list pf ?? NIL 3 f2)))
(run (list (list pf between? 1 10 f3) (list pf between? 1 10 f3) (list pp between? 1 10 f3) (list pf between? 10 1 f2)))
