; 17-made-sites: places that are lists made as the code runs, "(made, not read)": minimum's and maximum's (the min or
; max call unpack makes of the list), cond's and case's clause values and tests (each made by head), of items of
; every kind, and long ones (the place cut at 60 characters), in loops, and an error made right after (f given 3
; arguments) or in a clause
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {run g l} {map (fn {q} {p1 g (fst q) (snd q)}) l})
(run minimum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list {9 8 7} f2)))
(run maximum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list {"b" "a" "c"} f2)))
(run minimum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list {1/2 0.25 \a :x "s" 7} f2)))
(run maximum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list (list {1 2} {3}) f2)))
(run minimum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list (range 40) f2)))
(run maximum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list (list f2 f3) f2)))
(run minimum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list {5} f2)))
(run minimum (list (list {3 1 2} f3) (list {3 1 2} f3) (list {3 1 2} f3) (list {2 2 2} f2)))
(fun {c1 x} {cond {(> x 5) "a long value, made a list by head: more than sixty characters"} {T x}})
(fun {c2 x} {cond {(> x 5) {quoted list}} {(> x 2) :atom} {T \c}})
(fun {k1 x} {case x {1 "one"} {2 (list x x)} {3 f3} {x 1/3}})
(run c1 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 8 f2)))
(run c1 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 1 f2)))
(run c2 (list (list 7 f3) (list 7 f3) (list 3 f3) (list 3 f3) (list 1 f3) (list 1 f2)))
(run c2 (list (list 7 f3) (list 7 f3) (list 7 f3) (list 7 f2)))
(run k1 (list (list 1 f3) (list 2 f3) (list 1 f3) (list 2 f3) (list 4 f3) (list 2 f2)))
(run k1 (list (list 1 f3) (list 1 f3) (list 1 f3) (list 4 f2)))
(fun {c3 x} {cond {(> x 5) zz-unbound} {(> x 2) (zz-unbound-function x)} {T (floor zz-unbound)}})
(map c3 {1 6})
(map c3 {6 1})
(map c3 {3 3})
(map (fn {x} {cond {x}}) {1 2 3 NIL})
(map (fn {x} {case x {x}}) {1 2 3})
