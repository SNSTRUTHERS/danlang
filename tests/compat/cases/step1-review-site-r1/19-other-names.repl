; 19-other-names: library functions called by other names: the library's own (% for mod, +? and -? for positive? and
; negative?, recip ...), a user's (def {myfloor} floor), and myfloor called while floor itself is another function
; (floor's code doesn't call floor: its native still holds; mod's calls floor, the new one), then put back.  In
; loops, an error right after the last call (f given 3 arguments)
(fun {f2 a b} {+ a b})
(fun {f3 a b c} {+ a b})
(fun {p1 g x h} {h 1 2 (g x)})
(fun {p2 g x y h} {h 1 2 (g x y)})
(fun {run l} {map (fn {q} {if (== (len q) 3) (p1 (fst q) (snd q) (thd q)) (p2 (fst q) (snd q) (thd q) (nth 3 q))}) l})
(def {myfloor myeven floor0} floor even? floor)
(run (list (list % 7 2 f3) (list % 7 2 f3) (list mod 7 2 f3) (list % -7 2 f2)))
(run (list (list mod 7 2 f3) (list mod 7 2 f3) (list % 7 2 f3) (list mod -7 2 f2)))
(run (list (list +? 5 f3) (list +? 5 f3) (list positive? 5 f3) (list +? -5 f2)))
(run (list (list -? 5 f3) (list -? 5 f3) (list negative? 5 f3) (list -? -5 f2)))
(run (list (list myfloor 7/2 f3) (list myfloor 7/2 f3) (list floor 7/2 f3) (list myfloor -7/2 f2)))
(run (list (list myeven -3 f3) (list myeven -3 f3) (list even? -3 f3) (list myeven -5 f2)))
(fun {floor a} {trunc a})
(run (list (list myfloor 7/2 f3) (list myfloor 7/2 f3) (list myfloor 7/2 f3) (list myfloor -7/2 f2)))
(run (list (list floor 7/2 f3) (list floor 7/2 f3) (list floor 7/2 f3) (list floor -7/2 f2)))
(run (list (list mod 7 2 f3) (list mod 7 2 f3) (list mod 7 2 f3) (list mod -7 2 f2)))
(run (list (list myeven -3 f3) (list myeven -3 f3) (list myeven -3 f3) (list myeven -5 f2)))
(def {floor} floor0)
(run (list (list mod 7 2 f3) (list mod 7 2 f3) (list mod 7 2 f3) (list mod -7 2 f2)))
(run (list (list myeven -3 f3) (list myeven -3 f3) (list myeven -3 f3) (list myeven -5 f2)))
(run (list (list myfloor 7/2 f3) (list floor 7/2 f3) (list myfloor 7/2 f3) (list floor -7/2 f2)))
