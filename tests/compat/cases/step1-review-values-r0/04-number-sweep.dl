; 04-number-sweep: the library's number functions over integers at the edges (the shared small ones, -1024 to 65535;
; a long's, 2^63; past it), rationals whose parts are past a long, fixed decimals and complex numbers: each call four
; times over (from the second its code has its plans, and from the third it can be a native way's value), each value
; with its kind, and MISMATCH if the four aren't the same
(fun {kind x} {?((int? x) "i" ?((fixed? x) "f" ?((rational? x) "r" ?((complex? x) "c" (repr (type-of x))))))})
(fun {sk x} {+ (repr x) (kind x)})
(fun {four g} {let {{r (map (fn {i} {try (sk (g)) (+ "E:" &err)}) {1 2 3 4})}} (if (all? (fn {y} {eq y (fst r)}) r) (fst r) (+ "MISMATCH " (repr r)))})
(def {max} 9223372036854775807)
(def {min} -9223372036854775808)
(def {vals} [0 1 -1 2 -2 3 -3 7 -7 1023 -1024 -1025 65535 65536 -65535 4611686018427387904 -4611686018427387904
  max min (+ max 1) (- min 1) (* max 2) (- (* max 2)) (* max max) (- 1 (* max max))
  1/2 -1/2 7/2 -7/2 1/3 -1/3 5/4 -5/4 (/ max 2) (/ min 3) (/ min 2) (/ (+ min 1) 2) (/ 1 max) (/ -1 max) (/ 1 (* max 2)) (/ (* max 3) 2)
  (/ (- (* max 3)) 2) (/ (* max 3) (* max 2)) (/ 7 (+ max 1)) 0.0 1.0 2.0 -2.0 2.5 -2.5 0.5 -0.5 1.25 -1.75 10.00 0.001
  9223372036854775807.5 -9223372036854775808.5 math.pi (- math.e) (complex 1 2) (complex -1 1/2) (complex 2.5 -1) (complex 0 1)])
(each {x vals} (print (sk x) (four (fn {} {floor x})) (four (fn {} {ceil x})) (four (fn {} {round x}))
  (four (fn {} {mod x 2})) (four (fn {} {mod x -3})) (four (fn {} {% x 7/2})) (four (fn {} {mod x 0.75}))
  (four (fn {} {div x 2})) (four (fn {} {div x -3})) (four (fn {} {div x 1/3})) (four (fn {} {divmod x 5}))
  (four (fn {} {mod 7 x})) (four (fn {} {div -7 x})) (four (fn {} {divmod 100 x}))
  (four (fn {} {even? x})) (four (fn {} {odd? x})) (four (fn {} {square x})) (four (fn {} {cube x}))
  (four (fn {} {pow x 2})) (four (fn {} {pow x 3})) (four (fn {} {pow x -1})) (four (fn {} {pow x 0}))
  (four (fn {} {>=0 x})) (four (fn {} {<=0 x})) (four (fn {} {>0 x})) (four (fn {} {<0 x})) (four (fn {} {!=0 x}))
  (four (fn {} {!=1 x})) (four (fn {} {positive? x})) (four (fn {} {negative? x}))
  (four (fn {} {between? -1 x 1})) (four (fn {} {between? x 0 3})) (four (fn {} {><? 1 0 x}))
  (four (fn {} {avg (list x 1)})) (four (fn {} {avg (list x x x)}))))
(print (map (fn {b} {four (fn {} {pow 2 b})}) {0 1 2 3 7 8 15 16 31 32 62 63 64 65 100 -1 -2 -3 -63 -64 2.0 4/2 -3.0}))
(print (map (fn {b} {four (fn {} {pow -3 b})}) {0 1 2 3 39 40 41 -1 -2 -3}) (map (fn {b} {four (fn {} {pow 1/2 b})}) {0 1 5 -5 64}))
(print (map (fn {b} {four (fn {} {pow 1.5 b})}) {0 1 2 5 -1 -2}) (map (fn {b} {four (fn {} {pow (complex 0 1) b})}) {0 1 2 3 4 -1 -2}))
