; 07-scopes-eval: the lists the library's functions give, run as code where names are bound in more than one scope:
; zip's pairs remember their own call's scope (a and b the lists left at it, its parent the global one), remove-fst's
; tail its list's, the rest none; lists made from them keep that; code run in a pair's scope binds there (set, set!),
; and a function made there keeps it.  Each made four times over (the third and fourth can be native ways' values)
(def {a b x} :global-a :global-b :global-x)
(fun {four g} {map (fn {i} {g}) {1 2 3 4}})
(fun {in-let} {let {{a :let-a} {b :let-b} {x :let-x}} (four (fn {} {zip {a b x} {a b x}}))})
(print (map (fn {ps} {map (fn {p} {try (eval (head p)) &err}) ps}) (in-let)))
(print (map (fn {ps} {map (fn {p} {try (eval (tail p)) &err}) ps}) (in-let)))
(print (map (fn {ps} {map (fn {p} {eval (join (head p) {})}) ps}) (four (fn {} {zip {{a} {b} {x}} {1 2 3}}))))
(print (map (fn {ps} {map (fn {p} {eval (eval (head p))}) ps}) (four (fn {} {zip {{a} {b} {x}} {1 2 3}}))))
(def {s} (fst (read "(set {x} :set-in-pair)")))
(def {s!} (fst (read "(set! {a} :set!-in-pair)")))
(def {mk} (fst (read "(fn {} {list a b x})")))
(fun {probe ps} {map (fn {p} {do (try (eval p) &err) (eval (tail (join (head p) {x}))) }) ps})
(print (map probe (four (fn {} {zip (list s s) {1 2}}))))
(print (map (fn {ps} {map (fn {p} {do (try (eval p) &err) (list (eval (tail (join (head p) {a}))) a)}) ps}) (four (fn {} {zip (list s! s!) {1 2}}))))
(print (map (fn {ps} {map (fn {p} {try ((eval (head p))) &err}) ps}) (four (fn {} {zip (list mk mk mk) {1 2 3}}))))
; a list's scope: (end (join l {x})) keeps l's, if it has one, else the one {x} was written in
(fun {scope-of l} {let {{x :probe-x}} (eval (end (join l {x})))})
(fun {written} {let {{x :written-x} {a :written-a} {l {1 list x a}}} l})
(fun {tails} {let {{x :caller-x}} (four (fn {} {remove-fst 1 (written)}))})
(print (map (fn {r} {list (eval r) (eval (head (tail r))) (scope-of r)}) (tails)))
(print (map (fn {r} {list (eval r) (scope-of r)}) (four (fn {} {remove-fst 1 {1 list x a}}))))
(print (map scope-of (four (fn {} {remove-fst 1 (list 1 2)}))) (map scope-of (four (fn {} {remove-fst 1 (written)}))))
(print (map scope-of (four (fn {} {remove-fst 2 (written)}))) (map scope-of (four (fn {} {remove-fst :no (written)}))))
(print (map scope-of (four (fn {} {remove-all 1 (written)}))) (map scope-of (four (fn {} {distinct (written)}))))
(print (map scope-of (four (fn {} {flatten (list (written) (written))}))) (map scope-of (four (fn {} {zip (written) (written)}))))
(print (map scope-of (four (fn {} {divmod 7 2}))) (map scope-of (four (fn {} {fst (zip (written) (written))}))))
(print (map scope-of (four (fn {} {?? NIL (written)}))) (map scope-of (four (fn {} {minimum (list (written))}))))
(print (map scope-of (four (fn {} {cond {NIL 1} {T (written)}}))) (map scope-of (four (fn {} {case 2 {1 2} {2 (written)}}))))
