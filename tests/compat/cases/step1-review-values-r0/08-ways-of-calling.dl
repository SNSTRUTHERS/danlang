; 08-ways-of-calling: the library's functions called other ways than by name: partially applied (a copy, its code
; run), as a hash's methods (with hash-call too), by their aliases (% ><? +? -?), given to map, filter, foldl, foldr,
; sort, any?, all?, find and count; as values (printed, compared, kept in lists, called from them)
(fun {four g} {map (fn {i} {g}) {1 2 3 4}})
(def {m7 p2 b1 rf zipa cs} (mod 7) (pow 2) (between? 1) (remove-fst 2) (zip {1 2 3}) (case 2))
(print (four (fn {} {list (m7 2) (m7 -3) (p2 10) (p2 -2) (try (b1 9 5) &err) (rf {1 2 3 2}) (zipa {4 5}) (try (cs {1 :a} {2 :b}) &err)})))
(print (four (fn {} {list ((mod 7) 3) ((floor) 7/2) (try ((between? 1 9) 5) &err) ((xor T) NIL) ((pow) 3 4) ((distinct) {1 1 2}) ((zip) {1} {2})})))
(def {h} #({{:m mod} {:f floor} {:z zip} {:r remove-all} {:c cond} {:k case} {:q ??} {:b between?} {:mn minimum} {:x xor}}))
(print (four (fn {} {list (h :m 7 2) (h :f -7/2) (h :z {1 2} {3 4}) (h :r 1 {1 2 1}) (h :c {NIL 1} {T 2}) (h :k 2 {1 :a} {2 :b})
  (h :q NIL 3) (h :b 9 1 5) (h :mn {3 1 2}) (h :x T NIL)})))
(print (four (fn {} {list (hash-call h :m -7 2) ((h :m 7) 4) (hash-call h :q NIL NIL) (try ((h :b 1) 9 5) &err) (hash-call h :z {1} {2}) (hash-call h :b 1 9 5)})))
(print (four (fn {} {list (% 17 5) (% -17 5) (><? 1 9 5) (><? 9 1 0) (+? 3) (-? 3) (+? -1/2) (-? -1/2) (0? 0)})))
(print (four (fn {} {list (map floor {7/2 -7/2 2.5 -2.5 3}) (map (mod 10) {1 2 3 4 7}) (filter even? {1 2 3 4 5 6}) (filter odd? (range 7))})))
(print (four (fn {} {list (foldl mod 1000 {17 7 3}) (foldl pow 2 {2 3}) (foldr pow 1 {2 3 2}) (foldl xor NIL {T NIL T T}) (foldl ?? NIL {NIL 5 6})})))
(print (four (fn {} {list (foldl remove-all {1 2 3 1 2 3} {}) (foldl (fn {l x} {remove-fst x l}) {1 2 3 1 2 3} {1 3}) (foldl zip {1 2 3} {{4 5 6} {7 8}})})))
(print (four (fn {} {list (sort {5 3 8 1 9 2} (fn {a b} {< (mod a 3) (mod b 3)})) (sort {7/2 -7/2 5/4 1} (fn {a b} {< (floor a) (floor b)})) (sort {T NIL T} xor)})))
(print (four (fn {} {list (any? even? {1 3 5}) (all? odd? {1 3 5}) (find (fn {x} {>0 (- x 2)}) {1 2 3}) (count even? (range 10)) (count positive? {-1 0 1 2})})))
(print (four (fn {} {list (map (fn {f} {f 7 2}) (list mod div % pow divmod xor ??)) (map (fn {f} {f 9/2}) (list floor ceil round even? square cube >=0 !=1))})))
(print (four (fn {} {list (map (fn {l} {minimum l}) {{3 1 2} {5} {"b" "a"}}) (map maximum (list {3 1 2} {5} {"b" "a"}))})))
(print mod % (eq mod %) (eq mod floor) (cmp mod floor) (cmp floor mod) (function? mod) (repr between?) (eq zip zip))
(print (sort (list mod floor ceil round zip cond case) (fn {a b} {< (len (repr a)) (len (repr b))})))
(print (four (fn {} {list ((fst (list mod div)) 7 2) ((eval (head (list floor))) 7/2) (unpack mod {7 3}) (apply zip {{1 2} {3 4}}) (pack avg 1 2 3 4)})))
