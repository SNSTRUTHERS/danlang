; lib-floor: a library of its own (danlang loads the globals.dl in the folder it runs in before lib/'s; run as the
; program too, it's the program once args is there): its floor rounds toward zero, and mod, div, divmod, even?, odd?
; and round are as lib/globals.dl has them, so they call that floor
(if (defined? args)
  (do
    (print "mod" (map (fn {x} {mod x 2}) {-7 -7 -7 -7 -7}) (map (fn {x} {% x 3}) {-7 -8 -7 -8}))
    (print "div" (map (fn {x} {div x 2}) {-7 -7 -7 -7 -7}))
    (print "divmod" (map (fn {x} {divmod x 4}) {-9 -9 -9 -9}))
    (print "odd?" (map odd? {-7 -7 -7 -7 -7}) "even?" (map even? {-7 -7 -7 -7}))
    (print "round" (map round {-5/2 -5/2 -5/2 -5/2 5/2 5/2 5/2 5/2})))
  (do
    :(trunc truncate)
    :({=0 =1} zero? one?)
    (fun {floor a} {trunc a})
    (fun {round a} {
      ?((neg? a) (- (floor (- 1/2 a))) (floor (+ a 1/2)))
    })
    (fun {div a b} ?{
      (and (num? a) (num? b))
      (floor (/ a b))
      (error "Cannot perform 'div' on non-numbers")
    })
    (fun {mod a b} ?{
      (and (num? a) (num? b))
      (- a (* b (floor (/ a b))))
      (error "Cannot perform 'mod' on non-numbers")
    })
    :(% mod)
    (fun {divmod a b} ?{
      (and (num? a) (num? b))
      (cons (div a b) (list (mod a b)))
      (error "Cannot perform 'divmod' on non-numbers")
    })
    (fun {odd? n} ?{
      (num? n)
      (=1 (mod n 2))
      (error "Cannot perform 'odd?' on non-number")
    })
    (fun {even? n} ?{
      (num? n)
      (=0 (mod n 2))
      (error "Cannot perform 'even?' on non-number")
    })))
