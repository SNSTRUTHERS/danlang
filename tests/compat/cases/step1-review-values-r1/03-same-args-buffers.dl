; 03-same-args-buffers: the natived functions given one value twice ((mod x x), (zip l l), (remove-all l (list l l))
; ...), and buffers (changed in place) and hashes (changed in place) as items, changed between calls: each call's
; value is what its code makes of them as they are then; each call four times over
(fun {four g} {let {{r (map (fn {i} {try (repr (g)) (+ "E:" &err)}) {1 2 3 4})}} (if (all? (fn {y} {eq y (fst r)}) r) (fst r) (+ "MISMATCH " (repr r)))})
(def {big} 9223372036854775808)
(each {x [7 -7 0 big 7/2 -2.5 (complex 1 1) "ab" {1 2} NIL]} (print (repr x) (four (fn {} {mod x x})) (four (fn {} {div x x}))
  (four (fn {} {divmod x x})) (four (fn {} {pow x 2})) (four (fn {} {xor x x})) (four (fn {} {between? x x x}))
  (four (fn {} {zip (list x x) (list x)})) (four (fn {} {remove-all x (list x 1 x)})) (four (fn {} {remove-fst x (list 1 x x)}))
  (four (fn {} {has-element? (list x) x})) (four (fn {} {distinct (list x x 1 x)})) (four (fn {} {?? NIL x x}))))
(each {l [{1 2 1} {{1} {1}} (list {1 2} {1 2}) NIL]} (print (repr l) (four (fn {} {zip l l})) (four (fn {} {flatten (list l l)}))
  (four (fn {} {remove-all l (list l l 1)})) (four (fn {} {remove-fst l (list 1 l l)})) (four (fn {} {distinct (list l l)}))
  (four (fn {} {has-element? l l})) (four (fn {} {starts-with? l l})) (four (fn {} {contains? (list l) l}))))
(def {b1 b2} (buffer "ab") (buffer "ab"))
(fun {probe} {list (distinct (list b1 b2 b1)) (remove-all b1 (list b2 b1 (buffer "b"))) (has-element? (list b2) b1)
  (remove-fst b2 (list b1 b2)) (between? b1 b2 (buffer "abc")) (minimum (list b1 b2)) (maximum (list b2 b1)) (zip (list b1) (list b2))})
(print (four probe))
(buffer-put b1 0 120)
(print (four probe))
(buffer-put b2 0 120)
(print (four probe))
(def {h1 h2} #({{:k 1}}) #({{:k 1}}))
(fun {hprobe} {list (try (distinct (list h1 h2)) &err) (try (remove-all h1 (list 1 h2)) &err) (has-element? (list h2 1) h1)
  (remove-fst 1 (list h1 1)) (?? NIL h1) (flatten (list h1 {h2})) (zip (list h1) (list h2)) (try (between? 0 h1 2) &err)})
(print (four hprobe))
(hash-put h1 {:k 2})
(print (four hprobe))
(hash-put h2 {:k 2})
(print (four hprobe))
