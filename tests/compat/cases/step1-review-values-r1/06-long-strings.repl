; 06-long-strings: the string functions over strings longer than the shared small integers go (an index or a length
; past 65535 is a new integer each time, kept in its value): their values, and the place an error made right after
; says (the third call can be a native way's value); then indices and lengths at the edge, 65535 and 65536
(fun {f a b} {+ a b})
(def {s} (+ (str-repeat "a" 70000) "xyz"))
(def {s2} (+ "xyz" (str-repeat "b" 70000)))
(def {e1 e2} (+ (str-repeat "c" 65535) "x") (+ (str-repeat "c" 65536) "x"))
(fun {sw x u} {do (print (starts-with? x u) (starts-with? x u)) (f 1 2 (starts-with? x u))})
(fun {ew x u} {do (print (ends-with? x u) (ends-with? x u)) (f 1 2 (ends-with? x u))})
(fun {cw x u} {do (print (contains? x u) (contains? x u)) (f 1 2 (contains? x u))})
(sw s "y")
(sw s "y")
(sw s2 "xyz")
(sw s "q")
(sw e1 "x")
(sw e2 "x")
(ew "ab" s)
(ew "ab" s)
(ew s "xyz")
(ew s2 "xyz")
(ew s s)
(ew e1 "cx")
(ew "x" e2)
(cw s "yz")
(cw s "yz")
(cw s "q")
(cw e1 "x")
(cw e2 "x")
(print (map (fn {u} {list (starts-with? s u) (ends-with? s u) (contains? s u)}) (list "a" "xyz" "" (str-repeat "a" 70000) (+ s "a"))))
