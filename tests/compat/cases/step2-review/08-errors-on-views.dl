; 08-errors-on-views.dl - the errors list operations make, on views and conses (lists sharing storage) as on lists
; of their own: empty lists to head, tail, init and end; indexes outside the list (nth, item-at, subset), counts that
; are negative, fractions, or past the end (take and drop take what there is), huge counts, non-lists; the library's
; native ways given what they're not sure of (the code's errors then); and, last, a walk off the end of a view
; that ends the program, its trace

(def {l} (cons :a (cons :b (cons :c NIL))))
(def {v} (tail (tail l)))
(def {e} (tail v))
(print l v e (len e) (nil? e) (eq e NIL) (type-of e))
(print (try (head e)) (try (tail e) &err) (try (init e) &err) (try (end e) &err) (try (head e) &err))
(print (nth 0 v) (nth 1 v) (nth -1 v) (item-at v 0) (item-at v 1) (item-at l 3) (fst e) (last e) (snd v))
(print (subset l 3) (subset l 4) (subset l 1 -1) (subset l 1 0) (subset v 1) (subset v 0 99) (subset l -1 1))
(print (take -1 l) (drop -1 l) (take 2.5 l) (drop 1/2 l) (take 2.0 l) (drop 4/2 l) (take 99 v) (drop 99 v))
(print (take 1_000_000_000_000_000_000_000 l) (drop 1_000_000_000_000_000_000_000 l) (take 0 l) (drop 0 e))
(print (cons 1 :x) (cons 1 "s") (join l :x) (join :x l) (reverse 5) (sort 5) (len 5) (take 1 :x) (drop 1 "s"))
(print (join l (error "inner")) (cons (error "first") v) (tail (error "e")) (map (fn {x} {error "in map"}) v))
(print (filter (fn {x} {error "in filter"}) l) (foldl (fn {a x} {error "in foldl"}) 0 l) (sort l (fn {a b} {error "less"})))

; the library's natives, given lists and not
(print (zip l v) (zip l :x) (zip :x l) (zip e l) (zip l e) (zip (tail l) l))
(print (remove-fst :b l) (remove-fst :a l) (remove-fst :z l) (remove-fst :a :x) (remove-all :c l) (remove-all :c 5))
(print (distinct (join l l v)) (distinct 5) (flatten [l [v [e]] 5]) (flatten 5) (has-element? l :c) (has-element? 5 :c))
(print (minimum v) (maximum (tail l)) (minimum e) (remove-min [3 1 2]) (remove-max (cons 9 (cons 1 NIL))) (avg (cons 2 [4])))
(print l v e)

; errors, as values, kept in lists that share storage with others
(def {errs} (cons (error "kept") l))
(def {errs2} (cons (error "kept2") l))
(print errs errs2 (map error? errs) (filter error? errs2) l)

(fun {walk x n} {if (zero? n) x (walk (tail x) (- n 1))})
(print (walk (drop 1 l) 2))
(fun {outer} {do (print "outer") (+ 0 (walk (drop 1 l) 3))})
(outer)
