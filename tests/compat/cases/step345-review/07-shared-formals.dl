; 07-shared-formals: one list the formals of many functions (a global's, a view of another list: tail, drop, take;
; map's list; read's; join's; cons's), each with its own body; the list then used as data (joined, consed onto,
; sliced) and as code (eval: its items a call), and functions made from the same code with different formals lists
(def {fl} {a b c})
(def {fa} (fn fl {list :fa a b c}))
(def {fb} (fn fl {list :fb c b a &_}))
(def {fc} (fn (tail fl) {list :fc b c}))
(def {fd} (fn (drop 1 fl) {list :fd b c &_}))
(def {fe} (fn (take 2 fl) {list :fe a b}))
(print "global" (fa 1 2 3) (fb 1 2 3 4) (fc 1 2) (fd 1 2 3) (fe 1 2) ((fa 1) 2 3) ((fc 1) 2))
(print "data" fl (join fl {d}) (cons :z fl) (tail fl) (drop 2 fl) (take 1 fl) (reverse fl) (len fl))
(def {fl2} (join fl {d}))
(def {ff} (fn fl2 {list a b c d}))
(print "joined" (ff 1 2 3 4) ((ff 1 2) 3 4) fl2 (join fl2 {e}) (join fl {x}))
(def {fl3} (cons :q fl))
(print "consed" fl3 (cons :r fl) (cons :s fl3))
(def {mf} (map to-sym {"m1" "m2" "M3"}))
(def {fm} (fn mf {list m1 m2 m3 &_}))
(print "map formals" mf (fm 1 2 3) (fm 1 2 3 4) ((fm 1) 2 3) (join mf {m4}) (cons :m0 mf) (tail mf))
(def {fm2} (fn (map to-sym {"x" "y"}) {list x y}))
(print "map formals 2" (fm2 1 2) ((fm2 1) 2) (repr fm2))
(def {rd} (fst (read "{r1 r2}")))
(def {fr} (fn rd {list r1 r2}))
(print "read formals" (fr 1 2) rd (join rd rd) (type-of rd))
(def {mixed} (fn (join {p} (tail {x q}) (map to-sym {"r"})) {list p q r}))
(print "mixed" (mixed 1 2 3) ((mixed 1) 2 3) (repr mixed))
; the same body, many formals lists (made each time): each call binds that list's names
(fun {mk names} {fn names {map (fn {n} {eval n}) (map to-sym (map (fn {s} {to-str s}) names))}})
(print "mk" ((mk {a b}) 1 2) ((mk {b a}) 1 2) ((mk {a}) 1) ((mk {c a b}) 1 2 3) ((mk {a b}) 5 6))
(def {mk-fs} (map (fn {k} {mk (take k {u v w x y z})}) (range 7)))
(each {f mk-fs} (print "mk-fs" (repr f) (try (f 1 2 3 4 5 6) &err)))
; formals list used as code (a call of its first item, a function's name)
(fun {k1 x} {list :k1 x})
(def {code} {k1 x})
(def {fk} (fn code {list k1 x}))
(print "code" (fk 1 2) (eval (join {k1} {5})) (let {{x 7}} (eval code)))
(print "code again" (fk 3 4) (let {{x 8}} (eval code)) (eval {k1 9}))
; the last: the global formals list's function given too many
(fa 1 2 3 4)
