; 08-nil-formals: a function of no formals made with every empty list (NIL, (), [], {}, a list emptied by tail or
; drop); its extras; then NIL itself used as code, as a body, as data, as formals again, everywhere after
(def {n1} (fn nil {list :n1 &_}))
(def {n2} (fn () {list :n2 &_}))
(def {n3} (fn [] {list :n3 &_}))
(def {n4} (fn {} {list :n4 &_}))
(def {n5} (fn (tail {x}) {list :n5 &_}))
(def {n6} (fn (drop 5 {1 2}) {list :n6 &_}))
(def {n7} (fn (map (fn {x} {x}) {}) {list :n7 &_}))
(each {f [n1 n2 n3 n4 n5 n6 n7]} (print "nil" (repr f) (f) (f 1) (f 1 2 3) (eq f n1)))
(def {m1} (fn nil {:none}))
(print "nil err" (try (m1 1) &err) (try ((fn () {:x}) 1 2) &err) (m1) (repr m1))
(print "nil use" nil (eval nil) (eval {}) (repr nil) (len nil) (join nil nil {1}) (cons 1 nil) (type-of nil))
(def {b1} (fn {x} nil))
(def {b2} (fn {} {}))
(print "nil body" (b1 1) (b2) (repr b1) (repr b2) (try (b2 1) &err))
(def {nn} (fn nil nil))
(print "nil both" (nn) (repr nn) (try (nn 1) &err) (eq nn (fn nil nil)) (eq nn b2))
(print "nil fexpr" ((fexpr nil {&_}) (+ 1 2) x) ((fexpr () {list &1}) (+ 1 1)))
(dotimes {i 3} (print "again" i (n1 i) (m1) (nn) (eval nil) (try (m1 i) &err)))
(fun {nfun} {list :nfun &_})
(print "fun" (nfun) (nfun 1 2) nfun)
; the last: a function of NIL formals, given an argument, inside another call
(fun {outer} {list (m1 :one)})
(outer)
